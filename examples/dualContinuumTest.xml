<?xml version="1.0"?>

<Problem>
  <Solvers>
    <!-- Minimal single-phase solver example (schema-compliant placeholder) -->
    <SinglePhaseFVM name="dualFlowTest" discretization="FE1" targetRegions="{ * }" />
  </Solvers>

  <!-- Minimal mesh so the schema validation succeeds (use a very small internal mesh) -->
  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 1 }"
      yCoords="{ 0, 1 }"
      zCoords="{ 0, 1 }"
      nx="{ 1 }"
      ny="{ 1 }"
      nz="{ 1 }"
      cellBlockNames="{ cb1 }"/>
  </Mesh>

  <ElementRegions>
    <CellElementRegion name="all" cellBlocks="{ cb1 }" materialList="{ default }"/>
  </ElementRegions>

  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace name="FE1" order="1"/>
    </FiniteElements>
  </NumericalMethods>

  <Events maxTime="1.0">
    <PeriodicEvent name="solverApplications" forceDt="1.0" target="/Solvers/dualFlow"/>
  </Events>

</Problem>
