<!--      name="drainageWaterRelativePermeabilityTable"-->
<!--      coordinateFiles="{ drainagePhaseVolFraction_water.txt }"-->
<!--      voxelFile="drainageRelPerm_water.txt"/>-->
<!--    <TableFunction-->
<!--      name="drainageGasRelativePermeabilityTable"-->
<!--      coordinateFiles="{ drainagePhaseVolFraction_gas.txt }"-->
<!--      voxelFile="drainageRelPerm_gas.txt"/>-->
<!--    <TableFunction-->
<!--      name="imbibitionWaterRelativePermeabilityTable"-->
<!--      coordinateFiles="{ imbibitionPhaseVolFraction_water.txt }"-->
<!--      voxelFile="imbibitionRelPerm_water.txt"/>-->
<!--    <TableFunction-->
<!--      name="imbibitionGasRelativePermeabilityTable"-->
<!--      coordinateFiles="{ imbibitionPhaseVolFraction_gas.txt }"-->
<!--      voxelFile="imbibitionRelPerm_gas.txt"/>-->

    <TableFunction
            name="waterRelativePermeabilityTable"
            coordinateFiles="{ waterSaturation.txt }"
            voxelFile="waterRelperm.txt"/>
    <TableFunction
            name="oilRelativePermeabilityTableForWO"
            coordinateFiles="{ waterSaturation.txt }"
            voxelFile="oilRelpermForWO.txt"/>
    <TableFunction
            name="gasRelativePermeabilityTable"
            coordinateFiles="{ gasSaturation.txt }"
            voxelFile="gasRelperm.txt"/>
    <TableFunction
            name="oilRelativePermeabilityTableForGO"
            coordinateFiles="{ gasSaturation.txt }"
            voxelFile="oilRelpermForGO.txt"/>
    <TableFunction
            name="waterJFunctionTable"
            coordinateFiles="{ waterSaturation.txt }"
            voxelFile="waterJFunction.txt"/>
    <TableFunction
            name="gasJFunctionTable"
            coordinateFiles="{ gasSaturationForJFunc.txt }"
            voxelFile="gasJFunction.txt"/>

  </Functions>
