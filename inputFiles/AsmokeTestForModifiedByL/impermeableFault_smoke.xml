<?xml version="1.0" ?>

<Problem>
  <Included>
     <File name="faultPoroelastic_base.xml"/>
  </Included>

  <Solvers gravityVector="{0.0, 0.0, 0.0}">
    <SinglePhasePoromechanics 
      name="poromechanicsSolver" 
      solidSolverName="mechanicsSolver"
      flowSolverName="singlePhaseFlowSolver"
      logLevel="1"
      writeLinearSystem="1"
      targetRegions="{ Domain }">
      <LinearSolverParameters 
        solverType="direct"
        directParallel="0"
        logLevel="0"/>
      <NonlinearSolverParameters
        newtonMaxIter = "40"/>
    </SinglePhasePoromechanics>

    <SolidMechanicsLagrangianFEM 
      name="mechanicsSolver" 
      logLevel="1"
      discretization="FE1"
      targetRegions="{ Domain }">
      <NonlinearSolverParameters
        newtonTol = "1.0e-5"
        newtonMaxIter = "15"/>      
    </SolidMechanicsLagrangianFEM>

    <SinglePhaseFVM 
      name="singlePhaseFlowSolver"
      logLevel="1"
      discretization="singlePhaseTPFA"
      targetRegions="{ Domain }"> 
      <NonlinearSolverParameters
        newtonTol = "1.0e-6"
        newtonMaxIter = "8"/>       
    </SinglePhaseFVM>
  </Solvers>
  <Mesh>
    <InternalMesh
            name="mesh"
            elementTypes="{ C3D8 }"
            xCoords="{ 0, 100 }"
            yCoords="{ 0, 100 }"
            zCoords="{ 0, 10 }"
            nx="{ 3 }"
            ny="{ 1 }"
            nz="{ 1 }"
            cellBlockNames="{ cb1 }"/>
  </Mesh>

  <Geometry>
    <Box
            name="zpos"
            xMin="{ -1000, -1000, 9 }"
            xMax="{ +1000, 1000, 11 }"/>
    <Box
            name="zneg"
            xMin="{ -1000, -1000, -1 }"
            xMax="{ +1000, 1000, 1 }"/>
    <Box
            name="xpos"
            xMin="{ 99, -1000, -1000 }"
            xMax="{ 101, 1000, 1000 }"/>
    <Box
            name="xneg"
            xMin="{ -1, -1000, -1000 }"
            xMax="{ +1, 1000, 1000 }"/>

    <Box
            name="ypos"
            xMin="{ -1000, 99, -1000 }"
            xMax="{ 1000, 101, 1000 }"/>
    <Box
            name="yneg"
            xMin="{ -1000, -1, -1000 }"
            xMax="{ +1000, 1, 1000 }"/>
    <Box
            name="source"
            xMin="{ 50, 50, -1 }"
            xMax="{ 101, 101, 11 }"/>

  </Geometry>
    <!--
  <Mesh>
     <VTKMesh         
      name="FaultModel"      
      file="faultMesh_smoke.vtk"
      regionAttribute="CellEntityIds"/>
  </Mesh> 
    -->
  <FieldSpecifications>
    <FieldSpecification 
      name="injection"
      initialCondition="0"
      setNames="{source}"
      objectPath="ElementRegions/Domain"
      fieldName="pressure"      
      scale="55.0e6"/>   	  
  </FieldSpecifications>

  <Events maxTime="2.0">
    <PeriodicEvent
      name="outputs"
      timeFrequency="2.0"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="solverApplications"
      forceDt="10"
      target="/Solvers/poromechanicsSolver"/>	


  </Events>

</Problem>
