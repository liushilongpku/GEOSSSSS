<?xml version="1.0" ?>
<!-- 用途：纯弹性(单物理场)测试，验证 RigidBoundary 刚性压板边界条件；0.03^3 块体，四周滚支+顶部刚性压板。 -->
<!-- Pure-elastic single-physics test for the RigidBoundary BC.
     A 0.03^3 block, rollers on xneg/yneg/ypos/zneg, rigid platen with
     -1 MPa load on zpos. No flow: isolates the BC from poromechanical
     coupling. Expected: uniform downward top displacement, total reaction
     = -1e6 * (0.03*0.03) = -900 N, and the solve must converge. -->
<Problem>
  <NumericalMethods>
    <FiniteElements><FiniteElementSpace name="FE1" order="1"/></FiniteElements>
  </NumericalMethods>

  <Mesh>
    <InternalMesh name="mesh1" elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 0.03 }" yCoords="{ 0.0, 0.03 }" zCoords="{ 0.0, 0.03 }"
      nx="{ 20 }" ny="{ 1 }" nz="{ 20 }" cellBlockNames="{ matrixBlock }"/>
  </Mesh>

  <Geometry>
    <Box name="xneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 1e-3, 30.1e-3, 30.1e-3 }"/>
    <Box name="yneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 30.1e-3, 1e-3, 30.1e-3 }"/>
    <Box name="ypos" xMin="{ -1e-3, 29e-3, -1e-3 }" xMax="{ 30.1e-3, 31e-3, 30.1e-3 }"/>
    <Box name="zneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 30.1e-3, 30.1e-3, 1e-3 }"/>
    <Box name="zpos" xMin="{ -1e-3, -1e-3, 29e-3 }" xMax="{ 30.1e-3, 30.1e-3, 31e-3 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion name="matrixRegion" meshBody="mesh1"
      cellBlocks="{ matrixBlock }" materialList="{ matrixSolid }"/>
  </ElementRegions>

  <Constitutive>
    <ElasticIsotropic name="matrixSolid"
      defaultDensity="0" defaultBulkModulus="1.1e9" defaultShearModulus="7.574e8"/>
  </Constitutive>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <SolidMechanicsLagrangianFEM name="solidMech" logLevel="2"
      discretization="FE1" targetRegions="{ mesh1/matrixRegion }"
      timeIntegrationOption="QuasiStatic">
      <NonlinearSolverParameters newtonMaxIter="20" newtonTol="1.0e-6"
        maxTimeStepCuts="4"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </SolidMechanicsLagrangianFEM>
  </Solvers>

  <FieldSpecifications>
    <FieldSpecification name="xnegconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="0" scale="0.0" setNames="{ xneg }"/>
    <FieldSpecification name="yconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="1" scale="0.0" setNames="{ yneg, ypos }"/>
    <FieldSpecification name="znegconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="2" scale="0.0" setNames="{ zneg }"/>

    <RigidBoundary name="zposLoad"
      objectPath="faceManager" targetMesh="mesh1"
      component="2" scale="-1.0e6" setNames="{ zpos }"/>
  </FieldSpecifications>

  <Events maxTime="1.0">
    <PeriodicEvent name="solver" forceDt="1.0" target="/Solvers/solidMech"/>
    <PeriodicEvent name="vtk" timeFrequency="1.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="dispEvent" target="/Tasks/dispCollection"/>
    <PeriodicEvent name="dispOut" targetExactTimestep="0" target="/Outputs/dispHistory"/>
  </Events>

  <Tasks>
    <PackCollection name="dispCollection"
      objectPath="mesh1/nodeManager" fieldName="totalDisplacement"/>
  </Tasks>

  <Outputs>
    <VTK name="vtkOutput"/>
    <TimeHistory name="dispHistory" sources="{ /Tasks/dispCollection }" filename="elastic_disp_history"/>
  </Outputs>
</Problem>
