<?xml version="1.0" ?>
<!-- 用途：非均质纯弹性测试，验证 RigidBoundary 惩罚约束；左半(x<0.015)比右半软 100 倍，2D 网格。 -->
<!-- Heterogeneous pure-elastic test for the RigidBoundary penalty constraint.
     Left half (x<0.015) is 100x softer than the right half. Under a rigid
     platen with a -1 MPa load on top, a *free* surface would settle much more
     on the soft side (non-uniform top displacement). The rigid platen must
     keep the top FLAT (uniform u_z) while balancing the total load.
     This exercises the in-Jacobian penalty constraint and its convergence. -->
<Problem>
  <NumericalMethods>
    <FiniteElements><FiniteElementSpace name="FE1" order="1"/></FiniteElements>
  </NumericalMethods>

  <Mesh>
    <InternalMesh name="mesh1" elementTypes="{ C3D8, C3D8 }"
      xCoords="{ 0.0, 0.015, 0.03 }" yCoords="{ 0.0, 0.03 }" zCoords="{ 0.0, 0.03 }"
      nx="{ 10, 10 }" ny="{ 1 }" nz="{ 20 }" cellBlockNames="{ leftBlock, rightBlock }"/>
  </Mesh>

  <Geometry>
    <Box name="xneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 1e-3, 30.1e-3, 30.1e-3 }"/>
    <Box name="yneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 30.1e-3, 1e-3, 30.1e-3 }"/>
    <Box name="ypos" xMin="{ -1e-3, 29e-3, -1e-3 }" xMax="{ 30.1e-3, 31e-3, 30.1e-3 }"/>
    <Box name="zneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 30.1e-3, 30.1e-3, 1e-3 }"/>
    <Box name="zpos" xMin="{ -1e-3, -1e-3, 29e-3 }" xMax="{ 30.1e-3, 30.1e-3, 31e-3 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion name="softRegion" meshBody="mesh1"
      cellBlocks="{ leftBlock }" materialList="{ softSolid }"/>
    <CellElementRegion name="stiffRegion" meshBody="mesh1"
      cellBlocks="{ rightBlock }" materialList="{ stiffSolid }"/>
  </ElementRegions>

  <Constitutive>
    <ElasticIsotropic name="softSolid"
      defaultDensity="0" defaultBulkModulus="1.1e7" defaultShearModulus="7.574e6"/>
    <ElasticIsotropic name="stiffSolid"
      defaultDensity="0" defaultBulkModulus="1.1e9" defaultShearModulus="7.574e8"/>
  </Constitutive>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <SolidMechanicsLagrangianFEM name="solidMech" logLevel="2"
      discretization="FE1" targetRegions="{ mesh1/softRegion, mesh1/stiffRegion }"
      timeIntegrationOption="QuasiStatic">
      <NonlinearSolverParameters newtonMaxIter="20" newtonTol="1.0e-6" maxTimeStepCuts="4"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </SolidMechanicsLagrangianFEM>
  </Solvers>

  <FieldSpecifications>
    <FieldSpecification name="xnegconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="0" scale="0.0" setNames="{ xneg }"/>
    <FieldSpecification name="yconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="1" scale="0.0" setNames="{ yneg, ypos }"/>
    <FieldSpecification name="znegconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="2" scale="0.0" setNames="{ zneg }"/>
    <RigidBoundary name="zposLoad"
      objectPath="faceManager" targetMesh="mesh1"
      component="2" scale="-1.0e6" setNames="{ zpos }"/>
  </FieldSpecifications>

  <Events maxTime="1.0">
    <PeriodicEvent name="solver" forceDt="1.0" target="/Solvers/solidMech"/>
    <PeriodicEvent name="dispEvent" target="/Tasks/dispCollection"/>
    <PeriodicEvent name="dispOut" targetExactTimestep="0" target="/Outputs/dispHistory"/>
  </Events>

  <Tasks>
    <PackCollection name="dispCollection"
      objectPath="mesh1/nodeManager" fieldName="totalDisplacement"/>
  </Tasks>

  <Outputs>
    <TimeHistory name="dispHistory" sources="{ /Tasks/dispCollection }" filename="hetero_disp_history"/>
  </Outputs>
</Problem>
