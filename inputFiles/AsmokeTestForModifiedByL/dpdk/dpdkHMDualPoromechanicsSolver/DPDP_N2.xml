<?xml version="1.0" ?>
<!--
  DPDP Mandel N=2 — Dual-Porosity Dual-Permeability Verification
  Based on: Mehrabian & Abousleiman (2014) generalized Biot theory
  Displacement BC from analytical N=2 solution (displacement_N2.csv)
  Matrix: GOM Shale matrix (K_m=1.1e9, k_m=4.93e-21)
  Fracture: GOM Shale macro-fracture (K_f=2.25e7, k_f=4.93e-18)
  Initial conditions at t=0+:
    p_m = 0.455 Pc = 4.55e5 Pa,  p_f = 0.488 Pc = 4.88e5 Pa
    sigma_eff_xx = -4.67e5 Pa (tension), sigma_eff_zz = -5.33e5 Pa (compression)
  K_upf/K_pfu coupling enabled (α_f ≈ 0.999)
-->
<Problem>
  <NumericalMethods>
    <FiniteElements><FiniteElementSpace name="FE1" order="1"/></FiniteElements>
    <FiniteVolume><TwoPointFluxApproximation name="singlePhaseTPFA"/></FiniteVolume>
  </NumericalMethods>

  <Mesh>
    <InternalMesh name="mesh1" elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 0.03 }" yCoords="{ 0.0, 0.03 }" zCoords="{ 0.0, 0.03 }"
      nx="{ 20 }" ny="{ 1 }" nz="{ 20 }" cellBlockNames="{ matrixBlock }"/>
    <InternalMesh name="mesh2" elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 0.03 }" yCoords="{ 0.0, 0.03 }" zCoords="{ 0.0, 0.03 }"
      nx="{ 20 }" ny="{ 1 }" nz="{ 20 }" cellBlockNames="{ fractureBlock }"/>
  </Mesh>

  <Geometry>
    <Box name="xneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 1e-3, 30.1e-3, 30.1e-3 }"/>
    <Box name="xpos" xMin="{ 29e-3, -1e-3, -1e-3 }" xMax="{ 31e-3, 30.1e-3, 30.1e-3 }"/>
    <Box name="yneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 30.1e-3, 1e-3, 30.1e-3 }"/>
    <Box name="ypos" xMin="{ -1e-3, 29e-3, -1e-3 }" xMax="{ 30.1e-3, 31e-3, 30.1e-3 }"/>
    <Box name="zneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 30.1e-3, 30.1e-3, 1e-3 }"/>
    <Box name="zpos" xMin="{ -1e-3, -1e-3, 29e-3 }" xMax="{ 30.1e-3, 30.1e-3, 31e-3 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion name="matrixRegion" meshBody="mesh1"
      cellBlocks="{ matrixBlock }" materialList="{ matrixRock, water }"/>
    <CellElementRegion name="fractureRegion" meshBody="mesh2"
      cellBlocks="{ fractureBlock }" materialList="{ fractureRock, water }"/>
  </ElementRegions>

  <Constitutive>
    <CompressibleSinglePhaseFluid name="water"
      defaultDensity="1000" defaultViscosity="0.001"
      referencePressure="0.0" compressibility="5.734e-10"/>

    <!-- Matrix: GOM Shale primary porosity (Table 1, intrinsic values)
         K₁ = 1.1 GPa, ν₁ = 0.22, V₁ = 97%, Φ₁ = 14%, k₁ = 5 nd
         α₁ = 1 - K₁/K_s = 1 - 1.1/27 = 0.9593
         G₁ = 3K₁(1-2ν)/(2(1+ν)) = 0.7574 GPa -->
    <ElasticIsotropic name="matrixSolid"
      defaultDensity="0" defaultBulkModulus="1.1e9" defaultShearModulus="7.574e8"/>
    <BiotPorosity name="matrixPorosity"
      defaultGrainBulkModulus="2.7e10" defaultReferencePorosity="0.14"
      defaultBiotCoefficient="0.9593"/>
    <ConstantPermeability name="matrixPerm"
      permeabilityComponents="{ 4.935e-21, 4.935e-21, 4.935e-21 }"/>
    <PorousElasticIsotropic name="matrixRock"
      solidModelName="matrixSolid" porosityModelName="matrixPorosity"
      permeabilityModelName="matrixPerm"/>

    <!-- Fracture: GOM Shale macro-fracture (Table 1, intrinsic values)
         K₃ = 22.5 MPa, ν₃ = 0.22, V₃ = 3%, Φ₃ = 95%, k₃ = 5 md
         α₃ = 1 - K₃/K_s = 1 - 0.0225/27 = 0.9992
         G₃ = 3K₃(1-2ν)/(2(1+ν)) = 15.49 MPa -->
    <ElasticIsotropic name="fractureSolid"
      defaultDensity="0" defaultBulkModulus="2.25e7" defaultShearModulus="1.549e7"/>
    <BiotPorosity name="fracturePorosity"
      defaultGrainBulkModulus="2.7e10" defaultReferencePorosity="0.95"
      defaultBiotCoefficient="0.9992"/>
    <ConstantPermeability name="fracturePerm"
      permeabilityComponents="{ 4.935e-15, 4.935e-15, 4.935e-15 }"/>
    <PorousElasticIsotropic name="fractureRock"
      solidModelName="fractureSolid" porosityModelName="fracturePorosity"
      permeabilityModelName="fracturePerm"/>
  </Constitutive>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <SinglePhaseFVM name="matrixFlow" logLevel="1"
      discretization="singlePhaseTPFA" targetRegions="{ mesh1/matrixRegion }">
      <NonlinearSolverParameters newtonMaxIter="40" newtonTol="1.0e-4"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </SinglePhaseFVM>
    <SinglePhaseFVM name="fractureFlow" logLevel="1"
      discretization="singlePhaseTPFA" targetRegions="{ mesh2/fractureRegion }">
      <NonlinearSolverParameters newtonMaxIter="40" newtonTol="1.0e-4"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </SinglePhaseFVM>
    <SolidMechanicsLagrangianFEM name="solidMech" logLevel="1"
      discretization="FE1" targetRegions="{ mesh1/matrixRegion }"
      timeIntegrationOption="QuasiStatic" contactRelationName="tractionlessContact"/>

    <DualContinuumFVM name="dualFlow" logLevel="1"
      flowSolverName="matrixFlow" flowSolverName1="fractureFlow"
      matrixRegionList="{ matrixRegion }" fractureRegionList="{ fractureRegion }"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }"
      transferCoefficient="0.0">
      <DualContinuumCrossFlow
        interporosityExchangeCoefficient="1.67e-22"
        fractureSpacingLx="1.0" fractureSpacingLy="1.0" fractureSpacingLz="1.0"
        gravityDrainageFlag="0"
        matrixRegionList="{ matrixRegion }" fractureRegionList="{ fractureRegion }"/>
      <NonlinearSolverParameters newtonMaxIter="40" newtonTol="1.0e-4"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </DualContinuumFVM>

    <SinglePhaseDualContinuumPoromechanics name="poroSolver"
      logLevel="1" dualcontinuumSolverName="dualFlow" solidSolverName="solidMech"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }"
      fractureVolumeFraction="0.03"
      stabilizationType="None" isThermal="0">
      <NonlinearSolverParameters
        couplingType="Sequential" newtonMaxIter="80" newtonTol="1.0e-6"
        lineSearchAction="None"
        maxTimeStepCuts="2" timeStepCutFactor="0.5"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </SinglePhaseDualContinuumPoromechanics>
  </Solvers>

  <Functions>
      <TableFunction
      name="initialUxFunc"
      inputVarNames="{ ReferencePosition }"
      coordinateFiles="{ mandel_input_tables/xlin.geos, mandel_input_tables/ylin.geos, mandel_input_tables/zlin.geos }"
      voxelFile="mandel_input_tables/ux.geos"/>

    <TableFunction
      name="initialUzFunc"
      inputVarNames="{ ReferencePosition }"
      coordinateFiles="{ mandel_input_tables/xlin2.geos, mandel_input_tables/ylin2.geos, mandel_input_tables/zlin2.geos }"
      voxelFile="mandel_input_tables/uz.geos"/>
    
    <TableFunction name="loadFunction0000000" inputVarNames="{ time }"
      coordinates="{ 0.0000e+00, 1.0000e-12, 1.0800e-01, 1.2553e-01, 1.4591e-01, 1.6959e-01, 1.9712e-01, 2.2912e-01, 2.6631e-01, 3.0954e-01, 3.5978e-01, 4.1818e-01, 4.8606e-01, 5.6496e-01, 6.5666e-01, 7.6326e-01, 8.8715e-01, 1.0312e+00, 1.1985e+00, 1.3931e+00, 1.6192e+00, 1.8820e+00, 2.1875e+00, 2.5426e+00, 2.9554e+00, 3.4351e+00, 3.9927e+00, 4.6408e+00, 5.3941e+00, 6.2697e+00, 7.2874e+00, 8.4703e+00, 9.8452e+00, 1.1443e+01, 1.3301e+01, 1.5460e+01, 1.7969e+01, 2.0886e+01, 2.4276e+01, 2.8217e+01, 3.2797e+01, 3.8121e+01, 4.4309e+01, 5.1501e+01, 5.9861e+01, 6.9578e+01, 8.0872e+01, 9.3999e+01, 1.0926e+02, 1.2699e+02, 1.4761e+02, 1.7157e+02, 1.9941e+02, 2.3178e+02, 2.6941e+02, 3.1314e+02, 3.6397e+02, 4.2305e+02, 4.9172e+02, 5.7153e+02, 6.6431e+02, 7.7214e+02, 8.9747e+02, 1.0432e+03, 1.2125e+03, 1.4093e+03, 1.6381e+03, 1.9039e+03, 2.2130e+03, 2.5722e+03, 2.9898e+03, 3.4751e+03, 4.0391e+03, 4.6948e+03, 5.4568e+03, 6.3426e+03, 7.3722e+03, 8.5688e+03, 9.9597e+03, 1.1576e+04, 1.3456e+04, 1.5640e+04, 1.8178e+04, 2.1129e+04, 2.4559e+04, 2.8545e+04, 3.3179e+04, 3.8565e+04, 4.4824e+04, 5.2100e+04, 6.0558e+04, 7.0387e+04, 8.1813e+04, 9.5093e+04, 1.1053e+05, 1.2847e+05, 1.4932e+05, 1.7356e+05, 2.0174e+05, 2.3448e+05, 2.7254e+05 }"
      values="{ 1.7961420000e-05, 1.7961420000e-05, 1.7961420000e-05, 1.7961600000e-05, 1.7961790000e-05, 1.7962000000e-05, 1.7962220000e-05, 1.7962460000e-05, 1.7962720000e-05, 1.7963000000e-05, 1.7963300000e-05, 1.7963620000e-05, 1.7963970000e-05, 1.7964350000e-05, 1.7964750000e-05, 1.7965190000e-05, 1.7965670000e-05, 1.7966170000e-05, 1.7966720000e-05, 1.7967320000e-05, 1.7967950000e-05, 1.7968640000e-05, 1.7969380000e-05, 1.7970180000e-05, 1.7971050000e-05, 1.7971970000e-05, 1.7972980000e-05, 1.7974060000e-05, 1.7975220000e-05, 1.7976480000e-05, 1.7977830000e-05, 1.7979300000e-05, 1.7980870000e-05, 1.7982570000e-05, 1.7984400000e-05, 1.7986380000e-05, 1.7988500000e-05, 1.7990800000e-05, 1.7993280000e-05, 1.7995950000e-05, 1.7998820000e-05, 1.8001930000e-05, 1.8005280000e-05, 1.8008890000e-05, 1.8012780000e-05, 1.8016980000e-05, 1.8021510000e-05, 1.8026390000e-05, 1.8031670000e-05, 1.8037350000e-05, 1.8043480000e-05, 1.8050090000e-05, 1.8057220000e-05, 1.8064920000e-05, 1.8073230000e-05, 1.8082190000e-05, 1.8091850000e-05, 1.8102280000e-05, 1.8113540000e-05, 1.8125690000e-05, 1.8138790000e-05, 1.8152940000e-05, 1.8168220000e-05, 1.8184710000e-05, 1.8202510000e-05, 1.8221740000e-05, 1.8242510000e-05, 1.8264940000e-05, 1.8289170000e-05, 1.8315340000e-05, 1.8343630000e-05, 1.8374200000e-05, 1.8407250000e-05, 1.8442990000e-05, 1.8481650000e-05, 1.8523460000e-05, 1.8568700000e-05, 1.8617670000e-05, 1.8670690000e-05, 1.8728130000e-05, 1.8790350000e-05, 1.8857800000e-05, 1.8930940000e-05, 1.9010290000e-05, 1.9096420000e-05, 1.9189970000e-05, 1.9291610000e-05, 1.9402140000e-05, 1.9522410000e-05, 1.9653370000e-05, 1.9796080000e-05, 1.9951700000e-05, 2.0121460000e-05, 2.0306590000e-05, 2.0508190000e-05, 2.0727000000e-05, 2.0963180000e-05, 2.1216040000e-05, 2.1483850000e-05, 2.1763610000e-05, 2.2051040000e-05 }"/>
  </Functions>

  <FieldSpecifications>

  <!-- N=2 Initial pore pressures at t=0+ -->
  <!-- Initial pressure: 0 — displacement BC establishes Skempton effect -->
  <FieldSpecification name="initPressureM" initialCondition="1"
    setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions"
    fieldName="pressure" scale="4.55e5"/>
  <FieldSpecification name="initPressureF" initialCondition="1"
    setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions"
    fieldName="pressure" scale="4.88e5"/>

  <!-- N=2 Initial effective stress (mesh1) -->
  <FieldSpecification name="initial_sigma_x" initialCondition="1"
    setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions"
    fieldName="matrixSolid_stress" component="0" scale="4.67e5"/>
  <FieldSpecification name="initial_sigma_y" initialCondition="1"
    setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions"
    fieldName="matrixSolid_stress" component="1" scale="0.0"/>
  <FieldSpecification name="initial_sigma_z" initialCondition="1"
    setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions"
    fieldName="matrixSolid_stress" component="2" scale="-5.33e5"/>




    <FieldSpecification
      name="xInitialDisplacement"
      initialCondition="1"
      setNames="{ all }"
      targetMesh="mesh1"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="0"
      scale="1.0"
      functionName="initialUxFunc"/>

    <FieldSpecification
      name="yInitialDisplacement"
      initialCondition="1"
      setNames="{ all }"
      targetMesh="mesh1"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="1"
      scale="0.0"/>

    <FieldSpecification
      name="zInitialDisplacement"
      initialCondition="1"
      setNames="{ all }"
      targetMesh="mesh1"
      objectPath="nodeManager"
      fieldName="totalDisplacement"
      component="2"
      scale="-1.0"
      functionName="initialUzFunc"/>


    <FieldSpecification name="xnegconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="0" scale="0.0" setNames="{ xneg }"/>
    <FieldSpecification name="yconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="1" scale="0.0" setNames="{ yneg, ypos }"/>
    <FieldSpecification name="znegconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="2" scale="0.0" setNames="{ zneg }"/>


    <!-- <FieldSpecification name="zposLoad"
      objectPath="faceManager" targetMesh="mesh1"
      fieldName="traction" component="2" scale="-1.0e6" setNames="{ zpos }"/> -->
      
      
    <!-- Rigid top boundary with 1 MPa compressive pressure -->
    <RigidBoundary name="zposLoad"
      objectPath="faceManager" targetMesh="mesh1"
      component="2" scale="-1.0e6" setNames="{ zpos }"/>

    <FieldSpecification name="boundaryPressureM"
      objectPath="faceManager" targetMesh="mesh1"
      fieldName="pressure" scale="0.0" setNames="{ xpos }"/>
    <FieldSpecification name="boundaryPressureF"
      objectPath="faceManager" targetMesh="mesh2"
      fieldName="pressure" scale="0.0" setNames="{ xpos }"/>
  </FieldSpecifications>

  <!-- τ=3 → t=308412s, log-spaced phases for plotting -->
<!--  <Events maxTime="308412.0"> -->
<!-- run 300s to test if the solver can handle the load in fracture -->
    <Events maxTime="300.0">

    <PeriodicEvent name="vtk0" timeFrequency="0.01" beginTime="0.0" endTime="0.1" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="vtk1" timeFrequency="0.1" beginTime="0.1" endTime="10.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="vtk2" timeFrequency="10.0" beginTime="10.0" endTime="1000.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="vtk3" timeFrequency="300.0" beginTime="1000.0" endTime="10000.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="vtk4" timeFrequency="3000.0" beginTime="10000.0" endTime="100000.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="vtk5" timeFrequency="30000.0" beginTime="100000.0" endTime="308412.0" target="/Outputs/vtkOutput"/>

    <PeriodicEvent name="solverPhase0" beginTime="0.0" endTime="0.01" forceDt="0.001" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase1" beginTime="0.01" endTime="0.1" forceDt="0.01" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase2" beginTime="0.1" endTime="1.0" forceDt="0.1" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase3" beginTime="1.0" endTime="10.0" forceDt="1.0" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase4" beginTime="10.0" endTime="100.0" forceDt="10" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase5" beginTime="100.0" endTime="1000.0" forceDt="100" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase6" beginTime="1000.0" endTime="10000.0" forceDt="300" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase7" beginTime="10000.0" endTime="100000.0" forceDt="3000" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase8" beginTime="100000.0" endTime="308412.0" forceDt="10000" target="/Solvers/poroSolver"/>

    <PeriodicEvent name="pressureMatrixEvent" target="/Tasks/pressureMatrixCollection"/>
    <PeriodicEvent name="pressureMatrixOutputEvent" targetExactTimestep="0" target="/Outputs/pressureMatrixHistory"/>
    <PeriodicEvent name="pressureFractureEvent" target="/Tasks/pressureFractureCollection"/>
    <PeriodicEvent name="pressureFractureOutputEvent" targetExactTimestep="0" target="/Outputs/pressureFractureHistory"/>
    <PeriodicEvent name="displacementEvent" target="/Tasks/displacementCollection"/>
    <PeriodicEvent name="displacementOutputEvent" targetExactTimestep="0" target="/Outputs/displacementHistory"/>
  </Events>

  <Tasks>
    <PackCollection name="pressureMatrixCollection"
      objectPath="mesh1/ElementRegions/matrixRegion/matrixBlock" fieldName="pressure"/>
    <PackCollection name="pressureFractureCollection"
      objectPath="mesh2/ElementRegions/fractureRegion/fractureBlock" fieldName="pressure"/>
    <PackCollection name="displacementCollection"
      objectPath="mesh1/nodeManager" fieldName="totalDisplacement"/>
  </Tasks>

  <Outputs>
    <VTK name="vtkOutput"/>
    <TimeHistory name="pressureMatrixHistory"
      sources="{ /Tasks/pressureMatrixCollection }" filename="pressure_matrix_history"/>
    <TimeHistory name="pressureFractureHistory"
      sources="{ /Tasks/pressureFractureCollection }" filename="pressure_fracture_history"/>
    <TimeHistory name="displacementHistory"
      sources="{ /Tasks/displacementCollection }" filename="displacement_history"/>
  </Outputs>
</Problem>