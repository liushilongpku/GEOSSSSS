<?xml version="1.0" ?>
<!--
  DPDP Mandel — Degradation to Single-Porosity
  Verifies SinglePhaseDualContinuumPoromechanics coupling by degenerating
  to single-porosity (fracture α_f→0, k_f→0, Γ→0, pressure BC removed).
-->
<Problem>
  <NumericalMethods>
    <FiniteElements><FiniteElementSpace name="FE1" order="1"/></FiniteElements>
    <FiniteVolume><TwoPointFluxApproximation name="singlePhaseTPFA"/></FiniteVolume>
  </NumericalMethods>

  <Mesh>
    <InternalMesh name="mesh1" elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 0.03 }" yCoords="{ 0.0, 0.03 }" zCoords="{ 0.0, 0.03 }"
      nx="{ 20 }" ny="{ 1 }" nz="{ 20 }" cellBlockNames="{ matrixBlock }"/>
    <InternalMesh name="mesh2" elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 0.03 }" yCoords="{ 0.0, 0.03 }" zCoords="{ 0.0, 0.03 }"
      nx="{ 20 }" ny="{ 1 }" nz="{ 20 }" cellBlockNames="{ fractureBlock }"/>
  </Mesh>

  <Geometry>
    <Box name="xneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 1e-3, 30.1e-3, 30.1e-3 }"/>
    <Box name="xpos" xMin="{ 29e-3, -1e-3, -1e-3 }" xMax="{ 31e-3, 30.1e-3, 30.1e-3 }"/>
    <Box name="yneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 30.1e-3, 1e-3, 30.1e-3 }"/>
    <Box name="ypos" xMin="{ -1e-3, 29e-3, -1e-3 }" xMax="{ 30.1e-3, 31e-3, 30.1e-3 }"/>
    <Box name="zneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 30.1e-3, 30.1e-3, 1e-3 }"/>
    <Box name="zpos" xMin="{ -1e-3, -1e-3, 29e-3 }" xMax="{ 30.1e-3, 30.1e-3, 31e-3 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion name="matrixRegion" meshBody="mesh1"
      cellBlocks="{ matrixBlock }" materialList="{ matrixRock, water }"/>
    <CellElementRegion name="fractureRegion" meshBody="mesh2"
      cellBlocks="{ fractureBlock }" materialList="{ fractureRock, water }"/>
  </ElementRegions>

  <Constitutive>
    <CompressibleSinglePhaseFluid name="water"
      defaultDensity="1000" defaultViscosity="0.001"
      referencePressure="0.0" compressibility="5.734e-10"/>

    <!-- Matrix: identical to SP_Mandel_new -->
    <ElasticIsotropic name="matrixSolid"
      defaultDensity="0" defaultBulkModulus="1.1e9" defaultShearModulus="7.5738e8"/>
    <BiotPorosity name="matrixPorosity"
      defaultGrainBulkModulus="2.7e10" defaultReferencePorosity="0.14"/>
    <ConstantPermeability name="matrixPerm"
      permeabilityComponents="{ 4.9346e-21, 4.9346e-21, 4.9346e-21 }"/>
    <PorousElasticIsotropic name="matrixRock"
      solidModelName="matrixSolid" porosityModelName="matrixPorosity"
      permeabilityModelName="matrixPerm"/>

    <!-- Fracture: degraded (α_f=0, k_f→0, φ_f→0, Γ=0) -->
    <ElasticIsotropic name="fractureSolid"
      defaultDensity="0" defaultBulkModulus="2.7e10" defaultShearModulus="7.5738e8"/>
    <BiotPorosity name="fracturePorosity"
      defaultGrainBulkModulus="2.7e10" defaultReferencePorosity="1.0e-12"/>
    <ConstantPermeability name="fracturePerm"
      permeabilityComponents="{ 1.0e-30, 1.0e-30, 1.0e-30 }"/>
    <PorousElasticIsotropic name="fractureRock"
      solidModelName="fractureSolid" porosityModelName="fracturePorosity"
      permeabilityModelName="fracturePerm"/>
  </Constitutive>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <SinglePhaseFVM name="matrixFlow" logLevel="1"
      discretization="singlePhaseTPFA" targetRegions="{ mesh1/matrixRegion }">
      <NonlinearSolverParameters newtonMaxIter="40" newtonTol="1.0e-4"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </SinglePhaseFVM>
    <SinglePhaseFVM name="fractureFlow" logLevel="1"
      discretization="singlePhaseTPFA" targetRegions="{ mesh2/fractureRegion }">
      <NonlinearSolverParameters newtonMaxIter="40" newtonTol="1.0e-4"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </SinglePhaseFVM>
    <SolidMechanicsLagrangianFEM name="solidMech" logLevel="1"
      discretization="FE1" targetRegions="{ mesh1/matrixRegion }"
      timeIntegrationOption="QuasiStatic" contactRelationName="tractionlessContact"/>

    <DualContinuumFVM name="dualFlow" logLevel="1"
      flowSolverName="matrixFlow" flowSolverName1="fractureFlow"
      matrixRegionList="{ matrixRegion }" fractureRegionList="{ fractureRegion }"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }"
      transferCoefficient="0.0">
      <DualContinuumCrossFlow
        interporosityExchangeCoefficient="0.0"
        fractureSpacingLx="1.0" fractureSpacingLy="1.0" fractureSpacingLz="1.0"
        gravityDrainageFlag="0"
        matrixRegionList="{ matrixRegion }" fractureRegionList="{ fractureRegion }"/>
      <NonlinearSolverParameters newtonMaxIter="40" newtonTol="1.0e-4"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </DualContinuumFVM>

    <SinglePhaseDualContinuumPoromechanics name="poroSolver"
      logLevel="1" dualcontinuumSolverName="dualFlow" solidSolverName="solidMech"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }"
      stabilizationType="None" isThermal="0">
      <NonlinearSolverParameters
        couplingType="FullyImplicit" newtonMaxIter="80" newtonTol="1.0e-6"
        maxTimeStepCuts="2" timeStepCutFactor="0.5"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </SinglePhaseDualContinuumPoromechanics>
  </Solvers>

  <Functions>
    <TableFunction name="initialUxFunc"
      inputVarNames="{ ReferencePosition }"
      coordinateFiles="{ mandel_tables/xlin.geos, mandel_tables/ylin.geos, mandel_tables/zlin.geos }"
      voxelFile="mandel_tables/ux.geos"/>
    <TableFunction name="initialUzFunc"
      inputVarNames="{ ReferencePosition }"
      coordinateFiles="{ mandel_tables/xlin2.geos, mandel_tables/ylin2.geos, mandel_tables/zlin2.geos }"
      voxelFile="mandel_tables/uz.geos"/>
    <TableFunction name="loadFunction" inputVarNames="{ time }"
      coordinates="{ 0.0000e+00, 1.0000e-12, 1.0280e-01, 1.1018e-01, 1.1809e-01, 1.2656e-01, 1.4538e-01, 1.6700e-01, 2.0560e-01, 2.3616e-01, 2.9075e-01, 3.3398e-01, 3.8363e-01, 4.7230e-01, 5.4252e-01, 6.6791e-01, 7.6722e-01, 8.8129e-01, 1.0850e+00, 1.2463e+00, 1.5343e+00, 1.7625e+00, 2.0245e+00, 2.4924e+00, 2.8630e+00, 3.5247e+00, 4.0488e+00, 4.6508e+00, 5.7257e+00, 6.5770e+00, 8.0971e+00, 9.3011e+00, 1.0684e+01, 1.3153e+01, 1.5109e+01, 1.8601e+01, 2.1367e+01, 2.4544e+01, 3.0216e+01, 3.4709e+01, 4.2731e+01, 4.9084e+01, 6.0428e+01, 6.9413e+01, 7.9734e+01, 9.8162e+01, 1.1276e+02, 1.3882e+02, 1.5946e+02, 1.8317e+02, 2.2550e+02, 2.5903e+02, 3.1890e+02, 3.6631e+02, 4.2078e+02, 5.1803e+02, 5.9505e+02, 7.3258e+02, 8.4150e+02, 9.6662e+02, 1.1900e+03, 1.3670e+03, 1.6829e+03, 1.9331e+03, 2.2205e+03, 2.7338e+03, 3.1402e+03, 3.8660e+03, 4.4408e+03, 5.1011e+03, 6.2801e+03, 7.2138e+03, 8.8811e+03, 1.0202e+04, 1.1718e+04, 1.4427e+04, 1.6572e+04, 2.0402e+04, 2.3435e+04, 2.8852e+04 }"
      values="{ 9.2605205024e-06, 9.2605205024e-06, 9.2605205024e-06, 9.2606579381e-06, 9.2608001774e-06, 9.2609474591e-06, 9.2612577307e-06, 9.2615903984e-06, 9.2621346143e-06, 9.2625302618e-06, 9.2631775753e-06, 9.2636481464e-06, 9.2641524824e-06, 9.2649776811e-06, 9.2655776131e-06, 9.2665592772e-06, 9.2672728068e-06, 9.2680377730e-06, 9.2692894567e-06, 9.2701994148e-06, 9.2716885165e-06, 9.2727710384e-06, 9.2739314662e-06, 9.2758306217e-06, 9.2772113377e-06, 9.2794711042e-06, 9.2811141557e-06, 9.2828754894e-06, 9.2857585810e-06, 9.2878549852e-06, 9.2912865771e-06, 9.2937818800e-06, 9.2964575678e-06, 9.3008379149e-06, 9.3040236954e-06, 9.3092398043e-06, 9.3130338505e-06, 9.3171028872e-06, 9.3237664210e-06, 9.3286142674e-06, 9.3365547900e-06, 9.3423327457e-06, 9.3517984643e-06, 9.3586877544e-06, 9.3660803399e-06, 9.3781954874e-06, 9.3870165179e-06, 9.4014769485e-06, 9.4120090843e-06, 9.4233175506e-06, 9.4418660081e-06, 9.4553832416e-06, 9.4775650362e-06, 9.4937384477e-06, 9.5111204179e-06, 9.5396678004e-06, 9.5605007122e-06, 9.5947404677e-06, 9.6197468791e-06, 9.6466611736e-06, 9.6909515571e-06, 9.7233421022e-06, 9.7767035488e-06, 9.8157745979e-06, 9.8579204405e-06, 9.9274878464e-06, 9.9785310098e-06, 1.0062929788e-05, 1.0124970013e-05, 1.0192124004e-05, 1.0303497255e-05, 1.0385631869e-05, 1.0522214123e-05, 1.0623226644e-05, 1.0733143160e-05, 1.0916696433e-05, 1.1052938672e-05, 1.1280545495e-05, 1.1449003149e-05, 1.1728037228e-05 }"/>
  </Functions>

  <FieldSpecifications>
    <FieldSpecification name="initPressureM" initialCondition="1"
      setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions"
      fieldName="pressure" scale="4.48e5"/>
    <FieldSpecification name="initPressureF" initialCondition="1"
      setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions"
      fieldName="pressure" scale="4.48e5"/>

    <!-- Initial effective stress (matrix mesh only) -->
    <FieldSpecification name="initial_sigma_x" initialCondition="1"
      setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions"
      fieldName="matrixSolid_stress" component="0" scale="4.3e5"/>
    <FieldSpecification name="initial_sigma_y" initialCondition="1"
      setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions"
      fieldName="matrixSolid_stress" component="1" scale="4.3e5"/>
    <FieldSpecification name="initial_sigma_z" initialCondition="1"
      setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions"
      fieldName="matrixSolid_stress" component="2" scale="-5.7e5"/>

    <!-- Initial displacement (matrix mesh only) -->
    <FieldSpecification name="xInitialDisplacement" initialCondition="1"
      setNames="{ all }" targetMesh="mesh1" objectPath="nodeManager"
      fieldName="totalDisplacement" component="0" scale="1.0"
      functionName="initialUxFunc"/>
    <FieldSpecification name="yInitialDisplacement" initialCondition="1"
      setNames="{ all }" targetMesh="mesh1" objectPath="nodeManager"
      fieldName="totalDisplacement" component="1" scale="0.0"/>
    <FieldSpecification name="zInitialDisplacement" initialCondition="1"
      setNames="{ all }" targetMesh="mesh1" objectPath="nodeManager"
      fieldName="totalDisplacement" component="2" scale="1.0"
      functionName="initialUzFunc"/>

    <FieldSpecification name="xnegconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="0" scale="0.0" setNames="{ xneg }"/>
    <FieldSpecification name="yconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="1" scale="0.0" setNames="{ yneg, ypos }"/>
    <FieldSpecification name="znegconstraint"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="2" scale="0.0" setNames="{ zneg }"/>
    <FieldSpecification name="zposLoad"
      objectPath="nodeManager" targetMesh="mesh1"
      fieldName="totalDisplacement" component="2" scale="-1.0" setNames="{ zpos }"
      functionName="loadFunction"/>
    <FieldSpecification name="boundaryPressureM"
      objectPath="faceManager" targetMesh="mesh1"
      fieldName="pressure" scale="0.0" setNames="{ xpos }"/>
  </FieldSpecifications>

  <Events maxTime="28852.0">
    <PeriodicEvent name="vtkEarly1" timeFrequency="0.05" beginTime="0.0" endTime="1.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="vtkEarly" timeFrequency="200.0" beginTime="1.0" endTime="5000.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="vtkLate" timeFrequency="3000.0" beginTime="5000.0" endTime="28852.0" target="/Outputs/vtkOutput"/>

    <PeriodicEvent name="solverPhase0" beginTime="0.0" endTime="0.01" forceDt="0.001" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase1" beginTime="0.01" endTime="500.0" forceDt="10" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase2" beginTime="500.0" endTime="3000.0" forceDt="50" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase3" beginTime="3000.0" endTime="10000.0" forceDt="100" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase4" beginTime="10000.0" endTime="28852.0" forceDt="200" target="/Solvers/poroSolver"/>

    <PeriodicEvent name="pressureMatrixEvent" target="/Tasks/pressureMatrixCollection"/>
    <PeriodicEvent name="pressureMatrixOutputEvent" targetExactTimestep="0" target="/Outputs/pressureMatrixHistory"/>
    <PeriodicEvent name="displacementEvent" target="/Tasks/displacementCollection"/>
    <PeriodicEvent name="displacementOutputEvent" targetExactTimestep="0" target="/Outputs/displacementHistory"/>
  </Events>

  <Tasks>
    <PackCollection name="pressureMatrixCollection"
      objectPath="mesh1/ElementRegions/matrixRegion/matrixBlock" fieldName="pressure"/>
    <PackCollection name="displacementCollection"
      objectPath="mesh1/nodeManager" fieldName="totalDisplacement"/>
  </Tasks>

  <Outputs>
    <VTK name="vtkOutput"/>
    <TimeHistory name="pressureMatrixHistory"
      sources="{ /Tasks/pressureMatrixCollection }" filename="pressure_matrix_history"/>
    <TimeHistory name="displacementHistory"
      sources="{ /Tasks/displacementCollection }" filename="displacement_history"/>
  </Outputs>
</Problem>