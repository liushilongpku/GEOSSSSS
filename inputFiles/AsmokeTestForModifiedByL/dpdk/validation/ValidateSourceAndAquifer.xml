<?xml version="1.0" ?>

<Problem>
  <Solvers>
    <DualContinuumFVM
            name="DualContinuumSolver"
            flowSolverName="singlePhaseFlowSolver"
            flowSolverName1="singlePhaseFlowSolver1"
            logLevel="1"
            writeLinearSystem="0"
            targetRegions="{ mesh1/Region1 ,mesh2/Region2}">
      <LinearSolverParameters
              solverType="direct"
              directParallel="0"
              logLevel="0"/>
      <NonlinearSolverParameters
              newtonTol="1.0e-4"
              newtonMaxIter = "40"/>
    </DualContinuumFVM>

    <SinglePhaseFVM
      name="singlePhaseFlowSolver"
      discretization="singlePhaseTPFA"
      targetRegions="{mesh1/Region1 }"
      writeLinearSystem="1"
      logLevel="1">
      <NonlinearSolverParameters
        newtonTol="1.0e-5"
        newtonMaxIter="8"/>
      <LinearSolverParameters
        directParallel="0"/>
    </SinglePhaseFVM>

    <SinglePhaseFVM
            name="singlePhaseFlowSolver1"
            discretization="singlePhaseTPFA"
            targetRegions="{ mesh2/Region2 }"
            writeLinearSystem="1"
            logLevel="1">
      <NonlinearSolverParameters
              newtonTol="1.0e-5"
              newtonMaxIter="8"/>
      <LinearSolverParameters
              directParallel="0"/>
    </SinglePhaseFVM>
  </Solvers>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0, 1, 99, 100 }"
      yCoords="{ 0, 1 }"
      zCoords="{ 0, 1 }"
      nx="{ 1, 98, 1 }"
      ny="{ 1 }"
      nz="{ 1 }"
      cellBlockNames="{ block1 }"/>
    <InternalMesh
            name="mesh2"
            elementTypes="{ C3D8 }"
            xCoords="{ 0, 1, 99, 100 }"
            yCoords="{ 0, 1 }"
            zCoords="{ 0, 1 }"
            nx="{ 1, 98, 1 }"
            ny="{ 1 }"
            nz="{ 1 }"
            cellBlockNames="{ block2 }"/>
  </Mesh>

  <Geometry>
    <Box
      name="source"
      xMin="{ -0.01, -0.01, -0.01 }"
      xMax="{ 1.01, 1.01, 1.01 }"/>

    <Box
      name="sink"
      xMin="{ 98.99, -0.01, -0.01 }"
      xMax="{ 100.01, 1.01, 1.01 }"/>
  </Geometry>

  <Events
    maxTime="1000.0">
    <PeriodicEvent
      name="outputs"
      timeFrequency="1.0"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="solverApplications"
      forceDt="1.0"
      target="/Solvers/DualContinuumSolver"/>


  </Events>

  <NumericalMethods>
    <FiniteVolume>
      <TwoPointFluxApproximation
        name="singlePhaseTPFA"/>
    </FiniteVolume>
        <FiniteVolume>
      <TwoPointFluxApproximation
        name="singlePhaseTPFA1"/>
    </FiniteVolume>
  </NumericalMethods>

  <ElementRegions>
    <CellElementRegion
      name="Region1"
      meshBody="mesh1"
      cellBlocks="{ block1 }"
      materialList="{ water, rock }"/>
    <CellElementRegion
            name="Region2"
            meshBody="mesh2"
            cellBlocks="{ block2 }"
            materialList="{ water, rock_DPDK }"/>
  </ElementRegions>

  <Constitutive>
    <CompressibleSinglePhaseFluid
      name="water"
      defaultDensity="1000"
      defaultViscosity="0.001"
      referencePressure="0.0"
      compressibility="0.0"
      viscosibility="0.0"/>

    <CompressibleSolidConstantPermeability
      name="rock"
      solidModelName="nullSolid"
      porosityModelName="rockPorosity"
      permeabilityModelName="rockPerm"/>

    <NullModel
      name="nullSolid"/>

    <PressurePorosity
      name="rockPorosity"
      defaultReferencePorosity="0.05"
      referencePressure="0.0"
      compressibility="0.0"/>

    <ConstantPermeability
      name="rockPerm"
      permeabilityComponents="{ 2.0e-13, 2.0e-13, 2.0e-13 }"/>

    <CompressibleSolidConstantPermeability
            name="rock_DPDK"
            solidModelName="nullSolid_DPDK"
            porosityModelName="rockPorosity_DPDK"
            permeabilityModelName="rockPerm_DPDK"/>

    <NullModel
            name="nullSolid_DPDK"/>

    <PressurePorosity
            name="rockPorosity_DPDK"
            defaultReferencePorosity="0.05"
            referencePressure="0.0"
            compressibility="0.0"/>

    <ConstantPermeability
            name="rockPerm_DPDK"
      permeabilityComponents="{ 2.0e-13, 2.0e-13, 2.0e-13 }"/>
  </Constitutive>

  <FieldSpecifications>
<!--
    <FieldSpecification
            name="Porosity"
            initialCondition="1"
            targetMesh="mesh1"
            setNames="{ all }"
            objectPath="ElementRegions"
            fieldName="rockPorosity_referencePorosity"
            scale="0.05"/>
    <FieldSpecification
            name="Porosity2"
            initialCondition="1"
            targetMesh="mesh2"
            setNames="{ all }"
            objectPath="ElementRegions"
            fieldName="rockPorosity_DPDK_referencePorosity"
            scale="0.05"/>
-->
    <FieldSpecification
            name="initialPressure1"
            initialCondition="1"
            setNames="{ all }"
            targetMesh="mesh1"
            objectPath="ElementRegions"
            fieldName="pressure"
            scale="1e6"/>
    <FieldSpecification
            name="initialPressure2"
            initialCondition="1"
            setNames="{ all }"
            targetMesh="mesh2"
            objectPath="ElementRegions"
            fieldName="pressure"
            scale="1e6"/>

        <!-- Source Pressure BC for mesh1
                targetMesh="mesh1"
     1e6 min pressure max pressure : 4.6e7
     
     when using the /home/hello/codes/GEOSSSSS/build-your-platform-debug/bin/geosx
     the result is the same whit the single version 
     -->
    
    <FieldSpecification
            name="sourcePressure1"
            objectPath="ElementRegions"
            targetMesh="mesh1"
            fieldName="pressure"
            scale="5e6"
            setNames="{ source }"/>
    <!-- Sink Flux BC for mesh1
    <SourceFlux
            name="sinkFlux1"
            objectPath="ElementRegions"
            targetMesh="mesh1"
            scale="-0.1"
            setNames="{ sink }"/> -->

    <!-- Source Flux BC for mesh2
    <SourceFlux
            name="sourceFlux2"
            objectPath="ElementRegions"
            targetMesh="mesh2"
            scale="-0.1"
            setNames="{ source }"/> -->
    <!-- Sink Pressure BC for mesh2 -->
    <FieldSpecification
            name="sinkPressure2"
            objectPath="ElementRegions"
            targetMesh="mesh2"
            fieldName="pressure"
            scale="5e6"
            setNames="{ sink }"/>

    <!-- Aquifer BC for mesh1
    <Aquifer
            name="aquifer1"
            targetMesh="mesh1"
            setNames="{ source }"
            aquiferPorosity="0.1"
            aquiferPermeability="1e-12"
            aquiferThickness="1.0"
            aquiferInitialPressure="1e6"
            aquiferWaterViscosity="0.001"
            aquiferWaterDensity="1000"
            aquiferTotalCompressibility="1e-9"
            aquiferElevation="0.0"
            aquiferInnerRadius="1.0"
            aquiferAngle="6.283185307"
            allowAllPhasesIntoAquifer="1"/>    -->
    <!-- Aquifer BC for mesh2
    <Aquifer
            name="aquifer2"
            targetMesh="mesh2"
            setNames="{ sink }"
            aquiferPorosity="0.1"
            aquiferPermeability="1e-12"
            aquiferThickness="1.0"
            aquiferInitialPressure="1e6"
            aquiferWaterViscosity="0.001"
            aquiferWaterDensity="1000"
            aquiferTotalCompressibility="1e-9"
            aquiferElevation="0.0"
            aquiferInnerRadius="1.0"
            aquiferAngle="6.283185307"
            allowAllPhasesIntoAquifer="1"/> -->

  </FieldSpecifications>

  <Outputs>
    <VTK
      name="vtkOutput"
      childDirectory="../../datafile"/>
  </Outputs>
</Problem>