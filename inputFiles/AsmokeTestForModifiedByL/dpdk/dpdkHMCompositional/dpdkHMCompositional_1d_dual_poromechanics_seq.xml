<?xml version="1.0" ?>
<!-- 需要设置自动应力。。。。后续再修 -->
<Problem>
  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace name="FE1" order="1"/>
    </FiniteElements>
    <FiniteVolume>
      <TwoPointFluxApproximation name="fluidTPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 1.0 }"
      yCoords="{ 0.0, 1.0 }"
      zCoords="{ 0.0, 10.0 }"
      nx="{ 1 }"
      ny="{ 1 }"
      nz="{ 40 }"
      cellBlockNames="{ matrixBlock }"/>
    <InternalMesh
      name="mesh2"
      elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 1.0 }"
      yCoords="{ 0.0, 1.0 }"
      zCoords="{ 0.0, 10.0 }"
      nx="{ 1 }"
      ny="{ 1 }"
      nz="{ 40 }"
      cellBlockNames="{ fractureBlock }"/>
  </Mesh>

  <Geometry>
    <Box name="xMinBoundary" xMin="{ -0.1, -0.1, -0.1 }" xMax="{ 0.1, 1.1, 10.1 }"/>
    <Box name="xMaxBoundary" xMin="{ 0.9, -0.1, -0.1 }" xMax="{ 1.1, 1.1, 10.1 }"/>
    <Box name="yMinBoundary" xMin="{ -0.1, -0.1, -0.1 }" xMax="{ 1.1, 0.1, 10.1 }"/>
    <Box name="yMaxBoundary" xMin="{ -0.1, 0.9, -0.1 }" xMax="{ 1.1, 1.1, 10.1 }"/>
    <Box name="zMinBoundary" xMin="{ -0.1, -0.1, -0.1 }" xMax="{ 1.1, 1.1, 0.1 }"/>
    <Box name="zMaxBoundary" xMin="{ -0.1, -0.1, 9.9 }" xMax="{ 1.1, 1.1, 10.1 }"/>
    <Box name="lowerCells" xMin="{ -0.1, -0.1, -0.1 }" xMax="{ 1.1, 1.1, 0.26 }"/>
    <Box name="upperCells" xMin="{ -0.1, -0.1, 9.74 }" xMax="{ 1.1, 1.1, 10.1 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion
      name="matrixRegion"
      meshBody="mesh1"
      cellBlocks="{ matrixBlock }"
      materialList="{ matrixRock, fluid, relperm }"/>
    <CellElementRegion
      name="fractureRegion"
      meshBody="mesh2"
      cellBlocks="{ fractureBlock }"
      materialList="{ fractureRock, fluid, relperm }"/>
  </ElementRegions>

  <Constitutive>
    <CO2BrinePhillipsFluid
      name="fluid"
      phaseNames="{ gas, water }"
      componentNames="{ co2, water }"
      componentMolarWeight="{ 44e-3, 18e-3 }"
      phasePVTParaFiles="{ pvtgas.txt, pvtliquid.txt }"
      flashModelParaFile="co2flash.txt"/>

    <BrooksCoreyRelativePermeability
      name="relperm"
      phaseNames="{ gas, water }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 1.5, 1.5 }"
      phaseRelPermMaxValue="{ 0.9, 0.9 }"/>

    <ElasticIsotropic
      name="matrixSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="1.0e9"
      defaultShearModulus="0.6e9"/>
    <BiotPorosity
      name="matrixPorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.1"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="matrixPerm"
      permeabilityComponents="{ 1.0e-18, 1.0e-18, 1.0e-18 }"/>
    <PorousElasticIsotropic
      name="matrixRock"
      solidModelName="matrixSolid"
      porosityModelName="matrixPorosity"
      permeabilityModelName="matrixPerm"/>

    <ElasticIsotropic
      name="fractureSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="2.0e8"
      defaultShearModulus="1.2e8"/>
    <BiotPorosity
      name="fracturePorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.5"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="fracturePerm"
      permeabilityComponents="{ 1.0e-13, 1.0e-13, 1.0e-13 }"/>
    <PorousElasticIsotropic
      name="fractureRock"
      solidModelName="fractureSolid"
      porosityModelName="fracturePorosity"
      permeabilityModelName="fracturePerm"/>
  </Constitutive>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <CompositionalMultiphaseFVM
      name="matrixFlow"
      logLevel="0"
      discretization="fluidTPFA"
      temperature="368.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh1/matrixRegion }">
      <NonlinearSolverParameters newtonTol="1.0e-4" newtonMaxIter="100" lineSearchAction="None" maxTimeStepCuts="8"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>

    <CompositionalMultiphaseFVM
      name="fractureFlow"
      logLevel="0"
      discretization="fluidTPFA"
      temperature="368.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh2/fractureRegion }">
      <NonlinearSolverParameters newtonTol="1.0e-4" newtonMaxIter="100" lineSearchAction="None" maxTimeStepCuts="8"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>

    <SolidMechanicsLagrangianFEM
      name="solidMech"
      logLevel="0"
      discretization="FE1"
      targetRegions="{ mesh1/matrixRegion }"
      timeIntegrationOption="QuasiStatic"/>

    <CompositionalMultiPhaseDualContinuumFVM
      name="dualFlow"
      logLevel="0"
      flowSolverName="matrixFlow"
      flowSolverName1="fractureFlow"
      matrixRegionList="{ matrixRegion }"
      fractureRegionList="{ fractureRegion }"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }">
      <DualContinuumCrossFlow
        fractureSpacingLx="1.0"
        fractureSpacingLy="1.0"
        fractureSpacingLz="1.0"
        matrixRegionList="{ matrixRegion }"
        fractureRegionList="{ fractureRegion }"/>
      <!-- lineSearchAction="Attempt": Sequential 下 dualFlow 单独求解，CO2 摩尔分数 0.006
           恰在气相出现边界，多相 Newton 会陷入 period-2 极限环（残差在 8.6e-4 与 3.5e-2
           之间反复跳变，永不收敛）。FIM 靠单体 cross-storage 阻尼掉该模态；Sequential 下
           需用线搜索打破极限环。 -->
      <NonlinearSolverParameters newtonTol="1.0e-4" newtonMaxIter="40" lineSearchAction="Attempt"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiPhaseDualContinuumFVM>

    <!-- Sequential（固定应力）顺序耦合：每个外迭代先解双重介质多相流(dualFlow)，
         再经复合压力解固体力学，固定应力把平均应力增量反馈到孔隙度。
         注意：fimNewtonRelaxation / enableFimCrossStorage 仅作用于 FullyImplicit 路径，
         Sequential 下被忽略，故此处不设置。
         autoInitializeStress=1（关键）：把基质初始有效应力设为与初始孔压平衡（σ'=α·p），
         使柱体 t=0 处于力学平衡。本算例两端有 Dirichlet 定压 + 顶面自由，若设 0，则
         零初始应力遇 1MPa 孔压 → 柱体非平衡变形 → 固定应力把巨大应力增量反馈成孔压，
         基质压力非物理地跌穿 0.8MPa 下界（实测跌到 0.71）。设 1 后基质稳定在 [0.8,1.2]，
         与 FIM 解一致。（dpdkHMCompositionalSeq.xml 无定压边界、纯初始压差弛豫，
         故那里设 0 不暴露此问题。）
         couplingType=Sequential 时，本求解器的 newtonMaxIter/newtonTol 控制的是
         外层 flow<->mechanics 固定应力迭代。 -->
    <CompositionalMultiphaseDualContinuumPoromechanics
      name="poroSolver"
      logLevel="0"
      dualcontinuumSolverName="dualFlow"
      solidSolverName="solidMech"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }"
      fractureVolumeFraction="0.1"
      enableFractureMechanicsCoupling="1"
      autoInitializeStress="1"
      stabilizationType="None"
      isThermal="0">
      <NonlinearSolverParameters
        couplingType="Sequential"
        newtonTol="1.0e-6"
        newtonMaxIter="40"
        lineSearchAction="None"
        maxTimeStepCuts="10"
        timeStepCutFactor="0.5"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseDualContinuumPoromechanics>
  </Solvers>

  <FieldSpecifications>
    <FieldSpecification name="initPressureM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="1.0e6"/>
    <FieldSpecification name="initPressureF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="1.0e6"/>
    <FieldSpecification name="initCo2M" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>
    <FieldSpecification name="initCo2F" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>

    <FieldSpecification name="lowerPressureM" setNames="{ lowerCells }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="1.2e6"/>
    <FieldSpecification name="lowerPressureF" setNames="{ lowerCells }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="1.2e6"/>
    <FieldSpecification name="upperPressureM" setNames="{ upperCells }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="0.8e6"/>
    <FieldSpecification name="upperPressureF" setNames="{ upperCells }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="0.8e6"/>
    <FieldSpecification name="lowerCo2M" setNames="{ lowerCells }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="lowerWaterM" setNames="{ lowerCells }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>
    <FieldSpecification name="lowerCo2F" setNames="{ lowerCells }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="lowerWaterF" setNames="{ lowerCells }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>

    <FieldSpecification name="xFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="0" scale="0.0" setNames="{ xMinBoundary, xMaxBoundary }"/>
    <FieldSpecification name="yFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="1" scale="0.0" setNames="{ yMinBoundary, yMaxBoundary }"/>
    <FieldSpecification name="zFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="2" scale="0.0" setNames="{ zMinBoundary }"/>
  </FieldSpecifications>

  <Events maxTime="1000.0">
    <PeriodicEvent name="outputs" timeFrequency="100.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="solverPhase0" beginTime="0.0" endTime="1.0" forceDt="0.1" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase1" beginTime="1.0" endTime="100.0" forceDt="1.0" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase2" beginTime="100.0" endTime="1000.0" forceDt="100.0" target="/Solvers/poroSolver"/>
  </Events>

  <Outputs>
    <VTK name="vtkOutput"/>
  </Outputs>
</Problem>
