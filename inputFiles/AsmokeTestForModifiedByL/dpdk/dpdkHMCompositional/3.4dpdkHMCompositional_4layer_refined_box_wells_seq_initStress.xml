<?xml version="1.0" ?>

<!--
  从 dpdkHMCompositional_4layer_refined_box_wells_seq.xml 派生：
  把“自动平衡初始应力”改为“用户自定义初始有效应力”（地应力 / 各向异性初值）。

  改动：
    1. poroSolver: autoInitializeStress 由 1 -> 0（不再自动平衡，改由 FieldSpecification 指定）。
    2. 新增 init_sigma_xx/yy/zz，把基质固体模型 matrixSolid 的有效应力张量 matrixSolid_stress
       直接写为指定地应力（力学核读取的就是它；component 0/1/2/3/4/5 = xx/yy/zz/yz/xz/xy，Voigt）。

  关键：本网格顶面 z=0 是自由面（只有 zneg 底面被 z 固定，xneg/xpos/yneg/ypos 为侧向 roller）。
  无重力体力时，力学平衡要求 div(σ_total)=0 且自由面法向 traction=0：
    - 竖向：σzz_total = σ'_zz - (α_m·p_m,0 + α_f·p_f,0) 必须为 0（自由顶面无外载）。
      取 α_m=α_f=0.8、p_m,0=p_f,0=1.0e6  =>  α_m·p_m+α_f·p_f = 1.6e6，故 σ'_zz = 1.6e6。
    - 水平：侧向四面被 roller 约束，可施加任意均匀地应力分量。
      这里取各向异性水平地应力 σ'_xx = σ'_yy = -3.0e6（GEOS 约定压为负，代表水平挤压地应力）。
  这样 t=0 处于力学平衡（自由面 traction=0、内部 div(σ)=0），Sequential 固定应力首步无非物理变形。

  若改为自动平衡，删除下方 init_sigma_* 三条并把 autoInitializeStress 改回 1 即可。
-->
<Problem>
  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace name="FE1" order="1"/>
    </FiniteElements>
    <FiniteVolume>
      <TwoPointFluxApproximation name="fluidTPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <Mesh>
    <VTKMesh name="mesh1" file="../dpdkwellinjection/reservoir_4layer_refined.vtk"/>
    <VTKMesh name="mesh2" file="../dpdkwellinjection/reservoir_4layer_refined.vtk"/>
  </Mesh>

  <Geometry>
    <!--
      井 box 缩到正好一个网格（加密区 cell ≈ 12.5 m）。
      重要：GEOS 判定单元是否入集，要求该单元【全部 8 个节点】都落在 box 内（见
      ObjectManagerBase::constructSetFromSetAndMap 的 all_of(node ∈ nodeSet)），
      不是按单元中心！所以 box 必须把整个单元【包住】，又要排除相邻单元的外侧节点面。
        注入井目标单元：节点 x∈{500,512.5}, y∈{750,762.5}, z∈{-12.5,0}，中心 (506.25,756.25,-6.25)。
          相邻节点面在 x=487.5/525, y=737.5/775, z=-25，box 取 ±1 m 余量即可只含此单元。
        生产井目标单元：节点 x∈{1500,1512.5}, y/z 同上，中心 (1506.25,756.25,-6.25)。
      已用 VTK 网格按“全节点在内”规则核验：每个 box 恰好选中 1 个单元。
    -->
    <Box name="injectorBox" xMin="{ 499.0, 749.0, -13.5 }" xMax="{ 513.5, 763.5, 1.0 }"/>
    <Box name="producerBox" xMin="{ 1499.0, 749.0, -13.5 }" xMax="{ 1513.5, 763.5, 1.0 }"/>
    <Box name="xneg" xMin="{ -1.0, -1.0, -110.0 }" xMax="{ 1.0, 1501.0, 10.0 }"/>
    <Box name="xpos" xMin="{ 1999.0, -1.0, -110.0 }" xMax="{ 2001.0, 1501.0, 10.0 }"/>
    <Box name="yneg" xMin="{ -1.0, -1.0, -110.0 }" xMax="{ 2001.0, 1.0, 10.0 }"/>
    <Box name="ypos" xMin="{ -1.0, 1499.0, -110.0 }" xMax="{ 2001.0, 1501.0, 10.0 }"/>
    <Box name="zneg" xMin="{ -1.0, -1.0, -101.0 }" xMax="{ 2001.0, 1501.0, -99.0 }"/>
    <Box name="zpos" xMin="{ -1.0, -1.0, -1.0 }" xMax="{ 2001.0, 1501.0, 1.0 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion
      name="matrixRegion"
      meshBody="mesh1"
      cellBlocks="{ hexahedra }"
      materialList="{ matrixRock, fluid, relperm }"/>
    <CellElementRegion
      name="fractureRegion"
      meshBody="mesh2"
      cellBlocks="{ hexahedra }"
      materialList="{ fractureRock, fluid, relperm }"/>
  </ElementRegions>

  <Constitutive>
    <CO2BrinePhillipsFluid
      name="fluid"
      phaseNames="{ gas, water }"
      componentNames="{ co2, water }"
      componentMolarWeight="{ 44e-3, 18e-3 }"
      phasePVTParaFiles="{ pvtgas.txt, pvtliquid.txt }"
      flashModelParaFile="co2flash.txt"/>

    <BrooksCoreyRelativePermeability
      name="relperm"
      phaseNames="{ gas, water }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 1.5, 1.5 }"
      phaseRelPermMaxValue="{ 0.9, 0.9 }"/>

    <ElasticIsotropic
      name="matrixSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="1.0e9"
      defaultShearModulus="0.6e9"/>
    <BiotPorosity
      name="matrixPorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.1"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="matrixPerm"
      permeabilityComponents="{ 1.0e-15, 1.0e-15, 1.0e-15 }"/>
    <PorousElasticIsotropic
      name="matrixRock"
      solidModelName="matrixSolid"
      porosityModelName="matrixPorosity"
      permeabilityModelName="matrixPerm"/>

    <ElasticIsotropic
      name="fractureSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="2.0e8"
      defaultShearModulus="1.2e8"/>
    <BiotPorosity
      name="fracturePorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.5"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="fracturePerm"
      permeabilityComponents="{ 1.0e-12, 1.0e-12, 1.0e-12 }"/>
    <PorousElasticIsotropic
      name="fractureRock"
      solidModelName="fractureSolid"
      porosityModelName="fracturePorosity"
      permeabilityModelName="fracturePerm"/>
  </Constitutive>

  <!--
    循环注入门函数（WAG 式气水交替）：周期 2 年 = 注 CO2 1 年 + 注水 1 年，覆盖 maxTime=20 年（共 10 个循环）。
    1 年 = 31536000 s。interpolation="lower" => 速率在年边界处阶跃切换，且与 solverPhase6 的 1 年步长对齐。
    gasGate=1 时注 CO2、注水关；waterGate=1 时注水、注 CO2 关。
  -->
  <Functions>
    <TableFunction
      name="gasGate"
      inputVarNames="{ time }"
      interpolation="lower"
      coordinates="{ 0.0, 31536000.0, 63072000.0, 94608000.0, 126144000.0, 157680000.0, 189216000.0, 220752000.0, 252288000.0, 283824000.0, 315360000.0, 346896000.0, 378432000.0, 409968000.0, 441504000.0, 473040000.0, 504576000.0, 536112000.0, 567648000.0, 599184000.0, 630720000.0 }"
      values="{ 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0 }"/>
    <TableFunction
      name="waterGate"
      inputVarNames="{ time }"
      interpolation="lower"
      coordinates="{ 0.0, 31536000.0, 63072000.0, 94608000.0, 126144000.0, 157680000.0, 189216000.0, 220752000.0, 252288000.0, 283824000.0, 315360000.0, 346896000.0, 378432000.0, 409968000.0, 441504000.0, 473040000.0, 504576000.0, 536112000.0, 567648000.0, 599184000.0, 630720000.0 }"
      values="{ 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0 }"/>
  </Functions>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <CompositionalMultiphaseFVM
      name="matrixFlow"
      logLevel="1"
      discretization="fluidTPFA"
      temperature="368.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh1/matrixRegion }">
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>

    <CompositionalMultiphaseFVM
      name="fractureFlow"
      logLevel="1"
      discretization="fluidTPFA"
      temperature="368.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh2/fractureRegion }">
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>

    <SolidMechanicsLagrangianFEM
      name="solidMech"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ mesh1/matrixRegion }"
      timeIntegrationOption="QuasiStatic"/>

    <CompositionalMultiPhaseDualContinuumFVM
      name="dualFlow"
      logLevel="1"
      flowSolverName="matrixFlow"
      flowSolverName1="fractureFlow"
      matrixRegionList="{ matrixRegion }"
      fractureRegionList="{ fractureRegion }"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }">
      <DualContinuumCrossFlow
        fractureSpacingLx="50.0"
        fractureSpacingLy="50.0"
        fractureSpacingLz="25.0"
        fractureVolumeFraction="0.1"
        matrixRegionList="{ matrixRegion }"
        fractureRegionList="{ fractureRegion }"/>
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiPhaseDualContinuumFVM>

    <CompositionalMultiphaseDualContinuumPoromechanics
      name="poroSolver"
      logLevel="1"
      dualcontinuumSolverName="dualFlow"
      solidSolverName="solidMech"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }"
      fractureVolumeFraction="0.1"
      fimNewtonRelaxation="0.5"
      enableFractureMechanicsCoupling="1"
      enableFimCrossStorage="1"
      autoInitializeStress="0"
      stabilizationType="None"
      isThermal="0">
      <NonlinearSolverParameters
        couplingType="Sequential"
        newtonTol="5.0e-3"
        newtonMinIter="1"
        newtonMaxIter="60"
        lineSearchAction="None"
        maxSubSteps="1000"
        maxTimeStepCuts="8"
        timeStepCutFactor="0.5"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseDualContinuumPoromechanics>
  </Solvers>

  <FieldSpecifications>
    <FieldSpecification name="initPressureM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="1.0e6"/>
    <FieldSpecification name="initPressureF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="1.0e6"/>
    <FieldSpecification name="initCo2M" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>
    <FieldSpecification name="initCo2F" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>

    <!--
      ===== 用户自定义初始有效应力（写到基质固体模型 matrixSolid 的应力张量上） =====
      component: 0=σxx, 1=σyy, 2=σzz（Voigt；3=yz,4=xz,5=xy 此处为 0 不写）。GEOS 约定压缩为负。
      σ'_xx = σ'_yy = σ'_zz = -3.0e6：近各向同性地应力（此处三向取相同有效应力）。
      与顶面 overburden traction 配平：
        顶面外法向 n=+z，平衡条件 σzz_total = t_z（见下方 topTraction）。
        σzz_total = σ'_zz - (α_m·p_m,0 + α_f·p_f,0) = -3.0e6 - 1.6e6 = -4.6e6。
        故顶面 traction t_z = -4.6e6（4.6 MPa 向下 overburden）。
        => t=0 顶面 σzz_total = -4.6e6 = t_z，力学平衡，首步无虚假沉降。
      力学仅作用于基质 mesh1，故只写 matrixSolid_stress；裂缝无需。
    -->
    <FieldSpecification name="init_sigma_xx" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="0" scale="-3.0e6"/>
    <FieldSpecification name="init_sigma_yy" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="1" scale="-3.0e6"/>
    <FieldSpecification name="init_sigma_zz" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="2" scale="-3.0e6"/>

    <!--
      ===== 顶面 traction（overburden / 上覆荷载） =====
      tractionType="vector": traction = scale × direction（direction 不自动归一化，约定取单位向量、大小放 scale）。
      direction 可自由设任意 xyz；此处取 {0,0,-1} 表示竖直向下的 overburden，scale=4.6e6 => t={0,0,-4.6e6} Pa。
      若要加水平/剪切分量，改 direction 即可（如 { 0.2,0,-1 }），但非纯法向时 t=0 平衡需相应另配，
      否则首步会有一次小的弹性调整（物理上可接受）。
      可选 functionName="..." 做时变荷载。traction 作用在面上 => objectPath="faceManager"。
    -->
    <Traction name="topTraction" objectPath="faceManager" targetMesh="mesh1" setNames="{ zpos }" tractionType="vector" direction="{ 0.0, 0.0, -1.0 }" scale="4.6e6"/>

    <!--
      ===== 循环注入井（SourceFlux，气水交替）=====
      注入到裂缝连续介质（mesh2/fractureRegion，渗透率 1e-13 ≈ 0.1 mD）——这是井与裂缝网络的物理连接；
      基质（1e-18 ≈ 1 µD）通过双重介质 cross-flow 间接被波及，不直接往基质里灌。
      useMass="0" => scale 单位 mol/s；scale<0 表示注入；总速率落在单个注入单元上。
      速率取值（工程参考）：商业级 CO2 封存单井 ≈ 1 Mt CO2/年。
        1 Mt/年 = 1e9 kg / 3.1536e7 s / 0.044 kg·mol^-1 ≈ 720 mol/s。
        本算例为小尺寸致密单元模型，取 ~0.5 Mt/年 ≈ 360 mol/s（大型先导/小型商业规模），即 scale=-360。
        注水半周期取相近摩尔速率 360 mol/s（≈ 6.5 kg/s ≈ 560 m³/天，常见注水井量级）。
        如需 1 Mt/年商业满负荷，把 360 改成 720。
      gasGate/waterGate 使两者按年交替开关。
    -->
    <SourceFlux name="injCo2F"   targetMesh="mesh2" objectPath="ElementRegions/fractureRegion" setNames="{ injectorBox }" component="0" scale="-10.0" functionName="gasGate"/>
    <SourceFlux name="injWaterF" targetMesh="mesh2" objectPath="ElementRegions/fractureRegion" setNames="{ injectorBox }" component="1" scale="-10.0" functionName="waterGate"/>

    <!-- 生产井：单元定压（恒定 BHP 0.8 MPa）泄流，注入流体经裂缝网络流向此处 -->
    <FieldSpecification name="producerPressure1" setNames="{ producerBox }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="8e5"/>
    <FieldSpecification name="producerPressure2" setNames="{ producerBox }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="8e5"/>

    <FieldSpecification name="xFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="0" scale="0.0" setNames="{ xneg,xpos }"/>
    <FieldSpecification name="yFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="1" scale="0.0" setNames="{ yneg,ypos }"/>
    <FieldSpecification name="znegFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="2" scale="0.0" setNames="{ zneg }"/>
  </FieldSpecifications>

  <Tasks>
    <SourceFluxStatistics name="fluxStatsF" flowSolverName="fractureFlow" fluxNames="{ injCo2F, injWaterF }" logLevel="2" writeCSV="1"/>
  </Tasks>

  <Events maxTime="630720000.0">
    <PeriodicEvent name="outputs" timeFrequency="1576800.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="statsF" timeFrequency="1576800.0" target="/Tasks/fluxStatsF"/>
    <PeriodicEvent name="solverPhase0" beginTime="0.0" endTime="1.0" forceDt="0.1" target="/Solvers/poroSolver"/>
    <!-- <PeriodicEvent name="solverPhase1" beginTime="1.0" endTime="10.0" forceDt="1.0" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase2" beginTime="10.0" endTime="100.0" forceDt="10.0" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase3" beginTime="100.0" endTime="1000.0" forceDt="100.0" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase4" beginTime="1000.0" endTime="86400.0" forceDt="1000.0" target="/Solvers/poroSolver"/> -->
    <PeriodicEvent name="solverPhase5" beginTime="1.0" endTime="31536000.0" maxEventDt="86400.0" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase6" beginTime="31536000.0" endTime="630720000.0" maxEventDt="31536000.0" target="/Solvers/poroSolver"/>
  </Events>

  <Outputs>
    <VTK name="vtkOutput"/>
  </Outputs>
</Problem>
