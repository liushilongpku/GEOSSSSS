<?xml version="1.0" ?>

<!--
  双重介质流固耦合 + 井求解器注入（迭代耦合版）。
  从 dpdkHMCompositional_4layer_refined_box_wells_seq_initStress_2km.xml 派生。

  与基准 2km 文件的唯一物理改动：
    注入方式 SourceFlux  ->  井求解器。
      新增 CompositionalMultiphaseWell(wellSolver) 注入井，射孔到【裂缝连续介质】(mesh2/fractureRegion)；
      新增顶层 reservoir-well 迭代耦合器 CompositionalMultiphaseDualContinuumPoromechanicsReservoir(poroWellSolver)
      作为时间推进入口（Events 指向它）。
      ★ 井只能挂到裂缝流求解器：见 CompositionalMultiphaseReservoirAndWells<...DualContinuumPoromechanics>::
        postInputInitialization 中 wellSolver->setFlowSolverName( fractureFlowSolver )。所以 Perforation 必须 targetRegion="fractureRegion"。

  耦合方式（按用户要求：迭代耦合，不用 FIM）：
    - poroSolver（流-力）：couplingType="Sequential"，与基准一致（本加密网格单片 FIM 用 direct 会奇异，见记忆 dpdk-fim-singular-graded-mesh）。
    - poroWellSolver（储层-井）：couplingType="Sequential"（迭代储层↔井），与 dpdkwellinjection/dpdk_well_injection_iterative.xml 跑通的结构一致。
    - 线性求解一律用 gmres：加井耦合后 direct(umfpack) 会 numeric failed（奇异），gmres 可收敛（同记忆 dpdk-fim-singular-graded-mesh，且参考迭代井算例也全用 gmres）。

  ★初始有效应力沿用基准 2km 值（Sequential 口径）★：
    Sequential 力学感受的是【复合压力】 Φ_eff = α_m·p = 0.8·20 = 16 MPa（swapToCompositePressure，退化成单孔隙），
    故 σ'（GEOS 存储, σ'=σ_total+Φ, 压为负）：
      σ'_zz       = -45 + 16 = -29.0 MPa
      σ'_xx=σ'_yy = -37.5 + 16 = -21.5 MPa
    顶面 overburden traction t_z = σzz_total = -45 MPa。
    校核 t=0 平衡：σzz_total = σ'_zz - Φ = -29 - 16 = -45 = t_z ✓。
  （注：若把 poroSolver 改成 FIM，则 Φ 变为全量 32 MPa，应改用 -5.5/-5.5/-13.0；本文件用 Sequential 故沿用 16。）

  2km 现场参数（同基准）：储层孔压 20 MPa、温度 348.15K(75°C)、上覆 45 MPa。生产端仍用单元定压 BC（20 MPa）。
-->
<Problem>
  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace name="FE1" order="1"/>
    </FiniteElements>
    <FiniteVolume>
      <TwoPointFluxApproximation name="fluidTPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <Mesh>
    <VTKMesh name="mesh1" file="../dpdkwellinjection/reservoir_4layer_refined.vtk"/>
    <VTKMesh name="mesh2" file="../dpdkwellinjection/reservoir_4layer_refined.vtk">
      <!--
        CO2 注入井，挂在裂缝网格 mesh2 上，沿 4 个储层段射孔到 fractureRegion。
        井头 z=10（网格顶 z=0 之上），perf 距井头 20/45/70/95 m => z=-10/-35/-60/-85，均落在储层(0~-100)内。
        平面位置 x≈501,y≈751，与基准 injectorBox 同一加密单元附近。
      -->
      <InternalWell
        name="co2Injector"
        wellRegionName="injectorWellRegion"
        wellControlsName="injControls"
        polylineNodeCoords="{ { 501.0, 751.0, 10.0 },
                              { 501.0, 751.0, -110.0 } }"
        polylineSegmentConn="{ { 0, 1 } }"
        radius="0.1"
        numElementsPerSegment="4">
        <Perforation name="injector_layer1_perf" targetRegion="fractureRegion" distanceFromHead="20.0"/>
        <Perforation name="injector_layer2_perf" targetRegion="fractureRegion" distanceFromHead="45.0"/>
        <Perforation name="injector_layer3_perf" targetRegion="fractureRegion" distanceFromHead="70.0"/>
        <Perforation name="injector_layer4_perf" targetRegion="fractureRegion" distanceFromHead="95.0"/>
      </InternalWell>
    </VTKMesh>
  </Mesh>

  <Geometry>
    <Box name="injectorBox" xMin="{ 499.0, 749.0, -13.5 }" xMax="{ 513.5, 763.5, 1.0 }"/>
    <Box name="producerBox" xMin="{ 1499.0, 749.0, -13.5 }" xMax="{ 1513.5, 763.5, 1.0 }"/>
    <Box name="xneg" xMin="{ -1.0, -1.0, -110.0 }" xMax="{ 1.0, 1501.0, 10.0 }"/>
    <Box name="xpos" xMin="{ 1999.0, -1.0, -110.0 }" xMax="{ 2001.0, 1501.0, 10.0 }"/>
    <Box name="yneg" xMin="{ -1.0, -1.0, -110.0 }" xMax="{ 2001.0, 1.0, 10.0 }"/>
    <Box name="ypos" xMin="{ -1.0, 1499.0, -110.0 }" xMax="{ 2001.0, 1501.0, 10.0 }"/>
    <Box name="zneg" xMin="{ -1.0, -1.0, -101.0 }" xMax="{ 2001.0, 1501.0, -99.0 }"/>
    <Box name="zpos" xMin="{ -1.0, -1.0, -1.0 }" xMax="{ 2001.0, 1501.0, 1.0 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion
      name="matrixRegion"
      meshBody="mesh1"
      cellBlocks="{ hexahedra }"
      materialList="{ matrixRock, fluid, relperm }"/>
    <CellElementRegion
      name="fractureRegion"
      meshBody="mesh2"
      cellBlocks="{ hexahedra }"
      materialList="{ fractureRock, fluid, relperm }"/>
    <WellElementRegion
      name="injectorWellRegion"
      meshBody="mesh2"
      materialList="{ fluid }"/>
  </ElementRegions>

  <Constitutive>
    <CO2BrinePhillipsFluid
      name="fluid"
      phaseNames="{ gas, water }"
      componentNames="{ co2, water }"
      componentMolarWeight="{ 44e-3, 18e-3 }"
      phasePVTParaFiles="{ pvtgas.txt, pvtliquid.txt }"
      flashModelParaFile="co2flash.txt"/>

    <BrooksCoreyRelativePermeability
      name="relperm"
      phaseNames="{ gas, water }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 1.5, 1.5 }"
      phaseRelPermMaxValue="{ 0.9, 0.9 }"/>

    <ElasticIsotropic
      name="matrixSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="1.0e9"
      defaultShearModulus="0.6e9"/>
    <BiotPorosity
      name="matrixPorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.2"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="matrixPerm"
      permeabilityComponents="{ 1.0e-15, 1.0e-15, 1.0e-15 }"/>
    <PorousElasticIsotropic
      name="matrixRock"
      solidModelName="matrixSolid"
      porosityModelName="matrixPorosity"
      permeabilityModelName="matrixPerm"/>

    <ElasticIsotropic
      name="fractureSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="2.0e8"
      defaultShearModulus="1.2e8"/>
    <BiotPorosity
      name="fracturePorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.9"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="fracturePerm"
      permeabilityComponents="{ 1.0e-12, 1.0e-12, 1.0e-12 }"/>
    <PorousElasticIsotropic
      name="fractureRock"
      solidModelName="fractureSolid"
      porosityModelName="fracturePorosity"
      permeabilityModelName="fracturePerm"/>
  </Constitutive>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <CompositionalMultiphaseFVM
      name="matrixFlow"
      logLevel="1"
      discretization="fluidTPFA"
      temperature="348.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh1/matrixRegion }">
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters krylovTol="1.0e-10" solverType="gmres"/>
    </CompositionalMultiphaseFVM>

    <CompositionalMultiphaseFVM
      name="fractureFlow"
      logLevel="1"
      discretization="fluidTPFA"
      temperature="348.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh2/fractureRegion }">
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters krylovTol="1.0e-10" solverType="gmres"/>
    </CompositionalMultiphaseFVM>

    <SolidMechanicsLagrangianFEM
      name="solidMech"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ mesh1/matrixRegion }"
      timeIntegrationOption="QuasiStatic"/>

    <CompositionalMultiPhaseDualContinuumFVM
      name="dualFlow"
      logLevel="1"
      flowSolverName="matrixFlow"
      flowSolverName1="fractureFlow"
      matrixRegionList="{ matrixRegion }"
      fractureRegionList="{ fractureRegion }"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }">
      <DualContinuumCrossFlow
        fractureSpacingLx="50.0"
        fractureSpacingLy="50.0"
        fractureSpacingLz="25.0"
        fractureVolumeFraction="0.1"
        matrixRegionList="{ matrixRegion }"
        fractureRegionList="{ fractureRegion }"/>
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters krylovTol="1.0e-10" solverType="gmres"/>
    </CompositionalMultiPhaseDualContinuumFVM>

    <!-- 注入井求解器：仅注入井（射孔到裂缝）。useMass 必须与流求解器一致(=0)。 -->
    <CompositionalMultiphaseWell
      name="wellSolver"
      logLevel="2"
      writeCSV="1"
      useMass="0"
      targetRegions="{ mesh2/injectorWellRegion }">
      <WellControls
        name="injControls"
        type="injector"
        control="totalVolRate"
        referenceElevation="0.0"
        statusTableName="wellOpenCloseSchedule"
        targetBHP="4.0e7"
        targetTotalRate="1.0"
        enableCrossflow="0"
        useSurfaceConditions="1"
        surfacePressure="1.0e6"
        surfaceTemperature="300.0"
        injectionTemperature="348.15"
        injectionStream="{ 1.0, 0.0 }"/>
      <NonlinearSolverParameters newtonTol="1.0e-5" newtonMinIter="1" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters krylovTol="1.0e-10" solverType="gmres"/>
    </CompositionalMultiphaseWell>

    <CompositionalMultiphaseDualContinuumPoromechanics
      name="poroSolver"
      logLevel="1"
      dualcontinuumSolverName="dualFlow"
      solidSolverName="solidMech"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }"
      fractureVolumeFraction="0.1"
      fimNewtonRelaxation="0.5"
      enableFractureMechanicsCoupling="1"
      enableFimCrossStorage="1"
      autoInitializeStress="0"
      stabilizationType="None"
      isThermal="0">
      <NonlinearSolverParameters
        couplingType="Sequential"
        newtonTol="5.0e-3"
        newtonMinIter="1"
        newtonMaxIter="60"
        lineSearchAction="None"
        maxSubSteps="1000"
        maxTimeStepCuts="8"
        timeStepCutFactor="0.5"/>
      <LinearSolverParameters krylovTol="1.0e-10" solverType="gmres"/>
    </CompositionalMultiphaseDualContinuumPoromechanics>

    <!-- 顶层 reservoir-well 迭代耦合器（Sequential）：把注入井挂到 dual poromechanics（井最终连到裂缝流）。 -->
    <CompositionalMultiphaseDualContinuumPoromechanicsReservoir
      name="poroWellSolver"
      logLevel="2"
      compositionalmultiphasedualcontinuumporomechanicsSolverName="poroSolver"
      wellSolverName="wellSolver"
      initialDt="0.1"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion, mesh2/injectorWellRegion }">
      <NonlinearSolverParameters
        couplingType="Sequential"
        sequentialConvergenceCriterion="SolutionIncrements"
        subcycling="0"
        newtonTol="5.0e-3"
        newtonMinIter="1"
        newtonMaxIter="20"
        lineSearchAction="None"
        maxSubSteps="1000"
        maxTimeStepCuts="8"
        timeStepCutFactor="0.5"/>
      <LinearSolverParameters krylovTol="1.0e-10" solverType="gmres"/>
    </CompositionalMultiphaseDualContinuumPoromechanicsReservoir>
  </Solvers>

  <FieldSpecifications>
    <!-- 储层初始孔压 ≈ 20 MPa（2km 静水）-->
    <FieldSpecification name="initPressureM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="20.0e6"/>
    <FieldSpecification name="initPressureF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="20.0e6"/>
    <FieldSpecification name="initCo2M" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>
    <FieldSpecification name="initCo2F" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>

    <!--
      ===== 2km 埋深初始有效应力（Sequential 口径，Φ=α_m·p=16 MPa）=====
      σ'_xx=σ'_yy = -37.5 + 16 = -21.5 MPa；σ'_zz = -45 + 16 = -29.0 MPa（component 0/1/2 = xx/yy/zz, Voigt, 压为负）。
      力学仅作用于基质 mesh1。
    -->
    <FieldSpecification name="init_sigma_xx" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="0" scale="-21.5e6"/>
    <FieldSpecification name="init_sigma_yy" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="1" scale="-21.5e6"/>
    <FieldSpecification name="init_sigma_zz" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="2" scale="-29.0e6"/>

    <!-- 顶面 overburden traction：S_v ≈ 45 MPa 竖直向下 => t_z=-45 MPa，与 σ'_zz 在 t=0 配平。 -->
    <Traction name="topTraction" objectPath="faceManager" targetMesh="mesh1" setNames="{ zpos }" tractionType="vector" direction="{ 0.0, 0.0, -1.0 }" scale="4.5e7"/>

    <!--
      生产端：单元定压 BC（20 MPa）泄流（注入抬压后由此处泄出）。注入改用井求解器，见 Solvers。
      ★objectPath 必须精确到流区，不能用 "ElementRegions"★：mesh2 上 ElementRegions 还含 WellElementRegion(injectorWellRegion)，
       后者没有 bcPressure 包装器，泛指会触发 "has no wrapper named bcPressure" 而中止。
    -->
    <FieldSpecification name="producerPressure1" setNames="{ producerBox }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="pressure" scale="20.0e6"/>
    <FieldSpecification name="producerPressure2" setNames="{ producerBox }" targetMesh="mesh2" objectPath="ElementRegions/fractureRegion" fieldName="pressure" scale="20.0e6"/>

    <!-- 力学边界：侧向 roller + 底面竖向固定。 -->
    <FieldSpecification name="xFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="0" scale="0.0" setNames="{ xneg,xpos }"/>
    <FieldSpecification name="yFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="1" scale="0.0" setNames="{ yneg,ypos }"/>
    <FieldSpecification name="znegFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="2" scale="0.0" setNames="{ zneg }"/>
  </FieldSpecifications>

  <Functions>
    <TableFunction
      name="wellOpenCloseSchedule"
      interpolation="lower"
      coordinates="{ 0.0, 630720000.0 }"
      values="{ 1.0, 1.0 }"/>
  </Functions>

  <Events maxTime="630720000.0">
    <PeriodicEvent name="outputs" timeFrequency="31536000.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="solverPhase0" beginTime="0.0"        endTime="1.0"         forceDt="0.1"      target="/Solvers/poroWellSolver"/>
    <PeriodicEvent name="solverPhase1" beginTime="1.0"        endTime="10.0"        forceDt="1.0"      target="/Solvers/poroWellSolver"/>
    <PeriodicEvent name="solverPhase2" beginTime="10.0"       endTime="100.0"       forceDt="10.0"     target="/Solvers/poroWellSolver"/>
    <PeriodicEvent name="solverPhase3" beginTime="100.0"      endTime="1000.0"      forceDt="100.0"    target="/Solvers/poroWellSolver"/>
    <PeriodicEvent name="solverPhase4" beginTime="1000.0"     endTime="86400.0"     forceDt="1000.0"   target="/Solvers/poroWellSolver"/>
    <PeriodicEvent name="solverPhase5" beginTime="86400.0"    endTime="31536000.0"  maxEventDt="86400.0"    target="/Solvers/poroWellSolver"/>
    <PeriodicEvent name="solverPhase6" beginTime="31536000.0" endTime="630720000.0" maxEventDt="31536000.0" target="/Solvers/poroWellSolver"/>
  </Events>

  <Outputs>
    <VTK name="vtkOutput"/>
  </Outputs>
</Problem>
