<?xml version="1.0" ?>

<Problem>
  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace name="FE1" order="1"/>
    </FiniteElements>
    <FiniteVolume>
      <TwoPointFluxApproximation name="fluidTPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 350.0, 450.0, 550.0, 650.0, 1350.0, 1450.0, 1550.0, 1650.0, 2000.0 }"
      yCoords="{ 0.0, 500.0, 675.0, 825.0, 1000.0, 1500.0 }"
      zCoords="{ -100.0, 0.0 }"
      nx="{ 7, 4, 8, 4, 14, 4, 8, 4, 7 }"
      ny="{ 10, 7, 12, 7, 10 }"
      nz="{ 8 }"
      cellBlockNames="{ matrixBlock }"/>
    <InternalMesh
      name="mesh2"
      elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 350.0, 450.0, 550.0, 650.0, 1350.0, 1450.0, 1550.0, 1650.0, 2000.0 }"
      yCoords="{ 0.0, 500.0, 675.0, 825.0, 1000.0, 1500.0 }"
      zCoords="{ -100.0, 0.0 }"
      nx="{ 7, 4, 8, 4, 14, 4, 8, 4, 7 }"
      ny="{ 10, 7, 12, 7, 10 }"
      nz="{ 8 }"
      cellBlockNames="{ fractureBlock }"/>
  </Mesh>

  <Geometry>
    <Box name="injectorBox" xMin="{ 450.0, 700.0, -101.0 }" xMax="{ 550.0, 800.0, 1.0 }"/>
    <Box name="producerBox" xMin="{ 1450.0, 700.0, -101.0 }" xMax="{ 1550.0, 800.0, 1.0 }"/>
    <Box name="xneg" xMin="{ -1.0, -1.0, -110.0 }" xMax="{ 1.0, 1501.0, 10.0 }"/>
    <Box name="xpos" xMin="{ 1999.0, -1.0, -110.0 }" xMax="{ 2001.0, 1501.0, 10.0 }"/>
    <Box name="yneg" xMin="{ -1.0, -1.0, -110.0 }" xMax="{ 2001.0, 1.0, 10.0 }"/>
    <Box name="ypos" xMin="{ -1.0, 1499.0, -110.0 }" xMax="{ 2001.0, 1501.0, 10.0 }"/>
    <Box name="zneg" xMin="{ -1.0, -1.0, -101.0 }" xMax="{ 2001.0, 1501.0, -99.0 }"/>
    <!-- <Box name="farField" xMin="{ 1800.0, -1.0, -110.0 }" xMax="{ 2001.0, 1501.0, 10.0 }"/> -->
  </Geometry>

  <ElementRegions>
    <CellElementRegion
      name="matrixRegion"
      meshBody="mesh1"
      cellBlocks="{ matrixBlock }"
      materialList="{ matrixRock, fluid, relperm }"/>
    <CellElementRegion
      name="fractureRegion"
      meshBody="mesh2"
      cellBlocks="{ fractureBlock }"
      materialList="{ fractureRock, fluid, relperm }"/>
  </ElementRegions>

  <Constitutive>
    <CO2BrinePhillipsFluid
      name="fluid"
      phaseNames="{ gas, water }"
      componentNames="{ co2, water }"
      componentMolarWeight="{ 44e-3, 18e-3 }"
      phasePVTParaFiles="{ pvtgas.txt, pvtliquid.txt }"
      flashModelParaFile="co2flash.txt"/>

    <BrooksCoreyRelativePermeability
      name="relperm"
      phaseNames="{ gas, water }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 1.5, 1.5 }"
      phaseRelPermMaxValue="{ 0.9, 0.9 }"/>

    <ElasticIsotropic
      name="matrixSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="1.0e9"
      defaultShearModulus="0.6e9"/>
    <BiotPorosity
      name="matrixPorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.1"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="matrixPerm"
      permeabilityComponents="{ 1.0e-18, 1.0e-18, 1.0e-18 }"/>
    <PorousElasticIsotropic
      name="matrixRock"
      solidModelName="matrixSolid"
      porosityModelName="matrixPorosity"
      permeabilityModelName="matrixPerm"/>

    <ElasticIsotropic
      name="fractureSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="2.0e8"
      defaultShearModulus="1.2e8"/>
    <BiotPorosity
      name="fracturePorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.5"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="fracturePerm"
      permeabilityComponents="{ 1.0e-13, 1.0e-13, 1.0e-13 }"/>
    <PorousElasticIsotropic
      name="fractureRock"
      solidModelName="fractureSolid"
      porosityModelName="fracturePorosity"
      permeabilityModelName="fracturePerm"/>
  </Constitutive>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <CompositionalMultiphaseFVM
      name="matrixFlow"
      logLevel="1"
      discretization="fluidTPFA"
      temperature="368.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh1/matrixRegion }">
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>

    <CompositionalMultiphaseFVM
      name="fractureFlow"
      logLevel="1"
      discretization="fluidTPFA"
      temperature="368.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh2/fractureRegion }">
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>

    <SolidMechanicsLagrangianFEM
      name="solidMech"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ mesh1/matrixRegion }"
      timeIntegrationOption="QuasiStatic"/>

    <CompositionalMultiPhaseDualContinuumFVM
      name="dualFlow"
      logLevel="1"
      flowSolverName="matrixFlow"
      flowSolverName1="fractureFlow"
      matrixRegionList="{ matrixRegion }"
      fractureRegionList="{ fractureRegion }"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }">
      <DualContinuumCrossFlow
        fractureSpacingLx="50.0"
        fractureSpacingLy="50.0"
        fractureSpacingLz="25.0"
        matrixRegionList="{ matrixRegion }"
        fractureRegionList="{ fractureRegion }"/>
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <!-- <LinearSolverParameters krylovTol="1.0e-10" solverType="gmres"/> -->
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiPhaseDualContinuumFVM>

    <CompositionalMultiphaseDualContinuumPoromechanics
      name="poroSolver"
      logLevel="1"
      dualcontinuumSolverName="dualFlow"
      solidSolverName="solidMech"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }"
      fractureVolumeFraction="0.1"
      fimNewtonRelaxation="0.5"
      enableFractureMechanicsCoupling="1"
      enableFimCrossStorage="1"
      stabilizationType="None"
      isThermal="0">
      <!-- Sequential coupling: the monolithic FullyImplicit Jacobian is
           singular/ill-conditioned on this strongly graded mesh (UMFPACK
           numeric failure / 1e10 Pa blow-up with gmres). Sequential solves the
           flow and mechanics blocks separately, both of which are well posed.
           Sequential requires lineSearchAction="None". -->
      <NonlinearSolverParameters
        couplingType="Sequential"
        newtonTol="5.0e-3"
        newtonMinIter="1"
        newtonMaxIter="60"
        lineSearchAction="None"
        maxSubSteps="1000"
        maxTimeStepCuts="8"
        timeStepCutFactor="0.5"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseDualContinuumPoromechanics>
  </Solvers>

  <FieldSpecifications>
    <FieldSpecification name="initPressureM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="1.0e6"/>
    <FieldSpecification name="initPressureF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="1.0e6"/>
    <FieldSpecification name="initCo2M" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>
    <FieldSpecification name="initCo2F" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>

    <!-- <FieldSpecification name="farPressureM" setNames="{ farField }" targetMesh="mesh1" objectPath="mesh1/Level0/ElementRegions/matrixRegion/hexahedra" fieldName="pressure" scale="1.0e6"/>
    <FieldSpecification name="farPressureF" setNames="{ farField }" targetMesh="mesh2" objectPath="mesh2/Level0/ElementRegions/fractureRegion/hexahedra" fieldName="pressure" scale="1.0e6"/>
    <FieldSpecification name="farCo2M" setNames="{ farField }" targetMesh="mesh1" objectPath="mesh1/Level0/ElementRegions/matrixRegion/hexahedra" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="farWaterM" setNames="{ farField }" targetMesh="mesh1" objectPath="mesh1/Level0/ElementRegions/matrixRegion/hexahedra" fieldName="globalCompFraction" component="1" scale="0.994"/>
    <FieldSpecification name="farCo2F" setNames="{ farField }" targetMesh="mesh2" objectPath="mesh2/Level0/ElementRegions/fractureRegion/hexahedra" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="farWaterF" setNames="{ farField }" targetMesh="mesh2" objectPath="mesh2/Level0/ElementRegions/fractureRegion/hexahedra" fieldName="globalCompFraction" component="1" scale="0.994"/> -->

    <FieldSpecification name="co2Injection1" setNames="{ injectorBox }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="1.2e6"/>
    <FieldSpecification name="co2Injection2" setNames="{ injectorBox }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="1.2e6"/>
    <FieldSpecification name="producerPressure1" setNames="{ producerBox }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="8e5"/>
    <FieldSpecification name="producerPressure2" setNames="{ producerBox }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="8e5"/>

    <!-- <SourceFlux name="co2Injection" targetMesh="mesh2" objectPath="ElementRegions" component="0" scale="-1.0e-4" setNames="{ injectorBox }"/> -->
    <!-- <FieldSpecification name="producerPressure" setNames="{ producerBox }" targetMesh="mesh2" objectPath="mesh2/Level0/ElementRegions/fractureRegion/hexahedra" fieldName="pressure" scale="9.9e5"/> -->

    <FieldSpecification name="xFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="0" scale="0.0" setNames="{ xneg,xpos }"/>
    <FieldSpecification name="yFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="1" scale="0.0" setNames="{ yneg,ypos }"/>
    <FieldSpecification name="znegFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="2" scale="0.0" setNames="{ zneg }"/>
  </FieldSpecifications>

  <Events maxTime="630720000.0">
    <PeriodicEvent name="outputs" timeFrequency="100.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="solverPhase0" beginTime="0.0" endTime="1.0" forceDt="0.1" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase1" beginTime="1.0" endTime="10.0" forceDt="1.0" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase2" beginTime="10.0" endTime="100.0" forceDt="10.0" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase3" beginTime="100.0" endTime="1000.0" forceDt="100.0" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase4" beginTime="1000.0" endTime="86400.0" forceDt="1000.0" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase5" beginTime="86400.0" endTime="31536000.0" maxEventDt="86400.0" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase6" beginTime="31536000.0" endTime="630720000.0" maxEventDt="31536000.0" target="/Solvers/poroSolver"/>
  </Events>

  <Outputs>
    <VTK name="vtkOutput"/>
  </Outputs>
</Problem>
