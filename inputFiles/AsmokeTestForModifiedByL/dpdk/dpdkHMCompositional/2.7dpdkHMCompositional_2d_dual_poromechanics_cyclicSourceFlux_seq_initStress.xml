<?xml version="1.0" ?>

<!--
  Sequential（固定应力 / 迭代）耦合版本 + 用户自定义初始应力。
  从 dpdkHMCompositional_2d_dual_poromechanics_cyclicSourceFlux.xml 派生：
    * couplingType FullyImplicit -> Sequential（外层 flow<->mechanics 固定应力迭代）。
    * 演示“迭代耦合下如何设置初始应力”：
        方式 A（本算例采用，autoInitializeStress="0"）：用 FieldSpecification 直接给基质固体
                模型 matrixSolid 写初始有效应力张量 matrixSolid_stress（Voigt 6 分量，
                component 0/1/2/3/4/5 = xx/yy/zz/yz/xz/xy；GEOS 约定压为负）。
                适合各向异性 / 地应力 / 加载初值。代码会探测到非零的用户初值并保留不覆盖。
        方式 B（备选，见下方注释）：autoInitializeStress="1"，求解器自动把基质有效应力初始化为
                σ'_0 = (α_m·p_m,0 + α_f·p_f,0)·I，使 t=0 总应力为 0、力学平衡。
                适合各向同性、无外载、只想与初始孔压平衡的场景，无需手写应力。
    本箱体六个面均为法向滚动约束（roller），故均匀初始有效应力在 t=0 自动满足平衡，可安全设任意均匀值。
    其余（CO2-brine 双重介质多相流、周期 SourceFlux 气/水交替注入、producer 定压）保持不变。
-->
<Problem>
  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace name="FE1" order="1"/>
    </FiniteElements>
    <FiniteVolume>
      <TwoPointFluxApproximation name="fluidTPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <Mesh>
    <InternalMesh
      name="mesh1"
      elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 10.0 }"
      yCoords="{ 0.0, 10.0 }"
      zCoords="{ 0.0, 1.0 }"
      nx="{ 10 }"
      ny="{ 10 }"
      nz="{ 1 }"
      cellBlockNames="{ matrixBlock }"/>
    <InternalMesh
      name="mesh2"
      elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 10.0 }"
      yCoords="{ 0.0, 10.0 }"
      zCoords="{ 0.0, 1.0 }"
      nx="{ 10 }"
      ny="{ 10 }"
      nz="{ 1 }"
      cellBlockNames="{ fractureBlock }"/>
  </Mesh>

  <Geometry>
    <Box name="source" xMin="{ -0.1, -0.1, -0.1 }" xMax="{ 1.1, 1.1, 1.1 }"/>
    <Box name="sink" xMin="{ 8.9, 8.9, -0.1 }" xMax="{ 10.1, 10.1, 1.1 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion
      name="matrixRegion"
      meshBody="mesh1"
      cellBlocks="{ matrixBlock }"
      materialList="{ matrixRock, fluid, relperm }"/>
    <CellElementRegion
      name="fractureRegion"
      meshBody="mesh2"
      cellBlocks="{ fractureBlock }"
      materialList="{ fractureRock, fluid, relperm }"/>
  </ElementRegions>

  <Constitutive>
    <CO2BrinePhillipsFluid
      name="fluid"
      phaseNames="{ gas, water }"
      componentNames="{ co2, water }"
      componentMolarWeight="{ 44e-3, 18e-3 }"
      phasePVTParaFiles="{ pvtgas.txt, pvtliquid.txt }"
      flashModelParaFile="co2flash.txt"/>

    <BrooksCoreyRelativePermeability
      name="relperm"
      phaseNames="{ gas, water }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 1.5, 1.5 }"
      phaseRelPermMaxValue="{ 0.9, 0.9 }"/>

    <ElasticIsotropic
      name="matrixSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="1.0e9"
      defaultShearModulus="0.6e9"/>
    <BiotPorosity
      name="matrixPorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.1"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="matrixPerm"
      permeabilityComponents="{ 1.0e-18, 1.0e-18, 1.0e-18 }"/>
    <PorousElasticIsotropic
      name="matrixRock"
      solidModelName="matrixSolid"
      porosityModelName="matrixPorosity"
      permeabilityModelName="matrixPerm"/>

    <ElasticIsotropic
      name="fractureSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="2.0e8"
      defaultShearModulus="1.2e8"/>
    <BiotPorosity
      name="fracturePorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.5"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="fracturePerm"
      permeabilityComponents="{ 1.0e-13, 1.0e-13, 1.0e-13 }"/>
    <PorousElasticIsotropic
      name="fractureRock"
      solidModelName="fractureSolid"
      porosityModelName="fracturePorosity"
      permeabilityModelName="fracturePerm"/>
  </Constitutive>

  <!--
    Cyclic injection via SourceFlux (mass/mole source term, NOT a Dirichlet BC).
    Period = 200 s : 0-100 s inject GAS (co2 component), 100-200 s inject WATER component,
    repeated 4 times up to maxTime = 800 s.
  -->
  <Functions>
    <TableFunction
      name="gasGate"
      inputVarNames="{ time }"
      interpolation="lower"
      coordinates="{ 0.0, 100.0, 200.0, 300.0, 400.0, 500.0, 600.0, 700.0, 800.0 }"
      values="{ 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0 }"/>
    <TableFunction
      name="waterGate"
      inputVarNames="{ time }"
      interpolation="lower"
      coordinates="{ 0.0, 100.0, 200.0, 300.0, 400.0, 500.0, 600.0, 700.0, 800.0 }"
      values="{ 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0 }"/>
  </Functions>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <CompositionalMultiphaseFVM
      name="matrixFlow"
      logLevel="0"
      discretization="fluidTPFA"
      temperature="368.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh1/matrixRegion }">
      <NonlinearSolverParameters newtonTol="1.0e-4" newtonMaxIter="100" lineSearchAction="None" maxTimeStepCuts="8"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>

    <CompositionalMultiphaseFVM
      name="fractureFlow"
      logLevel="0"
      discretization="fluidTPFA"
      temperature="368.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh2/fractureRegion }">
      <NonlinearSolverParameters newtonTol="1.0e-4" newtonMaxIter="100" lineSearchAction="None" maxTimeStepCuts="8"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>

    <SolidMechanicsLagrangianFEM
      name="solidMech"
      logLevel="0"
      discretization="FE1"
      targetRegions="{ mesh1/matrixRegion }"
      timeIntegrationOption="QuasiStatic"/>

    <CompositionalMultiPhaseDualContinuumFVM
      name="dualFlow"
      logLevel="0"
      flowSolverName="matrixFlow"
      flowSolverName1="fractureFlow"
      matrixRegionList="{ matrixRegion }"
      fractureRegionList="{ fractureRegion }"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }">
      <DualContinuumCrossFlow
        fractureSpacingLx="1.0"
        fractureSpacingLy="1.0"
        fractureSpacingLz="1.0"
        fractureVolumeFraction="0.1"
        matrixRegionList="{ matrixRegion }"
        fractureRegionList="{ fractureRegion }"/>
      <!-- Sequential 下 dualFlow 单独求解，多相 Newton 可能陷入 period-2 极限环；用线搜索打破。 -->
      <NonlinearSolverParameters newtonTol="1.0e-4" newtonMaxIter="40" lineSearchAction="Attempt"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiPhaseDualContinuumFVM>

    <!--
      Sequential（固定应力）顺序耦合：每个外迭代先解 dualFlow，再经复合压力解 solidMech，
      固定应力把平均应力增量反馈到孔隙度。fimNewtonRelaxation / enableFimCrossStorage 仅作用于
      FullyImplicit 路径，Sequential 下被忽略，故此处不设。
      autoInitializeStress="0"：因为下方 FieldSpecification 已手写 matrixSolid_stress 作为初始
      有效应力（方式 A）。即使设为 1，代码探测到非零用户初值也会保留不覆盖。
      若想改用自动平衡（方式 B），删除下方 init_sigma_* 三条，并把这里改成 autoInitializeStress="1"。
      couplingType=Sequential 时本求解器的 newtonMaxIter/newtonTol 控制外层 flow<->mechanics 迭代。
    -->
    <CompositionalMultiphaseDualContinuumPoromechanics
      name="poroSolver"
      logLevel="1"
      dualcontinuumSolverName="dualFlow"
      solidSolverName="solidMech"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }"
      fractureVolumeFraction="0.1"
      enableFractureMechanicsCoupling="1"
      autoInitializeStress="0"
      stabilizationType="None"
      isThermal="0">
      <NonlinearSolverParameters
        couplingType="Sequential"
        newtonTol="1.0e-6"
        newtonMaxIter="40"
        lineSearchAction="None"
        maxTimeStepCuts="10"
        timeStepCutFactor="0.5"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseDualContinuumPoromechanics>
  </Solvers>

  <FieldSpecifications>
    <FieldSpecification name="initPressureM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="1.0e6"/>
    <FieldSpecification name="initPressureF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="1.0e6"/>
    <FieldSpecification name="initCo2M" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.001"/>
    <FieldSpecification name="initWaterM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.999"/>
    <FieldSpecification name="initCo2F" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.001"/>
    <FieldSpecification name="initWaterF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.999"/>

    <!--
      ===== 初始应力（方式 A：用户自定义） =====
      写到基质固体模型 matrixSolid 的有效应力张量 matrixSolid_stress 上（力学核读取的就是它）。
      component: 0=σxx, 1=σyy, 2=σzz, 3=σyz, 4=σxz, 5=σxy（Voigt）。GEOS 约定：压缩为负。
      此处给一个各向异性地应力初值：水平 σxx=σyy=-2 MPa，竖向 σzz=-3 MPa（有效应力，压缩）。
      六面 roller 约束下均匀应力在 t=0 满足平衡，安全。改成各向同性只需三者相等。
      力学求解仅作用于基质（mesh1），故只需给 matrixSolid_stress，不需给裂缝。
    -->
    <FieldSpecification name="init_sigma_xx" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="0" scale="-2.0e6"/>
    <FieldSpecification name="init_sigma_yy" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="1" scale="-2.0e6"/>
    <FieldSpecification name="init_sigma_zz" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="2" scale="-3.0e6"/>

    <!--
      Injection well as SourceFlux source terms. scale < 0 => injection, gated to alternate gas/water.
    -->
    <SourceFlux name="injCo2M"   targetMesh="mesh1" objectPath="ElementRegions/matrixRegion"   setNames="{ source }" component="0" scale="-1.0e-2" functionName="gasGate"/>
    <SourceFlux name="injWaterM" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion"   setNames="{ source }" component="1" scale="-1.0e-2" functionName="waterGate"/>
    <SourceFlux name="injCo2F"   targetMesh="mesh2" objectPath="ElementRegions/fractureRegion" setNames="{ source }" component="0" scale="-1.0e-2" functionName="gasGate"/>
    <SourceFlux name="injWaterF" targetMesh="mesh2" objectPath="ElementRegions/fractureRegion" setNames="{ source }" component="1" scale="-1.0e-2" functionName="waterGate"/>

    <!-- Producer: keep the sink at constant (lower) pressure so injected fluid can drain out -->
    <FieldSpecification name="upperPressureM" setNames="{ sink }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="0.8e6"/>
    <FieldSpecification name="upperPressureF" setNames="{ sink }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="0.8e6"/>
    <FieldSpecification name="upperCo2M" setNames="{ sink }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.001"/>
    <FieldSpecification name="upperWaterM" setNames="{ sink }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.999"/>
    <FieldSpecification name="upperCo2F" setNames="{ sink }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.001"/>
    <FieldSpecification name="upperWaterF" setNames="{ sink }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.999"/>

    <FieldSpecification name="xFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="0" scale="0.0" setNames="{ xneg, xpos }"/>
    <FieldSpecification name="yFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="1" scale="0.0" setNames="{ yneg, ypos }"/>
    <FieldSpecification name="zFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="2" scale="0.0" setNames="{ zneg, zpos }"/>
  </FieldSpecifications>

  <Tasks>
    <SourceFluxStatistics name="fluxStatsM" flowSolverName="matrixFlow"   fluxNames="{ injCo2M, injWaterM }" logLevel="2" writeCSV="1"/>
    <SourceFluxStatistics name="fluxStatsF" flowSolverName="fractureFlow" fluxNames="{ injCo2F, injWaterF }" logLevel="2" writeCSV="1"/>
  </Tasks>

  <Events maxTime="800.0">
    <PeriodicEvent name="outputs" timeFrequency="20.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="statsM" timeFrequency="10.0" target="/Tasks/fluxStatsM"/>
    <PeriodicEvent name="statsF" timeFrequency="10.0" target="/Tasks/fluxStatsF"/>
    <PeriodicEvent name="solverRamp"  beginTime="0.0"  endTime="10.0"  forceDt="1.0"  target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverMain"  beginTime="10.0" endTime="800.0" forceDt="10.0" target="/Solvers/poroSolver"/>
  </Events>

  <Outputs>
    <VTK name="vtkOutput"/>
  </Outputs>
</Problem>
