<?xml version="1.0" ?>

<!--
  以 dpdkHMCompositional_4layer_refined_box_wells_seq_initStress_2km.xml 为蓝本，
  将网格替换为 reservoir_4layer_400x200_fault_wells.vtk（含断层 fault + 井加密的 4 层储层）。

  ★ 网格尺寸（与旧版 2000×1500×100 不同）：
      X ∈ [0, 400] m，Y ∈ [0, 200] m，Z ∈ [-150, 0] m（4 层，井位双向加密；近 y=0 强加密 = 断层带）。
  ★ 井位（按用户要求）：注入井 (x=100, y=0)、生产井 (x=300, y=0)，置于【最底层】单元。
      注意：用户给定 z=-160 低于本网格底面（z 最深 = -150），故落到最深一层单元（节点 z∈[-150,-140]，中心 z=-145）。
      已按 GEOS“单元 8 节点全部入 box 才入集”规则核验：每个 box 恰好选中 1 个底层单元。
        注入井目标单元：x∈{96,104}, y∈{0,1.216}, z∈{-150,-140}，中心 (100,0.6,-145)。
        生产井目标单元：x∈{296,304}, y∈{0,1.216}, z∈{-150,-140}，中心 (300,0.6,-145)。

   以下 2 km 埋深现场梯度自洽设定（与蓝本一致，重力关闭，用均匀初值 + 顶面 traction 表征上覆）
    孔压（静水, ρ_w=1000, g=9.81）          p   = 1000·9.81·2000 ≈ 19.6  -> 取 20 MPa
    竖向总应力（上覆, ρ_ob≈2300）           S_v = 2300·9.81·2000 ≈ 45.1  -> 取 45 MPa
    有效竖向（Terzaghi）                     σ'_v = S_v - p = 25 MPa
    水平总应力（K0=0.7）                     S_h = K0·σ'_v + p = 0.7·25 + 20 = 37.5 MPa
  换成 GEOS 存储的有效应力（σ' = σ_total + Φ_eff，压为负）：
    ★ Sequential 路径下力学感受的孔压耦合是【复合压力】，等效系数
      Φ_eff = α_eff_m·p_m + α_eff_f·p_f，且 α_eff_m + α_eff_f = α_m（当 α_m=α_f）。
      初始 p_m=p_f=20 时 Φ_eff = α_m·p = 0.8·20 = 16 MPa（退化成单孔隙，不是 32！）。
      见 swapToCompositePressure：α_m·p_eq = α_eff_m·p_m + α_eff_f·p_f。
    σ'_zz        = -45 + 16 = -29.0 MPa
    σ'_xx=σ'_yy  = -37.5 + 16 = -21.5 MPa
    顶面 overburden traction  t_z = σzz_total = -45 MPa
  校核：σzz_total = σ'_zz - Φ_eff = -29 - 16 = -45 = t_z ✓（顶面平衡，侧向 roller，t=0 无虚假变形/孔压跳升）。
  注：网格局部 z(0~-150) 只代表 150 m 储层段，概念上位于 2km 深；重力关闭故绝对 z 无关紧要。
-->
<Problem>
  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace name="FE1" order="1"/>
    </FiniteElements>
    <FiniteVolume>
      <TwoPointFluxApproximation name="fluidTPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <Mesh>
    <VTKMesh name="mesh1" file="reservoir_4layer_400x200_fault_wells.vtk"/>
    <VTKMesh name="mesh2" file="reservoir_4layer_400x200_fault_wells.vtk"/>
  </Mesh>

  <Geometry>
    <!--
      井 box 缩到正好一个底层单元（井位 x=100/300, y=0, 最深层 z∈[-150,-140]）。
      重要：GEOS 判定单元是否入集，要求该单元【全部 8 个节点】都落在 box 内（all_of(node ∈ nodeSet)），
      不是按单元中心！所以 box 必须把整个单元【包住】，又要排除相邻单元的外侧节点面。
        x: 含 96..104，排除邻列节点 88/112 -> [95,105]
        y: 含 0..1.216，排除上邻节点 1.256 -> [-1,1.23]（y=0 为域边界，可取负）
        z: 含 -150..-140，排除上层节点 -130 -> [-151,-139]
      已用 VTK 网格按“全节点在内”规则核验：每个 box 恰好选中 1 个单元。
    -->
    <Box name="injectorBox" xMin="{ 95.0,  -1.0, -131.0 }" xMax="{ 105.0, 11, -121.0 }"/>
    <Box name="producerBox" xMin="{ 295.0, -1.0, -131.0 }" xMax="{ 305.0, 11, -121.0 }"/>
    <Box name="xneg" xMin="{ -1.0,   -1.0,  -151.0 }" xMax="{ 1.0,   201.0, 1.0 }"/>
    <Box name="xpos" xMin="{ 399.0,  -1.0,  -151.0 }" xMax="{ 401.0, 201.0, 1.0 }"/>
    <Box name="yneg" xMin="{ -1.0,   -1.0,  -151.0 }" xMax="{ 401.0, 1.0,   1.0 }"/>
    <Box name="ypos" xMin="{ -1.0,   199.0, -151.0 }" xMax="{ 401.0, 201.0, 1.0 }"/>
    <Box name="zneg" xMin="{ -1.0,   -1.0,  -151.0 }" xMax="{ 401.0, 201.0, -149.0 }"/>
    <Box name="zpos" xMin="{ -1.0,   -1.0,  -1.0 }"   xMax="{ 401.0, 201.0, 1.0 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion
      name="matrixRegion"
      meshBody="mesh1"
      cellBlocks="{ hexahedra }"
      materialList="{ matrixRock, fluid, relperm }"/>
    <CellElementRegion
      name="fractureRegion"
      meshBody="mesh2"
      cellBlocks="{ hexahedra }"
      materialList="{ fractureRock, fluid, relperm }"/>
  </ElementRegions>

  <Constitutive>
    <CO2BrinePhillipsFluid
      name="fluid"
      phaseNames="{ gas, water }"
      componentNames="{ co2, water }"
      componentMolarWeight="{ 44e-3, 18e-3 }"
      phasePVTParaFiles="{ pvtgas.txt, pvtliquid.txt }"
      flashModelParaFile="co2flash.txt"/>

    <BrooksCoreyRelativePermeability
      name="relperm"
      phaseNames="{ gas, water }"
      phaseMinVolumeFraction="{ 0.0, 0.0 }"
      phaseRelPermExponent="{ 1.5, 1.5 }"
      phaseRelPermMaxValue="{ 0.9, 0.9 }"/>

    <ElasticIsotropic
      name="matrixSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="1.0e9"
      defaultShearModulus="0.6e9"/>
    <BiotPorosity
      name="matrixPorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.2"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="matrixPerm"
      permeabilityComponents="{ 1.0e-15, 1.0e-15, 1.0e-15 }"/>
    <PorousElasticIsotropic
      name="matrixRock"
      solidModelName="matrixSolid"
      porosityModelName="matrixPorosity"
      permeabilityModelName="matrixPerm"/>

    <ElasticIsotropic
      name="fractureSolid"
      defaultDensity="2650.0"
      defaultBulkModulus="2.0e8"
      defaultShearModulus="1.2e8"/>
    <BiotPorosity
      name="fracturePorosity"
      defaultGrainBulkModulus="1.0e10"
      defaultReferencePorosity="0.9"
      defaultBiotCoefficient="0.8"/>
    <ConstantPermeability
      name="fracturePerm"
      permeabilityComponents="{ 1.0e-12, 1.0e-12, 1.0e-12 }"/>
    <PorousElasticIsotropic
      name="fractureRock"
      solidModelName="fractureSolid"
      porosityModelName="fracturePorosity"
      permeabilityModelName="fracturePerm"/>
  </Constitutive>

  <!--
    循环注入门函数（WAG 式气水交替）：周期 2 年 = 注 CO2 1 年 + 注水 1 年，覆盖 maxTime=10 年。
    1 年 = 31536000 s。interpolation="lower" => 速率在年边界处阶跃切换，且与 solverPhase6 的 1 年步长对齐。
    gasGate=1 时注 CO2、注水关；waterGate=1 时注水、注 CO2 关。
  -->
  <Functions>
    <TableFunction
      name="gasGate"
      inputVarNames="{ time }"
      interpolation="lower"
      coordinates="{ 0.0, 31536000.0, 63072000.0, 94608000.0, 126144000.0, 157680000.0, 189216000.0, 220752000.0, 252288000.0, 283824000.0, 315360000.0, 346896000.0, 378432000.0, 409968000.0, 441504000.0, 473040000.0, 504576000.0, 536112000.0, 567648000.0, 599184000.0, 630720000.0 }"
      values="{ 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0 }"/>
    <TableFunction
      name="waterGate"
      inputVarNames="{ time }"
      interpolation="lower"
      coordinates="{ 0.0, 31536000.0, 63072000.0, 94608000.0, 126144000.0, 157680000.0, 189216000.0, 220752000.0, 252288000.0, 283824000.0, 315360000.0, 346896000.0, 378432000.0, 409968000.0, 441504000.0, 473040000.0, 504576000.0, 536112000.0, 567648000.0, 599184000.0, 630720000.0 }"
      values="{ 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0 }"/>
  </Functions>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <CompositionalMultiphaseFVM
      name="matrixFlow"
      logLevel="1"
      discretization="fluidTPFA"
      temperature="348.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh1/matrixRegion }">
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>

    <CompositionalMultiphaseFVM
      name="fractureFlow"
      logLevel="1"
      discretization="fluidTPFA"
      temperature="348.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh2/fractureRegion }">
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>

    <SolidMechanicsLagrangianFEM
      name="solidMech"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ mesh1/matrixRegion }"
      timeIntegrationOption="QuasiStatic"/>

    <CompositionalMultiPhaseDualContinuumFVM
      name="dualFlow"
      logLevel="1"
      flowSolverName="matrixFlow"
      flowSolverName1="fractureFlow"
      matrixRegionList="{ matrixRegion }"
      fractureRegionList="{ fractureRegion }"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }">
      <DualContinuumCrossFlow
        fractureSpacingLx="0.1"
        fractureSpacingLy="0.1"
        fractureSpacingLz="0.1"
        fractureVolumeFraction="0.1"
        matrixRegionList="{ matrixRegion }"
        fractureRegionList="{ fractureRegion }"/>
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiPhaseDualContinuumFVM>

    <CompositionalMultiphaseDualContinuumPoromechanics
      name="poroSolver"
      logLevel="1"
      dualcontinuumSolverName="dualFlow"
      solidSolverName="solidMech"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }"
      fractureVolumeFraction="0.1"
      fimNewtonRelaxation="0.5"
      enableFractureMechanicsCoupling="1"
      enableFimCrossStorage="1"
      autoInitializeStress="0"
      stabilizationType="None"
      isThermal="0">
      <NonlinearSolverParameters
        couplingType="Sequential"
        newtonTol="5.0e-3"
        newtonMinIter="1"
        newtonMaxIter="60"
        lineSearchAction="None"
        maxSubSteps="1000"
        maxTimeStepCuts="8"
        timeStepCutFactor="0.5"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseDualContinuumPoromechanics>
  </Solvers>

  <FieldSpecifications>
    <!-- 储层初始孔压 ≈ 20 MPa（2km 静水）-->
    <FieldSpecification name="initPressureM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="20.0e6"/>
    <FieldSpecification name="initPressureF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="20.0e6"/>
    <FieldSpecification name="initCo2M" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>
    <FieldSpecification name="initCo2F" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterF" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>

    <!--
      ===== 2km 埋深初始有效应力（写到 matrixSolid 应力张量；component 0/1/2 = xx/yy/zz，Voigt；压为负）=====
      ★ Sequential 的有效孔压耦合 Φ_eff = α_m·p = 0.8·20 = 16 MPa（复合压力，见 swapToCompositePressure），
        即 σ' = σ_total + 16 MPa：
      σ'_zz       = -45 + 16 = -29.0 MPa（竖向，配平顶面 45MPa overburden）
      σ'_xx=σ'_yy = -37.5 + 16 = -21.5 MPa（水平，K0=0.7 推得 S_h=37.5MPa）
      力学仅作用于基质 mesh1，故只写 matrixSolid_stress；裂缝无需。
    -->
    <FieldSpecification name="init_sigma_xx" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="0" scale="-21.5e6"/>
    <FieldSpecification name="init_sigma_yy" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="1" scale="-21.5e6"/>
    <FieldSpecification name="init_sigma_zz" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/matrixRegion" fieldName="matrixSolid_stress" component="2" scale="-29.0e6"/>

    <!--
      ===== 顶面 overburden traction =====
      2km 上覆 S_v ≈ 45 MPa，竖直向下：direction={0,0,-1}, scale=4.5e7 => t_z=-45 MPa。
      与 σ'_zz 在 t=0 配平（σzz_total = σ'_zz - Φ = -45 = t_z）。
    -->
    <Traction name="topTraction" objectPath="faceManager" targetMesh="mesh1" setNames="{ zpos }" tractionType="vector" direction="{ 0.0, 0.0, -1.0 }" scale="4.5e7"/>

    <!--
      ===== 注入井（SourceFlux）=====
      注入到裂缝连续介质（mesh2/fractureRegion，渗透率 1e-12 ≈ 1 Darcy）；基质（1e-15 ≈ 1 mD）经 cross-flow 被波及。
      井位 (x=100, y=0) 最底层单元。useMass="0" => scale 单位 mol/s；scale<0 注入。
    -->
    <SourceFlux name="injCo2F"   targetMesh="mesh2" objectPath="ElementRegions/fractureRegion" setNames="{ injectorBox }" component="0" scale="-200.0" />
    <SourceFlux name="injWaterF" targetMesh="mesh2" objectPath="ElementRegions/fractureRegion" setNames="{ injectorBox }" component="1" scale="0.0"/>

    <!-- 生产井 (x=300, y=0) 最底层单元：单元定压（BHP 20 MPa）泄流 -->
    <FieldSpecification name="producerPressure1" setNames="{ producerBox }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" scale="20.0e6"/>
    <FieldSpecification name="producerPressure2" setNames="{ producerBox }" targetMesh="mesh2" objectPath="ElementRegions" fieldName="pressure" scale="20.0e6"/>

    <FieldSpecification name="xFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="0" scale="0.0" setNames="{ xneg,xpos }"/>
    <FieldSpecification name="yFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="1" scale="0.0" setNames="{ yneg,ypos }"/>
    <FieldSpecification name="znegFix" objectPath="nodeManager" targetMesh="mesh1" fieldName="totalDisplacement" component="2" scale="0.0" setNames="{ zneg }"/>
  </FieldSpecifications>


      <!-- 10 年 -->
  <Events maxTime="315360000.0">
    <PeriodicEvent name="outputs" timeFrequency="15768000.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="solverPhase0" beginTime="0.0" endTime="1.0" forceDt="0.1" target="/Solvers/poroSolver"/>
    <PeriodicEvent name="solverPhase6" beginTime="1.0" endTime="315360000.0" maxEventDt="31536000.0" target="/Solvers/poroSolver"/>
  </Events>

  <Outputs>
    <VTK name="vtkOutput"/>
  </Outputs>
</Problem>
