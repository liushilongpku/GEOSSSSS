<?xml version="1.0" ?>

<!--
  ★★ 4.8 = 在 4.4/4.7 基础上，把【初始孔压】与【初始有效应力】由均匀常数改为【随深度变化的重力梯度】★★

  以前各算例的初始 p / σ' 在整个域内取单一常数（2km 参考值：p=20MPa，σ'_zz=-29，σ'_xx=σ'_yy=-21.5MPa）。
  4.8 改为随深度 z 线性变化（域 z∈[-150,0]，z=0 为顶面取上述 2km 参考值，向下叠加重力梯度）：
    · 孔压（静水）：dp/d(深度)=ρ_w·g=9810 Pa/m  ⇒ p(-150)=21.4715MPa；
    · 竖向总应力 S_v 梯度=22500 Pa/m（≈ρ_bulk·g，与 45MPa 上覆一致）；σ'_zz=-(S_v-α·p)，α=0.8
      ⇒ σ'_zz(-150)=-31.198MPa；
    · 水平有效应力 σ'_xx=σ'_yy=K0·σ'_zz，K0=21.5/29 ⇒ σ'_xx(-150)=-23.130MPa。
  实现方式：FieldSpecification 用 functionName 引用 <Functions> 中的 TableFunction(initPressure/sigma_v/sigma_h)，
  inputVarNames=elementCenter，x/y 为单点退化轴，仅随 z 线性插值（表数据见 gravity_tables_4.8/）。
  其余（部分双重介质 + 重力驱替 GDP + 时间步策略）完全继承 4.4/4.7。

  === 以下文字说明继承自 4.4 ===
  ★★ 4.4 = 在 4.3【部分双重介质 + 重力】基础上，开启【重力驱替 (gravity drainage)】功能 ★★

  4.3 已打开整体重力场 gravityVector={0,0,-9.81}，但【裂缝↔基质 cross-flow】中并未启用
  Kazemi 重力驱替项 —— 因为双重介质里基质单元与裂缝单元【共位】(同一 gravCoef)，常规重力水头
  densMean·(gravCoef_m - gravCoef_f) 恒为 0，基质↔裂缝间没有任何重力驱动。

  4.4 打开 gravityDrainageFlag="1"，引入 Kazemi 重力驱替压力 (GDP)：
      GDP = g·(ρ_f - ρ_m)·Lz/2   (有符号；= |g|·(ρ_m - ρ_f)·Lz/2)
      作为附加压力加到【基质侧】势 (见 PotGrad)。ρ_m/ρ_f 为基质/裂缝【总密度】。
      · 基质流体更重 (ρ_m>ρ_f) ⇒ GDP>0 ⇒ 重的基质流体向裂缝排泄、轻的裂缝流体向基质渗吸
        (即 CO2 富集裂缝变轻后，重力驱动 CO2 向基质侵入)——常规重力驱替方向；
      · 密度反差反向时 GDP 随之反向 (修正前 std::abs 会把方向永久钉死，已修复)。

  本算例仅在 4.3 之上做了三处改动 (其余完全继承 4.3)：
    (1) <DualContinuumCrossFlow ... gravityDrainageFlag="1">          —— 开启重力驱替；
    (2) <Constitutive> 新增 <SimpleGravityDrainagePressure name="gravityDrainagePressure"/>；
    (3) 5 个基质 region 的 materialList 追加 gravityDrainagePressure (cross-flow 内核仅读取
        基质侧 GDP；为避免 StencilMaterialAccessors 在某些基质体缺材料而出错，5 体全部加上)。

  注：fractureSpacingLz=0.1 m (沿用 4.3)，GDP 量级 ≈ |g|·Δρ·Lz/2 ≈ 9.81·O(100)·0.05 ≈ O(10²) Pa，
      相对 20 MPa 孔压偏小，重力驱替主要体现为 CO2 在基质/裂缝间的缓慢重力再分配；
      如需放大效果可增大 fractureSpacingLz (代表更大的基质块高度)。

  === 以下文字说明继承自 4.3 ===
  4.3 = 测试【部分双重介质 (partial dual-continuum)】：仅【裂缝发育】的 reservoir + fault 为双重介质，
  aquifer / cap / basement 退化为单孔隙。网格 reservoir_4layer_400x200_fault_wells.vtk 的 5 个 Physical Volume：
        id 52 aquifer    z∈[-30,  0]
        id 53 cap        z∈[-50, -30]
        id 54 reservoir  z∈[-130,-50]
        id 55 basement   z∈[-150,-130]
        id 56 fault      z∈[-150,  0]
  2 km 埋深现场梯度：p=20 MPa；S_v=45 MPa；σ'_zz=-29.0；σ'_xx=σ'_yy=-21.5 MPa；顶面 t_z=-45 MPa。
-->
<Problem>
  <NumericalMethods>
    <FiniteElements>
      <FiniteElementSpace name="FE1" order="1"/>
    </FiniteElements>
    <FiniteVolume>
      <TwoPointFluxApproximation name="fluidTPFA"/>
    </FiniteVolume>
  </NumericalMethods>

  <Mesh>
    <VTKMesh name="mesh1" file="reservoir_4layer_400x200_fault_wells.vtk" regionAttribute="CellEntityIds"/>
    <VTKMesh name="mesh2" file="reservoir_4layer_400x200_fault_wells.vtk" regionAttribute="CellEntityIds"/>
  </Mesh>

  <Geometry>
    <!-- 井 box 各选中 1 个 reservoir(id54) 单元（井位 x=100/300, 近 y=0, z≈-126）。已按“全节点入 box”规则核验。-->
    <Box name="injectorBox" xMin="{ 95.0,  -1.0, -131.0 }" xMax="{ 105.0, 11.0, -121.0 }"/>
    <Box name="producerBox" xMin="{ 295.0, -1.0, -131.0 }" xMax="{ 305.0, 11.0, -121.0 }"/>
    <Box name="xneg" xMin="{ -1.0,   -1.0,  -151.0 }" xMax="{ 1.0,   201.0, 1.0 }"/>
    <Box name="xpos" xMin="{ 399.0,  -1.0,  -151.0 }" xMax="{ 401.0, 201.0, 1.0 }"/>
    <Box name="yneg" xMin="{ -1.0,   -1.0,  -151.0 }" xMax="{ 401.0, 1.0,   1.0 }"/>
    <Box name="ypos" xMin="{ -1.0,   199.0, -151.0 }" xMax="{ 401.0, 201.0, 1.0 }"/>
    <Box name="zneg" xMin="{ -1.0,   -1.0,  -151.0 }" xMax="{ 401.0, 201.0, -149.0 }"/>
    <Box name="zpos" xMin="{ -1.0,   -1.0,  -1.0 }"   xMax="{ 401.0, 201.0, 1.0 }"/>
  </Geometry>

  <ElementRegions>
    <!-- ===== 基质连续介质（mesh1），按 id 切 5 块。materialList 追加 gravityDrainagePressure（重力驱替）===== -->
    <CellElementRegion name="aquiferM"   meshBody="mesh1" cellBlocks="{ 52_hexahedra }" materialList="{ aquifer_mRock,   fluid, relperm, gravityDrainagePressure }"/>
    <CellElementRegion name="capM"       meshBody="mesh1" cellBlocks="{ 53_hexahedra }" materialList="{ cap_mRock,       fluid, relperm, gravityDrainagePressure }"/>
    <CellElementRegion name="reservoirM" meshBody="mesh1" cellBlocks="{ 54_hexahedra }" materialList="{ reservoir_mRock, fluid, relperm, gravityDrainagePressure }"/>
    <CellElementRegion name="basementM"  meshBody="mesh1" cellBlocks="{ 55_hexahedra }" materialList="{ basement_mRock,  fluid, relperm, gravityDrainagePressure }"/>
    <CellElementRegion name="faultM"     meshBody="mesh1" cellBlocks="{ 56_hexahedra }" materialList="{ fault_mRock,     fluid, relperm, gravityDrainagePressure }"/>
    <!-- ===== 裂缝连续介质（mesh2）：仅 reservoir + fault 建裂缝 region（部分双重介质）===== -->
    <CellElementRegion name="reservoirF" meshBody="mesh2" cellBlocks="{ 54_hexahedra }" materialList="{ reservoir_fRock, fluid, relperm }"/>
    <!-- <CellElementRegion name="faultF"     meshBody="mesh2" cellBlocks="{ 56_hexahedra }" materialList="{ fault_fRock,     fluid, relperm }"/> -->
    <!-- 惰性 region：满足 mesh2 网格完整性，不参与任何 solver。 -->
    <CellElementRegion name="inactiveF"  meshBody="mesh2" cellBlocks="{ 52_hexahedra, 53_hexahedra, 55_hexahedra, 56_hexahedra }" materialList="{ reservoir_fRock }"/>
  </ElementRegions>

  <Constitutive>
    <!-- ★ 重力驱替压力本构（Kazemi GDP），由 dualFlow 在 gravityDrainageFlag=1 时每步更新。 -->
    <SimpleGravityDrainagePressure name="gravityDrainagePressure"/>

    <CO2BrinePhillipsFluid
      name="fluid"
      phaseNames="{ gas, water }"
      componentNames="{ co2, water }"
      componentMolarWeight="{ 44e-3, 18e-3 }"
      phasePVTParaFiles="{ pvtgas.txt, pvtliquid.txt }"
      flashModelParaFile="co2flash.txt"/>

    <BrooksCoreyRelativePermeability
      name="relperm"
      phaseNames="{ gas, water }"
      phaseMinVolumeFraction="{ 0.05, 0.3 }"
      phaseRelPermExponent="{ 1.5, 1.5 }"
      phaseRelPermMaxValue="{ 0.9, 0.9 }"/>

    <!-- ================= 基质 (matrix) 各地质体 ================= -->
    <!-- aquifer -->
    <ElasticIsotropic name="aquifer_mSolid" defaultDensity="2650.0" defaultBulkModulus="2.0e9" defaultShearModulus="1.2e9"/>
    <BiotPorosity     name="aquifer_mPoro"  defaultGrainBulkModulus="4.0e10" defaultReferencePorosity="0.25" defaultBiotCoefficient="0.8"/>
    <ConstantPermeability name="aquifer_mPerm" permeabilityComponents="{ 1.0e-15, 1.0e-15, 1.0e-15 }"/>
    <PorousElasticIsotropic name="aquifer_mRock" solidModelName="aquifer_mSolid" porosityModelName="aquifer_mPoro" permeabilityModelName="aquifer_mPerm"/>
    <!-- cap (seal) -->
    <ElasticIsotropic name="cap_mSolid" defaultDensity="2650.0" defaultBulkModulus="5.0e9" defaultShearModulus="3.0e9"/>
    <BiotPorosity     name="cap_mPoro"  defaultGrainBulkModulus="4.0e10" defaultReferencePorosity="0.08" defaultBiotCoefficient="0.8"/>
    <ConstantPermeability name="cap_mPerm" permeabilityComponents="{ 1.0e-17, 1.0e-17, 1.0e-17 }"/>
    <PorousElasticIsotropic name="cap_mRock" solidModelName="cap_mSolid" porosityModelName="cap_mPoro" permeabilityModelName="cap_mPerm"/>
    <!-- reservoir (storage target) -->
    <ElasticIsotropic name="reservoir_mSolid" defaultDensity="2650.0" defaultBulkModulus="1.0e9" defaultShearModulus="0.6e9"/>
    <BiotPorosity     name="reservoir_mPoro"  defaultGrainBulkModulus="4.0e10" defaultReferencePorosity="0.22" defaultBiotCoefficient="0.8"/>
    <ConstantPermeability name="reservoir_mPerm" permeabilityComponents="{ 5.0e-15, 5.0e-15, 5.0e-15 }"/>
    <PorousElasticIsotropic name="reservoir_mRock" solidModelName="reservoir_mSolid" porosityModelName="reservoir_mPoro" permeabilityModelName="reservoir_mPerm"/>
    <!-- basement (stiff crystalline) -->
    <ElasticIsotropic name="basement_mSolid" defaultDensity="2650.0" defaultBulkModulus="2.0e10" defaultShearModulus="1.2e10"/>
    <BiotPorosity     name="basement_mPoro"  defaultGrainBulkModulus="4.0e10" defaultReferencePorosity="0.08" defaultBiotCoefficient="0.8"/>
    <ConstantPermeability name="basement_mPerm" permeabilityComponents="{ 1.0e-17, 1.0e-17, 1.0e-17 }"/>
    <PorousElasticIsotropic name="basement_mRock" solidModelName="basement_mSolid" porosityModelName="basement_mPoro" permeabilityModelName="basement_mPerm"/>
    <!-- fault (damage zone: softer, more permeable matrix) -->
    <ElasticIsotropic name="fault_mSolid" defaultDensity="2650.0" defaultBulkModulus="0.5e9" defaultShearModulus="0.3e9"/>
    <BiotPorosity     name="fault_mPoro"  defaultGrainBulkModulus="4.0e10" defaultReferencePorosity="0.15" defaultBiotCoefficient="0.8"/>
    <ConstantPermeability name="fault_mPerm" permeabilityComponents="{ 1.0e-17, 1.0e-17, 1.0e-17 }"/>
    <PorousElasticIsotropic name="fault_mRock" solidModelName="fault_mSolid" porosityModelName="fault_mPoro" permeabilityModelName="fault_mPerm"/>

    <!-- ================= 裂缝 (fracture) 连续介质：仅 reservoir + fault ================= -->
    <!-- reservoir -->
    <ElasticIsotropic name="reservoir_fSolid" defaultDensity="2650.0" defaultBulkModulus="2.0e8" defaultShearModulus="1.2e8"/>
    <BiotPorosity     name="reservoir_fPoro"  defaultGrainBulkModulus="4.0e10" defaultReferencePorosity="0.90" defaultBiotCoefficient="0.8"/>
    <ConstantPermeability name="reservoir_fPerm" permeabilityComponents="{ 1.0e-13, 1.0e-13, 1.0e-13 }"/>
    <PorousElasticIsotropic name="reservoir_fRock" solidModelName="reservoir_fSolid" porosityModelName="reservoir_fPoro" permeabilityModelName="reservoir_fPerm"/>
    <!-- fault (high-perm conduit) -->
    <!-- <ElasticIsotropic name="fault_fSolid" defaultDensity="2650.0" defaultBulkModulus="1.0e8" defaultShearModulus="0.6e8"/>
    <BiotPorosity     name="fault_fPoro"  defaultGrainBulkModulus="4.0e10" defaultReferencePorosity="0.95" defaultBiotCoefficient="0.8"/>
    <ConstantPermeability name="fault_fPerm" permeabilityComponents="{ 1.0e-11, 1.0e-11, 1.0e-11 }"/>
    <PorousElasticIsotropic name="fault_fRock" solidModelName="fault_fSolid" porosityModelName="fault_fPoro" permeabilityModelName="fault_fPerm"/> -->
  </Constitutive>

  <Solvers gravityVector="{ 0.0, 0.0, -9.81 }">
    <CompositionalMultiphaseFVM
      name="matrixFlow"
      logLevel="1"
      discretization="fluidTPFA"
      temperature="348.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh1/aquiferM, mesh1/capM, mesh1/reservoirM, mesh1/basementM, mesh1/faultM }">
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters solverType="gmres" preconditionerType="iluk" krylovTol="1.0e-6" krylovMaxIter="1000" krylovAdaptiveTol="1"/>
    </CompositionalMultiphaseFVM>

    <CompositionalMultiphaseFVM
      name="fractureFlow"
      logLevel="1"
      discretization="fluidTPFA"
      temperature="348.15"
      useMass="0"
      maxCompFractionChange="0.5"
      targetRegions="{ mesh2/reservoirF }">
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters solverType="gmres" preconditionerType="iluk" krylovTol="1.0e-6" krylovMaxIter="1000" krylovAdaptiveTol="1"/>
    </CompositionalMultiphaseFVM>

    <SolidMechanicsLagrangianFEM
      name="solidMech"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ mesh1/aquiferM, mesh1/capM, mesh1/reservoirM, mesh1/basementM, mesh1/faultM }"
      timeIntegrationOption="QuasiStatic">
      <LinearSolverParameters solverType="gmres" preconditionerType="amg" krylovTol="1.0e-6" krylovMaxIter="1000" krylovAdaptiveTol="1"/>
    </SolidMechanicsLagrangianFEM>

    <CompositionalMultiPhaseDualContinuumFVM
      name="dualFlow"
      logLevel="1"
      flowSolverName="matrixFlow"
      flowSolverName1="fractureFlow"
      matrixRegionList="{ reservoirM }"
      fractureRegionList="{ reservoirF }"
      targetRegions="{ mesh1/aquiferM, mesh1/capM, mesh1/reservoirM, mesh1/basementM, mesh1/faultM,
                       mesh2/reservoirF }">
      <DualContinuumCrossFlow
        fractureSpacingLx="0.1"
        fractureSpacingLy="0.1"
        fractureSpacingLz="0.1"
        fractureVolumeFraction="0.1"
        gravityDrainageFlag="1"
        matrixRegionList="{ reservoirM }"
        fractureRegionList="{ reservoirF }"/>
      <NonlinearSolverParameters newtonTol="5.0e-3" newtonMinIter="0" newtonMaxIter="40" lineSearchAction="None"/>
      <LinearSolverParameters solverType="gmres" preconditionerType="iluk" iluFill="2" krylovTol="1.0e-6" krylovMaxIter="1000" krylovAdaptiveTol="1"/>
    </CompositionalMultiPhaseDualContinuumFVM>

    <CompositionalMultiphaseDualContinuumPoromechanics
      name="poroSolver"
      logLevel="1"
      dualcontinuumSolverName="dualFlow"
      solidSolverName="solidMech"
      targetRegions="{ mesh1/aquiferM, mesh1/capM, mesh1/reservoirM, mesh1/basementM, mesh1/faultM,
                       mesh2/reservoirF }"
      fractureVolumeFraction="0.1"
      fimNewtonRelaxation="0.5"
      enableFractureMechanicsCoupling="1"
      enableFimCrossStorage="1"
      autoInitializeStress="0"
      stabilizationType="None"
      isThermal="0">
      <NonlinearSolverParameters
        couplingType="Sequential"
        newtonTol="5.0e-3"
        newtonMinIter="1"
        newtonMaxIter="60"
        lineSearchAction="None"
        maxSubSteps="1000"
        maxTimeStepCuts="8"
        timeStepCutFactor="0.5"/>
      <LinearSolverParameters solverType="gmres" preconditionerType="iluk" krylovTol="1.0e-6" krylovMaxIter="1000" krylovAdaptiveTol="1"/>
    </CompositionalMultiphaseDualContinuumPoromechanics>
  </Solvers>

  <FieldSpecifications>
    <!-- ===== 初始孔压：随深度的静水梯度 p(z)=20MPa - ρ_w·g·z（ρ_w·g=9810 Pa/m），由 TableFunction initPressure 给出 ===== -->
    <FieldSpecification name="initPressureM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="pressure" functionName="initPressure" scale="1.0"/>
    <FieldSpecification name="initPressureF_res" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions/reservoirF" fieldName="pressure" functionName="initPressure" scale="1.0"/>
    <FieldSpecification name="initCo2M"   initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterM" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions" fieldName="globalCompFraction" component="1" scale="0.994"/>
    <FieldSpecification name="initCo2F_res"   initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions/reservoirF" fieldName="globalCompFraction" component="0" scale="0.006"/>
    <FieldSpecification name="initWaterF_res" initialCondition="1" setNames="{ all }" targetMesh="mesh2" objectPath="ElementRegions/reservoirF" fieldName="globalCompFraction" component="1" scale="0.994"/>

    <!-- ===== 初始有效应力：随深度的重力梯度（Voigt，压为负）=====
         σ'_zz(z) = -(S_v - α·p)，S_v 梯度 22500 Pa/m（≈ρ_bulk·g，与 45MPa 上覆一致），α=0.8：z=0 → -29.0MPa；z=-150 → -31.198MPa（函数 sigma_v）。
         σ'_xx=σ'_yy = K0·σ'_zz，K0=21.5/29：z=0 → -21.5MPa；z=-150 → -23.130MPa（函数 sigma_h）。
         5 个基质 region 共用同一深度剖面，scale=1.0。 -->
    <FieldSpecification name="aq_sxx"  initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/aquiferM"   fieldName="aquifer_mSolid_stress"   component="0" functionName="sigma_h" scale="1.0"/>
    <FieldSpecification name="aq_syy"  initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/aquiferM"   fieldName="aquifer_mSolid_stress"   component="1" functionName="sigma_h" scale="1.0"/>
    <FieldSpecification name="aq_szz"  initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/aquiferM"   fieldName="aquifer_mSolid_stress"   component="2" functionName="sigma_v" scale="1.0"/>
    <FieldSpecification name="cap_sxx" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/capM"       fieldName="cap_mSolid_stress"       component="0" functionName="sigma_h" scale="1.0"/>
    <FieldSpecification name="cap_syy" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/capM"       fieldName="cap_mSolid_stress"       component="1" functionName="sigma_h" scale="1.0"/>
    <FieldSpecification name="cap_szz" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/capM"       fieldName="cap_mSolid_stress"       component="2" functionName="sigma_v" scale="1.0"/>
    <FieldSpecification name="res_sxx" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/reservoirM" fieldName="reservoir_mSolid_stress" component="0" functionName="sigma_h" scale="1.0"/>
    <FieldSpecification name="res_syy" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/reservoirM" fieldName="reservoir_mSolid_stress" component="1" functionName="sigma_h" scale="1.0"/>
    <FieldSpecification name="res_szz" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/reservoirM" fieldName="reservoir_mSolid_stress" component="2" functionName="sigma_v" scale="1.0"/>
    <FieldSpecification name="bas_sxx" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/basementM"  fieldName="basement_mSolid_stress"  component="0" functionName="sigma_h" scale="1.0"/>
    <FieldSpecification name="bas_syy" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/basementM"  fieldName="basement_mSolid_stress"  component="1" functionName="sigma_h" scale="1.0"/>
    <FieldSpecification name="bas_szz" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/basementM"  fieldName="basement_mSolid_stress"  component="2" functionName="sigma_v" scale="1.0"/>
    <FieldSpecification name="flt_sxx" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/faultM"     fieldName="fault_mSolid_stress"     component="0" functionName="sigma_h" scale="1.0"/>
    <FieldSpecification name="flt_syy" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/faultM"     fieldName="fault_mSolid_stress"     component="1" functionName="sigma_h" scale="1.0"/>
    <FieldSpecification name="flt_szz" initialCondition="1" setNames="{ all }" targetMesh="mesh1" objectPath="ElementRegions/faultM"     fieldName="fault_mSolid_stress"     component="2" functionName="sigma_v" scale="1.0"/>

    <!-- 顶面 overburden traction：t_z=-45 MPa（2km 上覆） -->
    <Traction name="topTraction" objectPath="faceManager" targetMesh="mesh1" setNames="{ zpos }" tractionType="vector" direction="{ 0.0, 0.0, -1.0 }" scale="4.5e7"/>

    <!-- ===== WAG（水气交替注入）：每 3 个月（7.884e6 s）切换一次 =====
         CO2 与水注入裂缝 reservoir 体的同一注入井。useMass=0 => scale 单位 mol/s；<0 注入。
         scale 为各相【基准注入率】，functionName 引用时间方波（wagGas/wagWater）做 0/1 开关，
         二者互补 ⇒ 任一时刻仅一相在注。第 1 段（0–3 月）注 CO2，第 2 段（3–6 月）注水，依此交替。
         如需改变水/气量比，调整下面两个 scale 即可。 -->
    <SourceFlux name="injCo2F"   targetMesh="mesh2" objectPath="ElementRegions/reservoirF" setNames="{ injectorBox }" component="0" scale="-200.0"  functionName="wagGas"/>
    <SourceFlux name="injWaterF" targetMesh="mesh2" objectPath="ElementRegions/reservoirF" setNames="{ injectorBox }" component="1" scale="-2000.0" functionName="wagWater"/>


