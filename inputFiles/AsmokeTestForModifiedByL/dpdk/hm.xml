<?xml version="1.0" ?>

<Problem>
  <Included>
     <File name="faultPoroelastic_base.xml"/>
  </Included>

  <Solvers gravityVector="{0.0, 0.0, 0.0}">
    <SinglePhasePoromechanics 
      name="poromechanicsSolver" 
      solidSolverName="mechanicsSolver"
      flowSolverName="singlePhaseFlowSolver"
      logLevel="1"
      writeLinearSystem="1"
      targetRegions="{ Domain }">
      <LinearSolverParameters 
        solverType="direct"
        directParallel="0"
        logLevel="0"/>
      <NonlinearSolverParameters
        newtonMaxIter = "40"/>
    </SinglePhasePoromechanics>

    <SolidMechanicsLagrangianFEM 
      name="mechanicsSolver" 
      logLevel="1"
      discretization="FE1"
      targetRegions="{ Domain }">
      <NonlinearSolverParameters
        newtonTol = "1.0e-5"
        newtonMaxIter = "15"/>      
    </SolidMechanicsLagrangianFEM>

    <SinglePhaseFVM 
      name="singlePhaseFlowSolver"
      logLevel="1"
      discretization="singlePhaseTPFA"
      targetRegions="{ Domain }"> 
      <NonlinearSolverParameters
        newtonTol = "1.0e-6"
        newtonMaxIter = "8"/>       
    </SinglePhaseFVM>
  </Solvers>
<!--
  <Mesh>
     <VTKMesh         
      name="FaultModel"      
      file="faultMesh_smoke.vtk"
      regionAttribute="CellEntityIds"/>
  </Mesh>
-->
  <Mesh>
    <InternalMesh
            name="mesh1"
            elementTypes="{ C3D8 }"
            xCoords="{ 0, 1, 9, 10 }"
            yCoords="{ 0, 10 }"
            zCoords="{ 0, 10 }"
            nx="{ 1, 1, 1 }"
            ny="{ 1 }"
            nz="{ 1 }"
            cellBlockNames="{ block1 }"/>
  </Mesh>

  <Geometry>
    <Box
            name="source"
            xMin="{ -0.01, -0.01, -0.01 }"
            xMax="{ 1.01, 11, 11 }"/>

    <Box
            name="sink"
            xMin="{ 8.99, -0.01, -0.01 }"
            xMax="{ 10.01, 1.01, 1.01 }"/>
    <Box
            name="88"
            xMin="{ -1, -1, -1 }"
            xMax="{ 1, 11, 11 }"/>
    <Box
            name="89"
            xMin="{ 9, -1, -1 }"
            xMax="{ 11, 11, 11 }"/>
    <Box
            name="90"
            xMin="{ -1, -1, -1 }"
            xMax="{ 11, 1, 11 }"/>
    <Box
            name="91"
            xMin="{ -1, 9, -1 }"
            xMax="{ 11, 11, 11 }"/>
    <Box
            name="92"
            xMin="{ -1, -1, -1 }"
            xMax="{ 11, 11, 1 }"/>
    <Box
            name="93"
            xMin="{ -1, -1, 9 }"
            xMax="{ 11, 11, 11 }"/>

  </Geometry>
  <FieldSpecifications>
    <FieldSpecification 
      name="injection"
      initialCondition="0"
      setNames="{source}"
      objectPath="ElementRegions/Domain/block1"
      fieldName="pressure"      
      scale="55.0e6"/>   	  
  </FieldSpecifications>

  <Events maxTime="2.0">
    <PeriodicEvent
      name="outputs"
      timeFrequency="2.0"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="solverApplications"
      forceDt="10"
      target="/Solvers/poromechanicsSolver"/>	

  </Events>

</Problem>
