    <FieldSpecification
            name="Porosity2"
            initialCondition="1"
            setNames="{ all }"
            objectPath="ElementRegions/Region2/block2"
            fieldName="rockPorosity_referencePorosity"
            scale="0.05"/>

    <FieldSpecification
            name="initialPressure2"
            initialCondition="1"
            setNames="{ all }"
            objectPath="ElementRegions/Region2/block2"
            fieldName="pressure"
            scale="0.0"/>

    <FieldSpecification
            name="sourceTerm2"
            objectPath="ElementRegions/Region2/block2"
            fieldName="pressure"
            scale="5e6"
            setNames="{ source }"/>

    <FieldSpecification
            name="sinkTerm2"
            objectPath="ElementRegions/Region2/block2"
            fieldName="pressure"
            scale="-5e6"
            setNames="{ sink }"/>
