<!-- Purpose: isolate zero-gravity capillary-driven exchange that reduces to a single exponential water-saturation solution. -->
<Problem>
  <NumericalMethods>
    <FiniteVolume><TwoPointFluxApproximation name="fluidTPFA"/></FiniteVolume>
  </NumericalMethods>

  <Mesh>
    <InternalMesh name="mesh1" elementTypes="{ C3D8 }" xCoords="{ 0, 1 }" yCoords="{ 0, 1 }" zCoords="{ 0, 1 }"
      nx="{ 1 }" ny="{ 1 }" nz="{ 1 }" cellBlockNames="{ matrixBlock }"/>
    <InternalMesh name="mesh2" elementTypes="{ C3D8 }" xCoords="{ 0, 1 }" yCoords="{ 0, 1 }" zCoords="{ 0, 1 }"
      nx="{ 1 }" ny="{ 1 }" nz="{ 1 }" cellBlockNames="{ fractureBlock }"/>
  </Mesh>

  <Geometry>
    <Box name="fixedBoundary" xMin="{ -0.01, -0.01, -0.01 }" xMax="{ 1.01, 1.01, 1.01 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion name="matrixRegion" meshBody="mesh1" cellBlocks="{ matrixBlock }"
      materialList="{ matrixRock, fluid, relperm, matrixCapPressure }"/>
    <CellElementRegion name="fractureRegion" meshBody="mesh2" cellBlocks="{ fractureBlock }"
      materialList="{ fractureRock, fluid, relperm, fractureCapPressure }"/>
  </ElementRegions>

  <Constitutive>
    <InvariantImmiscibleFluid name="fluid" phaseNames="{ gas, water }" componentNames="{ gas, water }"
      componentMolarWeight="{ 28e-3, 18e-3 }" densities="{ 10.0, 1000.0 }" viscosities="{ 2.0e-5, 1.0e-3 }"/>
    <TableRelativePermeability name="relperm" phaseNames="{ gas, water }"
      wettingNonWettingRelPermTableNames="{ waterRelPermTable, gasRelPermTable }"/>
    <!-- Linear matrix water capillary pressure reaching zero at S_w=0.6; fracture is the zero-capillary reference. -->
    <TableCapillaryPressure name="matrixCapPressure" phaseNames="{ gas, water }"
      wettingNonWettingCapPressureTableName="matrixWaterCapTable"/>
    <TableCapillaryPressure name="fractureCapPressure" phaseNames="{ gas, water }"
      wettingNonWettingCapPressureTableName="fractureWaterCapTable"/>
    <NullModel name="matrixSolid"/>
    <PressurePorosity name="matrixPorosity" defaultReferencePorosity="0.2" referencePressure="0.0" compressibility="1.0e-12"/>
    <ConstantPermeability name="matrixPerm" permeabilityComponents="{ 1.0e-12, 1.0e-12, 1.0e-12 }"/>
    <CompressibleSolidConstantPermeability name="matrixRock" solidModelName="matrixSolid" porosityModelName="matrixPorosity"
      permeabilityModelName="matrixPerm"/>
    <NullModel name="fractureSolid"/>
    <PressurePorosity name="fracturePorosity" defaultReferencePorosity="0.2" referencePressure="0.0" compressibility="1.0e-12"/>
    <ConstantPermeability name="fracturePerm" permeabilityComponents="{ 1.0e-12, 1.0e-12, 1.0e-12 }"/>
    <CompressibleSolidConstantPermeability name="fractureRock" solidModelName="fractureSolid" porosityModelName="fracturePorosity"
      permeabilityModelName="fracturePerm"/>
  </Constitutive>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <CompositionalMultiphaseFVM name="matrixFlow" discretization="fluidTPFA" temperature="300.0" logLevel="1"
      useMass="1" useSimpleAccumulation="0" maxCompFractionChange="0.5" logMassResidualDiagnostics="1" targetRegions="{ mesh1/matrixRegion }">
      <NonlinearSolverParameters newtonTol="1.0e-8" newtonMaxIter="100" lineSearchAction="None" maxTimeStepCuts="5" timeStepCutFactor="0.5"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>
    <CompositionalMultiphaseFVM name="fractureFlow" discretization="fluidTPFA" temperature="300.0" logLevel="1"
      useMass="1" useSimpleAccumulation="0" maxCompFractionChange="0.5" logMassResidualDiagnostics="1" targetRegions="{ mesh2/fractureRegion }">
      <NonlinearSolverParameters newtonTol="1.0e-8" newtonMaxIter="100" lineSearchAction="None" maxTimeStepCuts="5" timeStepCutFactor="0.5"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>
    <CompositionalMultiPhaseDualContinuumFVM name="dualFlow" flowSolverName="matrixFlow" flowSolverName1="fractureFlow" logLevel="1"
      matrixRegionList="{ matrixRegion }" fractureRegionList="{ fractureRegion }"
      targetRegions="{ mesh1/matrixRegion, mesh2/fractureRegion }">
      <DualContinuumCrossFlow fractureSpacingLx="0.3" fractureSpacingLy="0.3" fractureSpacingLz="0.3"
        gravityDrainageFlag="0" fractureVolumeFraction="0.5"
        matrixRegionList="{ matrixRegion }" fractureRegionList="{ fractureRegion }"/>
      <NonlinearSolverParameters newtonTol="1.0e-8" newtonMaxIter="100" lineSearchAction="None" maxTimeStepCuts="5" timeStepCutFactor="0.5"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiPhaseDualContinuumFVM>
  </Solvers>

  <FieldSpecifications>
    <FieldSpecification name="matrixPressure" initialCondition="1" targetMesh="mesh1" objectPath="ElementRegions"
      fieldName="pressure" setNames="{ all }" scale="1.0e6"/>
    <FieldSpecification name="matrixGasFrac" initialCondition="1" targetMesh="mesh1" objectPath="ElementRegions"
      fieldName="globalCompFraction" component="0" setNames="{ all }" scale="0.00990099"/>
    <FieldSpecification name="matrixWaterFrac" initialCondition="1" targetMesh="mesh1" objectPath="ElementRegions"
      fieldName="globalCompFraction" component="1" setNames="{ all }" scale="0.99009901"/>
    <FieldSpecification name="fracturePressure" initialCondition="1" targetMesh="mesh2" objectPath="ElementRegions"
      fieldName="pressure" setNames="{ all }" scale="1.0e6"/>
    <FieldSpecification name="fractureGasFrac" initialCondition="1" targetMesh="mesh2" objectPath="ElementRegions"
      fieldName="globalCompFraction" component="0" setNames="{ all }" scale="0.00990099"/>
    <FieldSpecification name="fractureWaterFrac" initialCondition="1" targetMesh="mesh2" objectPath="ElementRegions"
      fieldName="globalCompFraction" component="1" setNames="{ all }" scale="0.99009901"/>
  </FieldSpecifications>

  <Functions>
    <TableFunction name="waterRelPermTable" coordinates="{ 0.0, 0.2, 0.4, 1.0 }" values="{ 0.0, 0.9, 0.99, 1.0 }" interpolation="linear"/>
    <TableFunction name="gasRelPermTable" coordinates="{ 0.0, 0.2, 0.4, 1.0 }" values="{ 0.0, 0.9, 0.99, 1.0 }" interpolation="linear"/>
    <TableFunction name="matrixWaterCapTable" coordinates="{ 0.0, 0.6 }" values="{ 5.0e5, 0.0 }" interpolation="linear"/>
    <TableFunction name="fractureWaterCapTable" coordinates="{ 0.0, 1.0 }" values="{ 0.0, 0.0 }" interpolation="linear"/>
  </Functions>

  <Events maxTime="5.0">
    <PeriodicEvent name="solverApplications" forceDt="0.05" target="/Solvers/dualFlow"/>
    <PeriodicEvent name="phaseMatrixCollection" timeFrequency="0.1" target="/Tasks/phaseMatrixCollection"/>
    <PeriodicEvent name="phaseFractureCollection" timeFrequency="0.1" target="/Tasks/phaseFractureCollection"/>
    <PeriodicEvent name="capMatrixCollection" timeFrequency="0.1" target="/Tasks/capMatrixCollection"/>
    <PeriodicEvent name="capFractureCollection" timeFrequency="0.1" target="/Tasks/capFractureCollection"/>
    <PeriodicEvent name="pressureMatrixCollection" timeFrequency="0.1" target="/Tasks/pressureMatrixCollection"/>
    <PeriodicEvent name="pressureFractureCollection" timeFrequency="0.1" target="/Tasks/pressureFractureCollection"/>
    <PeriodicEvent name="phaseMatrixOutput" timeFrequency="0.1" targetExactTimestep="0" target="/Outputs/phaseMatrixOutput"/>
    <PeriodicEvent name="phaseFractureOutput" timeFrequency="0.1" targetExactTimestep="0" target="/Outputs/phaseFractureOutput"/>
    <PeriodicEvent name="capMatrixOutput" timeFrequency="0.1" targetExactTimestep="0" target="/Outputs/capMatrixOutput"/>
    <PeriodicEvent name="capFractureOutput" timeFrequency="0.1" targetExactTimestep="0" target="/Outputs/capFractureOutput"/>
    <PeriodicEvent name="pressureMatrixOutput" timeFrequency="0.1" targetExactTimestep="0" target="/Outputs/pressureMatrixOutput"/>
    <PeriodicEvent name="pressureFractureOutput" timeFrequency="0.1" targetExactTimestep="0" target="/Outputs/pressureFractureOutput"/>
  </Events>

  <Tasks>
    <PackCollection name="phaseMatrixCollection" objectPath="mesh1/ElementRegions/matrixRegion/matrixBlock"
      fieldName="phaseVolumeFraction"/>
    <PackCollection name="phaseFractureCollection" objectPath="mesh2/ElementRegions/fractureRegion/fractureBlock"
      fieldName="phaseVolumeFraction"/>
    <PackCollection name="capMatrixCollection" objectPath="mesh1/ElementRegions/matrixRegion/matrixBlock"
      fieldName="matrixCapPressure_phaseCapPressure"/>
    <PackCollection name="capFractureCollection" objectPath="mesh2/ElementRegions/fractureRegion/fractureBlock"
      fieldName="fractureCapPressure_phaseCapPressure"/>
    <PackCollection name="pressureMatrixCollection" objectPath="mesh1/ElementRegions/matrixRegion/matrixBlock"
      fieldName="pressure"/>
    <PackCollection name="pressureFractureCollection" objectPath="mesh2/ElementRegions/fractureRegion/fractureBlock"
      fieldName="pressure"/>
  </Tasks>

  <Outputs>
    <TimeHistory name="phaseMatrixOutput" sources="{ /Tasks/phaseMatrixCollection }" filename="I0a_matrix_phase_history"/>
    <TimeHistory name="phaseFractureOutput" sources="{ /Tasks/phaseFractureCollection }" filename="I0a_fracture_phase_history"/>
    <TimeHistory name="capMatrixOutput" sources="{ /Tasks/capMatrixCollection }" filename="I0a_matrix_cap_history"/>
    <TimeHistory name="capFractureOutput" sources="{ /Tasks/capFractureCollection }" filename="I0a_fracture_cap_history"/>
    <TimeHistory name="pressureMatrixOutput" sources="{ /Tasks/pressureMatrixCollection }" filename="I0a_matrix_pressure_history"/>
    <TimeHistory name="pressureFractureOutput" sources="{ /Tasks/pressureFractureCollection }" filename="I0a_fracture_pressure_history"/>
  </Outputs>
</Problem>
