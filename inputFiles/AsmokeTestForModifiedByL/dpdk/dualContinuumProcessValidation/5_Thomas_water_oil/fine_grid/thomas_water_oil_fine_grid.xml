      setNames="{ all }" functionName="matrixHydrostatic" scale="1.0"/>
    <FieldSpecification name="initialMatrixOilFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/matrixRegion" fieldName="globalCompFraction"
      component="0" setNames="{ all }" scale="0.540"/>
    <FieldSpecification name="initialMatrixGasFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/matrixRegion" fieldName="globalCompFraction"
      component="1" setNames="{ all }" scale="0.167"/>
    <FieldSpecification name="initialMatrixWaterFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/matrixRegion" fieldName="globalCompFraction"
      component="2" setNames="{ all }" scale="0.293"/>

    <!-- Initial fracture shell: water-filled. -->
    <FieldSpecification name="initialFracturePressure" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="pressure"
      setNames="{ all }" functionName="boundaryHydrostatic" scale="1.0"/>
    <FieldSpecification name="initialFractureOilFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="0" setNames="{ all }" scale="0.0001"/>
    <FieldSpecification name="initialFractureGasFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="1" setNames="{ all }" scale="0.0"/>
    <FieldSpecification name="initialFractureWaterFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="2" setNames="{ all }" scale="0.9999"/>

    <FieldSpecification name="initialTemperature" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions" fieldName="temperature"
      setNames="{ all }" scale="366.0"/>

    <!-- Constant water reservoir: hold the fracture shell cells at constant pressure and composition. -->
    <FieldSpecification name="fractureConstantPressure" initialCondition="0" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="pressure"
      setNames="{ all }" functionName="boundaryHydrostatic" scale="1.0"/>
    <FieldSpecification name="fractureBoundaryOilFrac" initialCondition="0" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="0" setNames="{ all }" scale="0.0001"/>
    <FieldSpecification name="fractureBoundaryGasFrac" initialCondition="0" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="1" setNames="{ all }" scale="0.0"/>
    <FieldSpecification name="fractureBoundaryWaterFrac" initialCondition="0" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="2" setNames="{ all }" scale="0.9999"/>
  </FieldSpecifications>

  <Functions>
    <TableFunction name="waterRelPermTable" coordinates="{ 0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.60, 0.70, 0.75 }"
      values="{ 0.0, 0.005, 0.010, 0.020, 0.030, 0.045, 0.060, 0.110, 0.180, 0.230 }" interpolation="linear"/>
    <TableFunction name="oilRelPermTableForOW" coordinates="{ 0.25, 0.30, 0.40, 0.50, 0.55, 0.60, 0.65, 0.70, 0.75, 0.80 }"
      values="{ 0.0, 0.042, 0.154, 0.304, 0.392, 0.492, 0.600, 0.723, 0.860, 1.000 }" interpolation="linear"/>
    <!-- Thomas 1983 Table 3: detailed 3D fine-grid rock relative permeability. -->
    <TableFunction name="gasRelPermTable" coordinates="{ 0.0, 0.10, 0.20, 0.30, 0.40, 0.50, 0.55 }"
      values="{ 0.0, 0.015, 0.050, 0.103, 0.190, 0.310, 0.420 }" interpolation="linear"/>
    <!--
      Thomas Table 3 lists k_ro against increasing gas saturation. GEOS
      evaluates this table against the oil phase volume fraction, so use
      S_o = 0.80 - S_g for the initial S_w = 0.20 state and reverse the
      saturation order. This keeps k_ro strictly increasing with S_o.
    -->
    <TableFunction name="oilRelPermTableForOG" coordinates="{ 0.25, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80 }"
      values="{ 0.000, 0.028, 0.110, 0.250, 0.450, 0.700, 1.000 }" interpolation="linear"/>
    <TableFunction name="waterCapPresTable" coordinates="{ 0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.60, 0.70, 0.75 }"
      values="{ 344738, 62052.84, 13789.52, 3447.38, 0, -2757.90, -8273.71, -27579.04, -68947.6, -275790.4 }" interpolation="linear"/>
    <TableFunction name="gasCapPresTable" coordinates="{ 0.0, 0.10, 0.20, 0.30, 0.40, 0.50, 0.55 }"
      values="{ 517.1, 586.1, 655.0, 792.9, 999.7, 1758.2, 2661.4 }" interpolation="linear"/>

    <TableFunction name="fractureWaterRelPermTable" coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 1.0 }" interpolation="linear"/>
    <TableFunction name="fractureOilRelPermTableForOW" coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 1.0 }" interpolation="linear"/>
    <TableFunction name="fractureGasRelPermTable" coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 1.0 }" interpolation="linear"/>
    <TableFunction name="fractureOilRelPermTableForOG" coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 1.0 }" interpolation="linear"/>
    <TableFunction name="fractureWaterCapPresTable" coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 0.0 }" interpolation="linear"/>
    <TableFunction name="fractureGasCapPresTable" coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 0.0 }" interpolation="linear"/>
    <!-- Hydrostatic pressure profiles: 43 MPa at the matrix-block center (z = 1.8288 m). -->
    <SymbolicFunction name="matrixHydrostatic" inputVarNames="{ elementCenter }"
      variableNames="{ x, y, z }"
      expression="4.3e7+5758.5*(1.8288-z)"/>
    <SymbolicFunction name="boundaryHydrostatic" inputVarNames="{ elementCenter }"
      variableNames="{ x, y, z }"
      expression="4.3e7+9546*(1.8288-z)"/>
  </Functions>

  <Events maxTime="63072000.0">
    <PeriodicEvent name="solverApplications" maxEventDt="2.0e4" target="/Solvers/flowSolver"/>
    <PeriodicEvent name="vtkOutput" timeFrequency="3.1536e6" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="matrixPhaseCollection" timeFrequency="3.1536e6" target="/Tasks/matrixPhaseCollection"/>
    <PeriodicEvent name="matrixPhaseHistory" timeFrequency="3.1536e6" targetExactTimestep="0" target="/Outputs/matrixPhaseHistory"/>
    <PeriodicEvent name="matrixAmountCollection" timeFrequency="3.1536e6" target="/Tasks/matrixAmountCollection"/>
    <PeriodicEvent name="matrixAmountHistory" timeFrequency="3.1536e6" targetExactTimestep="0" target="/Outputs/matrixAmountHistory"/>
  </Events>

  <Tasks>
    <!-- Representative center-cell histories supplement the all-cell VTK output used for total-oil recovery. -->
    <PackCollection name="matrixPhaseCollection"
      objectPath="mesh1/ElementRegions/matrixRegion/m_3_3_3"
      fieldName="phaseVolumeFraction"/>
    <PackCollection name="matrixAmountCollection"
      objectPath="mesh1/ElementRegions/matrixRegion/m_3_3_3"
      fieldName="compAmount"/>
  </Tasks>

  <Outputs>
