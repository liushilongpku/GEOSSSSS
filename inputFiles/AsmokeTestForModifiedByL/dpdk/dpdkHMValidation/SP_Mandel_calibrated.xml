<?xml version="1.0" ?>
<!--
  Single-Porosity Mandel with analytical-calibrated loading.
  Same material + BC as DPDP test, but using standard SinglePhasePoromechanics.
  Purpose: isolate whether residual floor is from DPDP or from solver setup.
  k=8e-17, tau~6s for visible Mandel-Cryer.
-->
<Problem>
  <NumericalMethods>
    <FiniteElements><FiniteElementSpace name="FE1" order="1"/></FiniteElements>
    <FiniteVolume><TwoPointFluxApproximation name="singlePhaseTPFA"/></FiniteVolume>
  </NumericalMethods>

  <Mesh>
    <InternalMesh name="mesh1" elementTypes="{ C3D8 }"
      xCoords="{ 0.0, 0.03 }" yCoords="{ 0.0, 0.03 }" zCoords="{ 0.0, 0.03 }"
      nx="{ 20 }" ny="{ 1 }" nz="{ 20 }" cellBlockNames="{ cb1 }"/>
  </Mesh>

  <Geometry>
    <Box name="xneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 1e-3, 30.1e-3, 30.1e-3 }"/>
    <Box name="xpos" xMin="{ 29e-3, -1e-3, -1e-3 }" xMax="{ 31e-3, 30.1e-3, 30.1e-3 }"/>
    <Box name="yneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 30.1e-3, 1e-3, 30.1e-3 }"/>
    <Box name="ypos" xMin="{ -1e-3, 29e-3, -1e-3 }" xMax="{ 30.1e-3, 31e-3, 30.1e-3 }"/>
    <Box name="zneg" xMin="{ -1e-3, -1e-3, -1e-3 }" xMax="{ 30.1e-3, 30.1e-3, 1e-3 }"/>
    <Box name="zpos" xMin="{ -1e-3, -1e-3, 29e-3 }" xMax="{ 30.1e-3, 30.1e-3, 31e-3 }"/>
  </Geometry>

  <ElementRegions>
    <CellElementRegion name="Domain" cellBlocks="{ cb1 }"
      materialList="{ matrixRock, water }"/>
  </ElementRegions>

  <Constitutive>
    <CompressibleSinglePhaseFluid name="water"
      defaultDensity="1000" defaultViscosity="0.001"
      referencePressure="0.0" compressibility="5.734e-10"/>
    <ElasticIsotropic name="matrixSolid"
      defaultDensity="0" defaultBulkModulus="1.1e9" defaultShearModulus="6.789e8"/>
    <BiotPorosity name="matrixPorosity"
      defaultGrainBulkModulus="2.7e10" defaultReferencePorosity="0.14"/>
    <ConstantPermeability name="matrixPerm"
      permeabilityComponents="{ 8.0e-17, 8.0e-17, 8.0e-17 }"/>
    <PorousElasticIsotropic name="matrixRock"
      solidModelName="matrixSolid" porosityModelName="matrixPorosity"
      permeabilityModelName="matrixPerm"/>
  </Constitutive>

  <Solvers gravityVector="{ 0.0, 0.0, 0.0 }">
    <SinglePhaseFVM name="SinglePhaseFlow" logLevel="1"
      discretization="singlePhaseTPFA" targetRegions="{ Domain }">
      <NonlinearSolverParameters newtonMaxIter="40" newtonTol="1.0e-4"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </SinglePhaseFVM>
    <SolidMechanicsLagrangianFEM name="lagsolve" logLevel="1"
      discretization="FE1" targetRegions="{ Domain }"
      timeIntegrationOption="QuasiStatic" contactRelationName="tractionlessContact"/>
    <SinglePhasePoromechanics name="poroSolve"
      solidSolverName="lagsolve" flowSolverName="SinglePhaseFlow"
      logLevel="1" targetRegions="{ Domain }" stabilizationType="None" isThermal="0">
      <NonlinearSolverParameters
        couplingType="FullyImplicit" newtonMaxIter="80" newtonTol="1.0e-6"
        maxTimeStepCuts="2" timeStepCutFactor="0.5"/>
      <LinearSolverParameters krylovTol="1.0e-12" solverType="gmres"/>
    </SinglePhasePoromechanics>
  </Solvers>

  <Functions>
    <!-- Analytical u_z(z=b,t) from Mandel single-porosity solution -->
    <TableFunction name="loadFunction" inputVarNames="{ time }"
      coordinates="{ 0.01, 0.0122877872728, 0.0150989716062, 0.0185532951135, 0.0227978943564, 0.028013567612, 0.0344224759569, 0.0422976061961, 0.0519743987087, 0.0638650354965, 0.0784759970351, 0.096429635759, 0.1184906851, 0.145598833232, 0.178908748992, 0.219839264886, 0.270133812113, 0.331934681844, 0.407874275897, 0.501187233627, 0.574082567003, 0.657580184856, 0.753222139759, 0.862774768596, 0.988261313673, 1.1319992884, 1.29664327766, 1.48523396324, 1.70125427985, 1.94869373873, 2.23212210682, 2.55677380222, 2.92864456463, 3.35460218595, 3.84251334625, 4.40138889731, 5.04155027704, 5.77482012814, 6.61474064123, 7.57682365509, 8.6788371327, 9.94113330397, 11.3870245352, 13.0432138672, 14.9402881726, 17.1132830416, 19.6023298265, 22.4533967966, 25.7191380906, 29.4598661448, 33.7446655565, 38.652668954, 44.2745184349, 50.7140395656, 58.0901588538, 66.5391001103, 76.2169002609, 87.3022910701, 100 }"
      values="{ -3.60993116708e-10, -3.61548473014e-10, -3.62165653536e-10, -3.62851731324e-10, -3.6361463279e-10, -3.64463250843e-10, -3.6540757535e-10, -3.6645884406e-10, -3.67629717834e-10, -3.68934484894e-10, -3.70389299842e-10, -3.72012464584e-10, -3.73824760031e-10, -3.75849839626e-10, -3.78114698612e-10, -3.80650236648e-10, -3.83491936138e-10, -3.86680684996e-10, -3.90263780386e-10, -3.94296152668e-10, -3.97230241627e-10, -4.00407835459e-10, -4.0385165038e-10, -4.07586096015e-10, -4.11636432186e-10, -4.16027130398e-10, -4.20779319693e-10, -4.25907410275e-10, -4.31415216441e-10, -4.37292045394e-10, -4.43509227259e-10, -4.50017462456e-10, -4.56745251325e-10, -4.63598647632e-10, -4.70462668501e-10, -4.77204816627e-10, -4.83681181645e-10, -4.89745365476e-10, -4.95259984055e-10, -5.00109786947e-10, -5.04214641333e-10, -5.07539971414e-10, -5.10102032826e-10, -5.11965940139e-10, -5.132357954e-10, -5.14038369279e-10, -5.1450389374e-10, -5.14748683143e-10, -5.14863750193e-10, -5.14911336349e-10, -5.14928337415e-10, -5.14933477051e-10, -5.14934761138e-10, -5.14935019238e-10, -5.14935059717e-10, -5.149350645e-10, -5.1493506491e-10, -5.14935064934e-10, -5.14935064935e-10 }"/>
  </Functions>

  <FieldSpecifications>
    <FieldSpecification name="initPressure" initialCondition="1"
      setNames="{ all }" objectPath="ElementRegions/Domain/cb1"
      fieldName="pressure" scale="0.0"/>
    <FieldSpecification name="xnegconstraint"
      objectPath="nodeManager" fieldName="totalDisplacement"
      component="0" scale="0.0" setNames="{ xneg }"/>
    <FieldSpecification name="yconstraint"
      objectPath="nodeManager" fieldName="totalDisplacement"
      component="1" scale="0.0" setNames="{ yneg, ypos }"/>
    <FieldSpecification name="znegconstraint"
      objectPath="nodeManager" fieldName="totalDisplacement"
      component="2" scale="0.0" setNames="{ zneg }"/>
    <FieldSpecification name="zposLoad"
      objectPath="nodeManager" fieldName="totalDisplacement"
      component="2" scale="1.0" setNames="{ zpos }" functionName="loadFunction"/>
    <FieldSpecification name="boundaryPressure"
      objectPath="faceManager" fieldName="pressure"
      scale="0.0" setNames="{ xpos }"/>
  </FieldSpecifications>

  <Events maxTime="100.0">
    <PeriodicEvent name="solverApplications" beginTime="0.0" endTime="100.0"
      forceDt="0.1" target="/Solvers/poroSolve"/>
    <PeriodicEvent name="outputs" timeFrequency="10.0" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="pressureEvent" target="/Tasks/pressureCollection"/>
    <PeriodicEvent name="pressureOutputEvent" targetExactTimestep="0"
      target="/Outputs/pressureHistory"/>
  </Events>

  <Tasks>
    <PackCollection name="pressureCollection"
      objectPath="ElementRegions/Domain/cb1" fieldName="pressure"/>
  </Tasks>

  <Outputs>
    <VTK name="vtkOutput"/>
    <TimeHistory name="pressureHistory"
      sources="{ /Tasks/pressureCollection }" filename="pressure_history"/>
  </Outputs>
</Problem>
