        f_0_8_8, f_9_8_8, f_0_9_8, f_1_9_8, f_2_9_8, f_3_9_8, f_4_9_8, f_5_9_8,
        f_6_9_8, f_7_9_8, f_8_9_8, f_9_9_8, f_0_0_9, f_1_0_9, f_2_0_9, f_3_0_9,
        f_4_0_9, f_5_0_9, f_6_0_9, f_7_0_9, f_8_0_9, f_9_0_9, f_0_1_9, f_1_1_9,
        f_2_1_9, f_3_1_9, f_4_1_9, f_5_1_9, f_6_1_9, f_7_1_9, f_8_1_9, f_9_1_9,
