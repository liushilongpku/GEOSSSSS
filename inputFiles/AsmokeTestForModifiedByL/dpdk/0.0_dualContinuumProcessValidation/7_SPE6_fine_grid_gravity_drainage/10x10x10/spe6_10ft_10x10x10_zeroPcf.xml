        f_4_4_9, f_5_4_9, f_6_4_9, f_7_4_9, f_8_4_9, f_9_4_9, f_0_5_9, f_1_5_9,
        f_2_5_9, f_3_5_9, f_4_5_9, f_5_5_9, f_6_5_9, f_7_5_9, f_8_5_9, f_9_5_9,
        f_0_6_9, f_1_6_9, f_2_6_9, f_3_6_9, f_4_6_9, f_5_6_9, f_6_6_9, f_7_6_9,
        f_8_6_9, f_9_6_9, f_0_7_9, f_1_7_9, f_2_7_9, f_3_7_9, f_4_7_9, f_5_7_9,
        f_6_7_9, f_7_7_9, f_8_7_9, f_9_7_9, f_0_8_9, f_1_8_9, f_2_8_9, f_3_8_9,
        f_4_8_9, f_5_8_9, f_6_8_9, f_7_8_9, f_8_8_9, f_9_8_9, f_0_9_9, f_1_9_9,
        f_2_9_9, f_3_9_9, f_4_9_9, f_5_9_9, f_6_9_9, f_7_9_9, f_8_9_9, f_9_9_9
      }"
      materialList="{ fractureRock, fluid, fractureRelperm, fractureCapPressure }"/>
  </ElementRegions>

  <Constitutive>
    <BlackOilFluid name="fluid" phaseNames="{ oil, gas, water }"
      surfaceDensities="{ 819.18, 0.929, 1041.2 }"
      componentMolarWeight="{ 120e-3, 25e-3, 18e-3 }"
      tableFiles="{ tables/pvto_bo.txt, tables/pvtg_norv_bo.txt, tables/pvtw_bo.txt }"/>

    <NullModel name="nullSolid"/>
    <PressurePorosity name="matrixPorosity" defaultReferencePorosity="0.29"
      referencePressure="31127733" compressibility="5.076e-10"/>
    <PressurePorosity name="fracturePorosity" defaultReferencePorosity="1.0"
      referencePressure="31127733" compressibility="5.076e-10"/>
    <ConstantPermeability name="matrixPerm"
      permeabilityComponents="{ 9.869233e-16, 9.869233e-16, 9.869233e-16 }"/>
    <ConstantPermeability name="fracturePerm"
      permeabilityComponents="{ 9.869233e-16, 9.869233e-16, 9.869233e-16 }"/>
    <CompressibleSolidConstantPermeability name="matrixRock" solidModelName="nullSolid"
      porosityModelName="matrixPorosity" permeabilityModelName="matrixPerm"/>
    <CompressibleSolidConstantPermeability name="fractureRock" solidModelName="nullSolid"
      porosityModelName="fracturePorosity" permeabilityModelName="fracturePerm"/>

    <TableRelativePermeability name="matrixRelperm" phaseNames="{ oil, gas, water }"
      wettingIntermediateRelPermTableNames="{ waterRelPermTable, oilRelPermTableForOW }"
      nonWettingIntermediateRelPermTableNames="{ gasRelPermTable, oilRelPermTableForOG }"
      threePhaseInterpolator="STONEII"/>
    <TableCapillaryPressure name="matrixCapPressure" phaseNames="{ oil, gas, water }"
      wettingIntermediateCapPressureTableName="waterCapPresTable"
      nonWettingIntermediateCapPressureTableName="gasCapPresTable"/>

    <!-- The outer shell has zero capillary pressure and zero-residual straight-line fracture kr. -->
    <TableRelativePermeability name="fractureRelperm" phaseNames="{ oil, gas, water }"
      wettingIntermediateRelPermTableNames="{ fractureWaterRelPermTable, fractureOilRelPermTableForOW }"
      nonWettingIntermediateRelPermTableNames="{ fractureGasRelPermTable, fractureOilRelPermTableForOG }"
      threePhaseInterpolator="STONEII"/>
    <TableCapillaryPressure name="fractureCapPressure" phaseNames="{ oil, gas, water }"
      wettingIntermediateCapPressureTableName="fractureWaterCapPresTable"
      nonWettingIntermediateCapPressureTableName="fractureGasCapPresTable"/>
  </Constitutive>

  <Solvers gravityVector="{ 0.0, 0.0, -9.81 }">
    <CompositionalMultiphaseFVM name="flowSolver" initialDt="1.0e2"
      discretization="fluidTPFA" temperature="366.0" logLevel="1"
      useMass="1" useSimpleAccumulation="0" maxCompFractionChange="0.05"
      targetRegions="{ mesh1/matrixRegion, mesh1/fractureRegion }">
      <NonlinearSolverParameters newtonTol="1.0e-3" newtonMaxIter="80"
        lineSearchAction="Attempt" maxTimeStepCuts="16" timeStepCutFactor="0.5"
        maxSubSteps="100000"/>
      <LinearSolverParameters solverType="direct" directParallel="0"/>
    </CompositionalMultiphaseFVM>
  </Solvers>

  <FieldSpecifications>
    <!-- Initial matrix: 4500-psig live oil with dissolved gas but no intended free-gas phase. -->
    <FieldSpecification name="initialMatrixPressure" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/matrixRegion" fieldName="pressure"
      setNames="{ all }" functionName="initialMatrixHydrostatic" scale="1.0"/>
    <FieldSpecification name="initialMatrixOilFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/matrixRegion" fieldName="globalCompFraction"
      component="0" setNames="{ all }" functionName="initialSaturatedOilComponent" scale="1.0"/>
    <FieldSpecification name="initialMatrixGasFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/matrixRegion" fieldName="globalCompFraction"
      component="1" setNames="{ all }" functionName="initialSaturatedGasComponent" scale="1.0"/>
    <FieldSpecification name="initialMatrixWaterFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/matrixRegion" fieldName="globalCompFraction"
      component="2" setNames="{ all }" functionName="initialSaturatedWaterComponent" scale="1.0"/>

    <!-- The 0.001-ft shell represents fractures initialized at
         Sg=0.990, So=0.005, and Sw=0.005. The global component fields below
         are the equivalent mass fractions at the 4500-psig center datum. -->
    <FieldSpecification name="initialFracturePressure" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="pressure"
      setNames="{ all }" functionName="fractureHydrostatic" scale="1.0"/>
    <FieldSpecification name="initialFractureOilFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="0" setNames="{ all }" scale="0.01159045286694303"/>
    <FieldSpecification name="initialFractureGasFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="1" setNames="{ all }" scale="0.965477449890208"/>
    <FieldSpecification name="initialFractureWaterFrac" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="2" setNames="{ all }" scale="0.02293209724284897"/>

    <FieldSpecification name="initialTemperature" initialCondition="1" targetMesh="mesh1"
      objectPath="ElementRegions" fieldName="temperature"
      setNames="{ all }" scale="366.0"/>

    <!-- Treat the complete thin shell as an infinite fracture reservoir.
         GEOS constrains pressure and global component mass fractions; the
         resulting phase state is approximately Sg=0.990, So=Sw=0.005. -->
    <FieldSpecification name="fractureBoundaryPressure" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="pressure"
      setNames="{ all }" functionName="fractureHydrostatic" scale="1.0"/>
    <FieldSpecification name="fractureBoundaryOil" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="0" setNames="{ all }" scale="0.01159045286694303"/>
    <FieldSpecification name="fractureBoundaryGas" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="1" setNames="{ all }" scale="0.965477449890208"/>
    <FieldSpecification name="fractureBoundaryWater" targetMesh="mesh1"
      objectPath="ElementRegions/fractureRegion" fieldName="globalCompFraction"
      component="2" setNames="{ all }" scale="0.02293209724284897"/>
  </FieldSpecifications>

  <Functions>
    <!-- 4500 psig is the block-center datum; each phase starts with its PVT density gradient. -->
    <SymbolicFunction name="initialMatrixHydrostatic" inputVarNames="{ elementCenter }"
      variableNames="{ x, y, z }"
      expression="31127732.8193+5958.9467778*(1.5243048-z)"/>
    <!-- These mass fractions give So=0.8 and Sw=0.2 at the local saturated Rs,
         with no deliberate free-gas seed. -->
    <SymbolicFunction name="initialSaturatedOilComponent" inputVarNames="{ elementCenter }"
      variableNames="{ x, y, z }" expression="(1-(0.287145405913946-7.95155908893894e-06*z))/(1+(0.228027729306525-5.75194103403429e-05*z))"/>
    <SymbolicFunction name="initialSaturatedGasComponent" inputVarNames="{ elementCenter }"
      variableNames="{ x, y, z }" expression="(1-(0.287145405913946-7.95155908893894e-06*z))*(0.228027729306525-5.75194103403429e-05*z)/(1+(0.228027729306525-5.75194103403429e-05*z))"/>
    <SymbolicFunction name="initialSaturatedWaterComponent" inputVarNames="{ elementCenter }"
      variableNames="{ x, y, z }" expression="0.287145405913946-7.95155908893894e-06*z"/>
    <SymbolicFunction name="fractureHydrostatic" inputVarNames="{ elementCenter }"
      variableNames="{ x, y, z }"
      expression="31127732.8193+2035.8575334*(1.5243048-z)"/>

    <TableFunction name="waterRelPermTable" coordinates="{ 0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.60, 0.70, 0.75 }"
      values="{ 0.0, 0.005, 0.010, 0.020, 0.030, 0.045, 0.060, 0.110, 0.180, 0.230 }" interpolation="linear"/>
    <!-- Thomas Eq. (25): at Sw approximately Swc, krow remains at its connate-water endpoint. -->
    <TableFunction name="oilRelPermTableForOW" coordinates="{ 0.0, 0.001, 1.0 }"
      values="{ 0.0, 0.998, 1.0 }" interpolation="linear"/>
    <!-- Thomas 1983 Table 3: detailed 3D fine-grid rock relative permeability. -->
    <TableFunction name="gasRelPermTable" coordinates="{ 0.0, 0.10, 0.20, 0.30, 0.40, 0.50, 0.55 }"
      values="{ 0.0, 0.015, 0.050, 0.103, 0.190, 0.310, 0.420 }" interpolation="linear"/>
    <!--
      Thomas Table 3 lists k_ro against increasing gas saturation. GEOS
      evaluates this table against the oil phase volume fraction, so use
      S_o = 0.80 - S_g for the initial S_w = 0.20 state and reverse the
      saturation order. This keeps k_ro strictly increasing with S_o.
    -->
    <TableFunction name="oilRelPermTableForOG" coordinates="{ 0.25, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80 }"
      values="{ 0.000, 0.028, 0.110, 0.250, 0.450, 0.700, 1.000 }" interpolation="linear"/>
    <!-- SPE6 1990 Table 1 replaces the Thomas water/oil capillary-pressure table. -->
    <TableFunction name="waterCapPresTable" coordinates="{ 0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.60, 0.70, 0.75 }"
      values="{ 6894.7573, 3447.3786, 2068.4272, 1034.2136, 0, -1378.9515, -8273.7088, -27579.0292, -68947.5729, -275790.2917 }" interpolation="linear"/>
    <!-- Thomas Table 3 rock Pc scaled by sigma(4500 psig)/sigma(5545 psig). -->
    <TableFunction name="gasCapPresTable" coordinates="{ 0.0, 0.10, 0.20, 0.30, 0.40, 0.50, 0.55 }"
      values="{ 2711.796313, 3073.648848, 3434.976959, 4158.157604, 5242.666359, 9220.42212, 13957.01935 }" interpolation="linear"/>

    <!-- The 0.005 oil/water phase seeds are residual and cannot feed the matrix. -->
    <TableFunction name="fractureWaterRelPermTable" coordinates="{ 0.005, 1.0 }"
      values="{ 0.0, 1.0 }" interpolation="linear"/>
    <TableFunction name="fractureOilRelPermTableForOW" coordinates="{ 0.005, 1.0 }"
      values="{ 0.0, 1.0 }" interpolation="linear"/>
    <TableFunction name="fractureGasRelPermTable" coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 1.0 }" interpolation="linear"/>
    <TableFunction name="fractureOilRelPermTableForOG" coordinates="{ 0.005, 1.0 }"
      values="{ 0.0, 1.0 }" interpolation="linear"/>
    <TableFunction name="fractureWaterCapPresTable" coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 0.0 }" interpolation="linear"/>
    <TableFunction name="fractureGasCapPresTable" coordinates="{ 0.0, 1.0 }"
      values="{ 0.0, 0.0 }" interpolation="linear"/>
  </Functions>

  <Events maxTime="157680000.0">
    <!-- Write the current state before advancing it so VTK TIME and fields remain aligned. -->
    <PeriodicEvent name="vtkOutput" timeFrequency="7.884e6" target="/Outputs/vtkOutput"/>
    <PeriodicEvent name="solverApplications" target="/Solvers/flowSolver"/>
  </Events>

  <Outputs>
    <VTK name="vtkOutput"/>
  </Outputs>
</Problem>
