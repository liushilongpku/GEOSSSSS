<?xml version="1.0" ?>

<Problem>
  <Included>
     <File name="dual_base.xml"/>
  </Included>

  <Solvers gravityVector="{0.0, 0.0, 0.0}">
    <DualContinuumFVM
      name="DualContinuumSolver"
      flowSolverName="singlePhaseFlowSolver"
      flowSolverName1="singlePhaseFlowSolver1"
      logLevel="1"
      targetRegions="{ Domain }">
      <LinearSolverParameters 
        solverType="direct"
        directParallel="0"
        logLevel="0"/>
      <NonlinearSolverParameters
        newtonMaxIter = "40"/>
    </DualContinuumFVM>
<!--
    <SolidMechanicsLagrangianFEM 
      name="mechanicsSolvertest"
      logLevel="1"
      discretization="FE1"
      targetRegions="{ Domain }">
      <NonlinearSolverParameters
        newtonTol = "1.0e-5"
        newtonMaxIter = "15"/>      
    </SolidMechanicsLagrangianFEM>
    -->
    <SinglePhaseFVM
            name="singlePhaseFlowSolver1"
            logLevel="1"
            discretization="singlePhaseTPFA"
            targetRegions="{ Domain }">
      <NonlinearSolverParameters
              newtonTol = "1.0e-6"
              newtonMaxIter = "8"/>
    </SinglePhaseFVM>
    <SinglePhaseFVM 
      name="singlePhaseFlowSolver"
      logLevel="1"
      discretization="singlePhaseTPFA"
      targetRegions="{ Domain }"> 
      <NonlinearSolverParameters
        newtonTol = "1.0e-6"
        newtonMaxIter = "8"/>       
    </SinglePhaseFVM>
  </Solvers>
<!--
  <Mesh>
     <VTKMesh         
      name="FaultModel"      
      file="faultMesh_smoke.vtk"
      regionAttribute="CellEntityIds"/>
  </Mesh>
  -->
  <Mesh>
    <InternalMesh
            name="mesh"
            elementTypes="{ C3D8 }"
            xCoords="{ 0, 10 }"
            yCoords="{ 0, 10 }"
            zCoords="{ 0, 10 }"
            nx="{ 10 }"
            ny="{ 10 }"
            nz="{ 10 }"
            cellBlockNames="{ cellBlock }"/>
  </Mesh>
  <FieldSpecifications>
    <FieldSpecification 
      name="injection"
      initialCondition="0"
      setNames="{all}"
      objectPath="ElementRegions/Domain/97_hexahedra"
      fieldName="pressure"      
      scale="55.0e6"/>   	  
  </FieldSpecifications>

  <Events maxTime="2.0">
    <PeriodicEvent
      name="outputs"
      timeFrequency="2.0"
      target="/Outputs/vtkOutput"/>

    <PeriodicEvent
      name="solverApplications"
      forceDt="10"
      target="/Solvers/DualContinuumSolver"/>


  </Events>

</Problem>
